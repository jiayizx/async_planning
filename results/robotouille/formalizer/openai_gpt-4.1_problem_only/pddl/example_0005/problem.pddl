(define (problem robotouille-problem)
  (:domain robotouille)
  (:objects
    table_3 table_2 table_1 - station
    stove_1 stove_3 stove_2 stove_4 - station
    robot_1 - player
    lettuce_1 chicken_2 bottombun_1 bread_1 bread_2 chicken_1 cheese_1 - item
  )
  (:init
    (istable table_3)
    (istable table_2)
    (istable table_1)
    (isstove stove_1)
    (isstove stove_3)
    (isstove stove_2)
    (isstove stove_4)
    (isrobot robot_1)
    (islettuce lettuce_1)
    (ischicken chicken_2)
    (isbottombun bottombun_1)
    (isbread bread_1)
    (isbread bread_2)
    (ischicken chicken_1)
    (ischeese cheese_1)
    (iscuttable lettuce_1)
    (iscookable chicken_2)
    (iscookable chicken_1)
    (loc robot_1 table_3)
    (has robot_1 bottombun_1)
    (on lettuce_1 table_1)
    (at lettuce_1 table_1)
    (on chicken_2 stove_4)
    (at chicken_2 stove_4)
    (on bread_1 table_2)
    (at bread_1 table_2)
    (on bread_2 table_3)
    (at bread_2 table_3)
    (on chicken_1 stove_1)
    (at chicken_1 stove_1)
    (on cheese_1 stove_3)
    (at cheese_1 stove_3)
    (clear lettuce_1)
    (clear chicken_2)
    (clear bread_1)
    (clear bread_2)
    (clear chicken_1)
    (clear cheese_1)
    (empty stove_2)
    (vacant table_1)
    (vacant table_2)
    (vacant stove_1)
    (vacant stove_3)
    (vacant stove_2)
    (vacant stove_4)
    (item-free lettuce_1)
    (item-free chicken_2)
    (item-free bottombun_1)
    (item-free bread_1)
    (item-free bread_2)
    (item-free chicken_1)
    (item-free cheese_1)
  )
  (:goal (and
    (on bread_1 table_1)
    (iscooked chicken_1)
    (at chicken_1 table_1)
    (at cheese_1 table_1)
    (at bread_2 table_1)
    (clear bread_2)
  ))
)
