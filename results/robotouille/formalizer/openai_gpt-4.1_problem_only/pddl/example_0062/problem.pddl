(define (problem robotouille-problem)
  (:domain robotouille)
  (:objects
    table_5 table_2 stove_1 stove_2 table_4 board_1 sink_1 table_1 table_3 - station
    onion_2 onion_3 onion_1 - item
    robot_1 - player
  )
  (:init
    (istable table_5)
    (istable table_2)
    (isstove stove_1)
    (isstove stove_2)
    (istable table_4)
    (isboard board_1)
    (issink sink_1)
    (istable table_1)
    (istable table_3)
    (isonion onion_2)
    (isonion onion_3)
    (isonion onion_1)
    (iscuttable onion_2)
    (iscuttable onion_3)
    (iscuttable onion_1)
    (isrobot robot_1)
    (loc robot_1 table_5)
    (on onion_2 table_5)
    (at onion_2 table_5)
    (on onion_3 stove_1)
    (at onion_3 stove_1)
    (on onion_1 board_1)
    (at onion_1 board_1)
    (clear onion_2)
    (clear onion_3)
    (clear onion_1)
    (empty table_1)
    (empty table_3)
    (empty table_4)
    (empty sink_1)
    (vacant stove_2)
    (vacant table_2)
    (vacant stove_1)
    (vacant board_1)
    (vacant sink_1)
    (vacant table_1)
    (vacant table_3)
    (vacant table_4)
    (item-free onion_2)
    (item-free onion_3)
    (item-free onion_1)
    (nothing robot_1)
  )
  (:goal (and
    (iscut onion_1)
    (iscut onion_2)
    (iscut onion_3)
  ))
)
