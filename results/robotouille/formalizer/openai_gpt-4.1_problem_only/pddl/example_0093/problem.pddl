(define (problem robotouille-problem)
  (:domain robotouille)
  (:objects
    table_8 table_3 table_6 table_9 table_4 table_5 table_1 table_2 table_7 fryer_1 board_1 - station
    onion_3 potato_1 onion_1 lettuce_1 bottombun_1 topbun_1 bread_2 bread_1 onion_2 chicken_1 - item
    robot_1 - player
  )
  (:init
    ; Station identity
    (istable table_8)
    (istable table_3)
    (istable table_6)
    (istable table_9)
    (istable table_4)
    (istable table_5)
    (istable table_1)
    (istable table_2)
    (istable table_7)
    (isfryer fryer_1)
    (isboard board_1)

    ; Player identity
    (isrobot robot_1)

    ; Item identity
    (isonion onion_3)
    (ispotato potato_1)
    (isonion onion_1)
    (islettuce lettuce_1)
    (isbottombun bottombun_1)
    (istopbun topbun_1)
    (isbread bread_2)
    (isbread bread_1)
    (isonion onion_2)
    (ischicken chicken_1)

    ; Item capabilities
    (iscuttable onion_3)
    (isfryableifcut onion_3)
    (iscuttable potato_1)
    (isfryableifcut potato_1)
    (iscuttable onion_1)
    (isfryableifcut onion_1)
    (iscuttable lettuce_1)
    (iscuttable onion_2)
    (isfryableifcut onion_2)
    (iscookable chicken_1)

    ; Player location
    (loc robot_1 table_8)

    ; Player hand state
    (nothing robot_1)

    ; Item locations (on/at/atop/has)
    (on onion_3 table_8)
    (at onion_3 table_8)
    (on potato_1 fryer_1)
    (at potato_1 fryer_1)
    (on onion_1 table_2)
    (at onion_1 table_2)
    (on lettuce_1 table_3)
    (at lettuce_1 table_3)
    (on bottombun_1 table_6)
    (at bottombun_1 table_6)
    (on topbun_1 board_1)
    (at topbun_1 board_1)
    (on bread_2 table_9)
    (at bread_2 table_9)
    (on bread_1 table_4)
    (at bread_1 table_4)
    (on onion_2 table_5)
    (at onion_2 table_5)
    (on chicken_1 table_1)
    (at chicken_1 table_1)

    ; Clear items (no item atop and not held)
    (clear onion_3)
    (clear potato_1)
    (clear onion_1)
    (clear lettuce_1)
    (clear bottombun_1)
    (clear topbun_1)
    (clear bread_2)
    (clear bread_1)
    (clear onion_2)
    (clear chicken_1)

    ; Vacant stations (no player at them except table_8)
    (vacant table_3)
    (vacant table_6)
    (vacant table_9)
    (vacant table_4)
    (vacant table_5)
    (vacant table_1)
    (vacant table_2)
    (vacant table_7)
    (vacant fryer_1)
    (vacant board_1)

    ; All items start item-free
    (item-free onion_3)
    (item-free potato_1)
    (item-free onion_1)
    (item-free lettuce_1)
    (item-free bottombun_1)
    (item-free topbun_1)
    (item-free bread_2)
    (item-free bread_1)
    (item-free onion_2)
    (item-free chicken_1)
  )
  (:goal (and
    (on bottombun_1 table_2)
    (iscut lettuce_1)
    (at lettuce_1 table_2)
    (iscut onion_2)
    (isfried onion_2)
    (at onion_2 table_2)
    (at topbun_1 table_2)
    (clear topbun_1)
    (on bread_1 table_3)
    (iscooked chicken_1)
    (at chicken_1 table_3)
    (iscut onion_3)
    (at onion_3 table_3)
    (at bread_2 table_3)
    (clear bread_2)
  ))
)
