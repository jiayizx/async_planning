(define (problem robotouille-problem)
  (:domain robotouille)
  (:objects
    sink_2 sink_1 table_1 stove_1 table_3 board_1 table_2 - station
    robot_1 - player
    potato_1 - item
  )
  (:init
    (issink sink_2)
    (issink sink_1)
    (istable table_1)
    (istable table_3)
    (istable table_2)
    (isstove stove_1)
    (isboard board_1)
    (isrobot robot_1)
    (ispotato potato_1)
    (iscuttable potato_1)
    (loc robot_1 sink_2)
    (on potato_1 sink_2)
    (at potato_1 sink_2)
    (clear potato_1)
    (empty stove_1)
    (empty table_3)
    (empty sink_1)
    (empty table_2)
    (vacant stove_1)
    (vacant table_3)
    (vacant sink_1)
    (vacant table_2)
    (vacant board_1)
    (vacant table_1)
    (nothing robot_1)
    (item-free potato_1)
  )
  (:goal (and
    (clear potato_1)
  ))
)
