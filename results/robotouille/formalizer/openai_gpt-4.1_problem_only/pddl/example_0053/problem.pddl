(define (problem robotouille-problem)
  (:domain robotouille)
  (:objects
    fryer_2 fryer_1 board_2 board_1 table_3 table_2 stove_1 table_1 sink_1 - station
    topbun_1 patty_1 potato_1 - item
    robot_1 - player
  )
  (:init
    (isfryer fryer_2)
    (isfryer fryer_1)
    (isboard board_2)
    (isboard board_1)
    (istable table_3)
    (istable table_2)
    (isstove stove_1)
    (istable table_1)
    (issink sink_1)
    (istopbun topbun_1)
    (ispatty patty_1)
    (ispotato potato_1)
    (isrobot robot_1)
    (iscookable patty_1)
    (iscuttable potato_1)
    (loc robot_1 fryer_2)
    (on topbun_1 table_3)
    (at topbun_1 table_3)
    (on patty_1 fryer_1)
    (at patty_1 fryer_1)
    (on potato_1 fryer_2)
    (at potato_1 fryer_2)
    (clear topbun_1)
    (clear patty_1)
    (clear potato_1)
    (empty table_2)
    (empty stove_1)
    (empty table_1)
    (empty sink_1)
    (vacant board_2)
    (vacant board_1)
    (vacant table_3)
    (vacant table_2)
    (vacant stove_1)
    (vacant table_1)
    (vacant sink_1)
    (nothing robot_1)
    (item-free topbun_1)
    (item-free patty_1)
    (item-free potato_1)
  )
  (:goal (and
    (on potato_1 fryer_2)
  ))
)
