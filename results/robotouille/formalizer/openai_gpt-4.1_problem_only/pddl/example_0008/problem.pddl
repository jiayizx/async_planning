(define (problem robotouille-problem)
  (:domain robotouille)
  (:objects
    table_3 table_2 table_1 - station
    stove_1 - station
    bread_2 bread_1 chicken_1 cheese_1 - item
    robot_1 - player
  )
  (:init
    (istable table_3)
    (istable table_2)
    (istable table_1)
    (isstove stove_1)
    (isbread bread_2)
    (isbread bread_1)
    (ischicken chicken_1)
    (ischeese cheese_1)
    (isrobot robot_1)
    (iscookable chicken_1)
    (loc robot_1 table_3)
    (on bread_2 table_3)
    (at bread_2 table_3)
    (on bread_1 stove_1)
    (at bread_1 stove_1)
    (on chicken_1 table_2)
    (at chicken_1 table_2)
    (on cheese_1 table_1)
    (at cheese_1 table_1)
    (clear bread_2)
    (clear bread_1)
    (clear chicken_1)
    (clear cheese_1)
    (empty table_3)
    (empty stove_1)
    (empty table_2)
    (empty table_1)
    (vacant stove_1)
    (vacant table_2)
    (vacant table_1)
    (nothing robot_1)
    (item-free bread_2)
    (item-free bread_1)
    (item-free chicken_1)
    (item-free cheese_1)
  )
  (:goal (and
    (on bread_1 table_1)
    (iscooked chicken_1)
    (at chicken_1 table_1)
    (at cheese_1 table_1)
    (at bread_2 table_1)
    (clear bread_2)
  ))
)
