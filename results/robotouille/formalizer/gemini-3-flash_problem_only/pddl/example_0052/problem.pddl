(define (problem robotouille_problem)
  (:domain robotouille)
  (:objects
    fryer_2 fryer_1 stove_1 table_2 stove_2 table_3 board_1 sink_1 table_1 - station
    potato_1 - item
    robot_1 - player
  )
  (:init
    (isfryer fryer_2)
    (isfryer fryer_1)
    (isstove stove_1)
    (istable table_2)
    (isstove stove_2)
    (istable table_3)
    (isboard board_1)
    (issink sink_1)
    (istable table_1)
    (isrobot robot_1)
    (ispotato potato_1)
    (iscuttable potato_1)
    (item-free potato_1)
    (loc robot_1 fryer_2)
    (nothing robot_1)
    (on potato_1 fryer_2)
    (at potato_1 fryer_2)
    (clear potato_1)
    (vacant fryer_1)
    (vacant stove_1)
    (vacant table_2)
    (vacant stove_2)
    (vacant table_3)
    (vacant board_1)
    (vacant sink_1)
    (vacant table_1)
    (empty fryer_1)
    (empty stove_1)
    (empty table_2)
    (empty stove_2)
    (empty table_3)
    (empty board_1)
    (empty sink_1)
    (empty table_1)
  )
  (:goal (and
    (at potato_1 table_1)
  ))
)