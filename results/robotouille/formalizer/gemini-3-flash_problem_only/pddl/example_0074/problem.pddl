(define (problem robotouille_problem)
    (:domain robotouille)
    (:objects
        stove_1 stove_4 table_4 sink_1 stove_2 table_6 table_5 table_3 sink_3 board_1 table_1 sink_2 table_2 stove_3 table_7 sink_4 - station
        tomato_1 lettuce_1 chicken_1 bread_2 bread_1 - item
        robot_1 - player
    )
    (:init
        (isrobot robot_1)
        (istable table_1) (istable table_2) (istable table_3) (istable table_4) (istable table_5) (istable table_6) (istable table_7)
        (isstove stove_1) (isstove stove_2) (isstove stove_3) (isstove stove_4)
        (issink sink_1) (issink sink_2) (issink sink_3) (issink sink_4)
        (isboard board_1)
        (istomato tomato_1) (islettuce lettuce_1) (ischicken chicken_1) (isbread bread_1) (isbread bread_2)
        (iscuttable tomato_1) (iscuttable lettuce_1) (iscookable chicken_1)
        (item-free tomato_1) (item-free lettuce_1) (item-free chicken_1) (item-free bread_1) (item-free bread_2)
        (loc robot_1 stove_1)
        (nothing robot_1)
        (on tomato_1 table_1) (at tomato_1 table_1) (clear tomato_1)
        (on lettuce_1 sink_4) (at lettuce_1 sink_4) (clear lettuce_1)
        (on chicken_1 stove_1) (at chicken_1 stove_1) (clear chicken_1)
        (on bread_2 stove_4) (at bread_2 stove_4) (clear bread_2)
        (on bread_1 table_4) (at bread_1 table_4) (clear bread_1)
        (vacant stove_4) (vacant table_4) (vacant sink_1) (vacant stove_2) (vacant table_6) (vacant table_5) (vacant table_3) (vacant sink_3) (vacant board_1) (vacant table_1) (vacant sink_2) (vacant table_2) (vacant stove_3) (vacant table_7) (vacant sink_4)
        (empty table_2) (empty table_3) (empty table_5) (empty table_6) (empty table_7) (empty stove_2) (empty stove_3) (empty sink_1) (empty sink_2) (empty sink_3) (empty board_1)
    )
    (:goal (and
        (on bread_1 table_2)
        (iscooked chicken_1)
        (at chicken_1 table_2)
        (iscut lettuce_1)
        (at lettuce_1 table_2)
        (at bread_2 table_2)
        (clear bread_2)
    ))
)