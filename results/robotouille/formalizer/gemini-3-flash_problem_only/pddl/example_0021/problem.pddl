(define (problem robotouille_problem)
    (:domain robotouille)
    (:objects
        table_2 fryer_2 table_4 fryer_1 table_3 sink_1 stove_2 table_1 board_1 stove_1 - station
        bread_1 bread_3 bread_2 chicken_1 topbun_1 patty_1 topbun_2 lettuce_1 tomato_1 - item
        robot_1 - player
    )
    (:init
        (istable table_2) (isfryer fryer_2) (istable table_4) (isfryer fryer_1) (istable table_3) (issink sink_1) (isstove stove_2) (istable table_1) (isboard board_1) (isstove stove_1)
        (isbread bread_1) (isbread bread_3) (isbread bread_2) (ischicken chicken_1) (istopbun topbun_1) (ispatty patty_1) (istopbun topbun_2) (islettuce lettuce_1) (istomato tomato_1)
        (isrobot robot_1)
        (loc robot_1 table_2)
        (nothing robot_1)
        (vacant fryer_2) (vacant table_4) (vacant fryer_1) (vacant table_3) (vacant sink_1) (vacant stove_2) (vacant table_1) (vacant board_1) (vacant stove_1)
        (isfryable chicken_1) (iscookable patty_1) (iscuttable lettuce_1) (iscuttable tomato_1)
        (item-free bread_1) (item-free bread_3) (item-free bread_2) (item-free chicken_1) (item-free topbun_1) (item-free patty_1) (item-free topbun_2) (item-free lettuce_1) (item-free tomato_1)
        (on bread_1 table_2) (at bread_1 table_2) (clear bread_1)
        (on bread_3 board_1) (at bread_3 board_1) (clear bread_3)
        (on bread_2 sink_1) (at bread_2 sink_1) (clear bread_2)
        (on chicken_1 fryer_2) (at chicken_1 fryer_2) (clear chicken_1)
        (on topbun_1 stove_1) (at topbun_1 stove_1) (clear topbun_1)
        (on patty_1 stove_2) (at patty_1 stove_2) (clear patty_1)
        (on topbun_2 table_3) (at topbun_2 table_3) (clear topbun_2)
        (on lettuce_1 table_4) (at lettuce_1 table_4) (clear lettuce_1)
        (on tomato_1 table_1) (at tomato_1 table_1) (clear tomato_1)
        (empty fryer_1)
    )
    (:goal (and
        (on bread_1 table_1)
        (iscut lettuce_1)
        (at lettuce_1 table_1)
        (iscut tomato_1)
        (at tomato_1 table_1)
        (isfried chicken_1)
        (at chicken_1 table_1)
        (at bread_2 table_1)
        (clear bread_2)
    ))
)