(define (problem robotouille_problem)
    (:domain robotouille)
    (:objects
        table_1 table_2 table_3 table_4 fryer_1 - station
        bread_1 bread_2 chicken_1 lettuce_1 tomato_1 - item
        robot_1 - player
    )
    (:init
        (istable table_1)
        (istable table_2)
        (istable table_3)
        (istable table_4)
        (isfryer fryer_1)
        (isbread bread_1)
        (isbread bread_2)
        (ischicken chicken_1)
        (islettuce lettuce_1)
        (istomato tomato_1)
        (isrobot robot_1)
        (isfryable chicken_1)
        (iscuttable lettuce_1)
        (iscuttable tomato_1)
        (item-free bread_1)
        (item-free bread_2)
        (item-free chicken_1)
        (item-free lettuce_1)
        (item-free tomato_1)
        (loc robot_1 table_1)
        (nothing robot_1)
        (on bread_1 table_1)
        (at bread_1 table_1)
        (clear bread_1)
        (on bread_2 table_3)
        (at bread_2 table_3)
        (clear bread_2)
        (on chicken_1 fryer_1)
        (at chicken_1 fryer_1)
        (clear chicken_1)
        (on lettuce_1 table_4)
        (at lettuce_1 table_4)
        (clear lettuce_1)
        (on tomato_1 table_2)
        (at tomato_1 table_2)
        (clear tomato_1)
        (vacant table_2)
        (vacant table_3)
        (vacant table_4)
        (vacant fryer_1)
    )
    (:goal (and
        (on bread_1 table_1)
        (iscut lettuce_1)
        (at lettuce_1 table_1)
        (iscut tomato_1)
        (at tomato_1 table_1)
        (isfried chicken_1)
        (at chicken_1 table_1)
        (at bread_2 table_1)
        (clear bread_2)
    ))
)