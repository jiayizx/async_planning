(define (problem robotouille-soup-and-sandwiches)
    (:domain robotouille-async)
    (:objects
        table_1 stove_1 table_2 board_1 sink_1 table_3 table_4 table_5 table_6 table_7 table_8 - station
        robot_1 - player
        tomato_1 onion_1 chicken_1 chicken_2 bread_1 bread_2 bread_3 bread_4 - item
        pot_1 bowl_1 - container
        water_1 - water
    )
    (:init
        (isrobot robot_1)
        (istable table_1) (isstove stove_1) (istable table_2) (isboard board_1) (issink sink_1)
        (istable table_3) (istable table_4) (istable table_5) (istable table_6) (istable table_7) (istable table_8)
        (istomato tomato_1) (isonion onion_1) (ischicken chicken_1) (ischicken chicken_2)
        (isbread bread_1) (isbread bread_2) (isbread bread_3) (isbread bread_4)
        (iscuttable tomato_1) (iscuttable onion_1)
        (iscookable chicken_1) (iscookable chicken_2)
        (ispottype pot_1) (isbowltype bowl_1)
        (water_available water_1)
        (station_free stove_1) (station_free board_1) (station_free sink_1)
        (loc robot_1 table_1)
        (vacant stove_1) (vacant table_2) (vacant board_1) (vacant sink_1) (vacant table_3) (vacant table_4) (vacant table_5) (vacant table_6) (vacant table_7) (vacant table_8)
        (nothing robot_1) (nocontainer robot_1)
        (at tomato_1 table_3) (on tomato_1 table_3) (clear tomato_1)
        (at onion_1 table_4) (on onion_1 table_4) (clear onion_1)
        (at chicken_1 table_5) (on chicken_1 table_5) (clear chicken_1)
        (at chicken_2 table_6) (on chicken_2 table_6) (clear chicken_2)
        (at bread_2 table_7) (on bread_2 table_7)
        (at bread_1 table_7) (atop bread_1 bread_2) (clear bread_1)
        (at bread_4 table_8) (on bread_4 table_8)
        (at bread_3 table_8) (atop bread_3 bread_4) (clear bread_3)
        (container_at pot_1 table_1) (container_on_station pot_1)
        (container_at bowl_1 table_2) (container_on_station bowl_1)
        (empty stove_1) (empty board_1) (empty sink_1)
    )
    (:goal (and
        (in water_1 bowl_1)
        (isboiling water_1)
        (iscut tomato_1)
        (addedto tomato_1 water_1)
        (iscut onion_1)
        (addedto onion_1 water_1)
        (container_at bowl_1 table_1)
        (on bread_1 table_2)
        (iscooked chicken_1)
        (atop chicken_1 bread_1)
        (atop bread_2 chicken_1)
        (clear bread_2)
        (on bread_3 table_3)
        (iscooked chicken_2)
        (atop chicken_2 bread_3)
        (atop bread_4 chicken_2)
        (clear bread_4)
    ))
)