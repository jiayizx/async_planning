(define (problem fried-chicken-sandwich-lettuce-tomato)
  (:domain robotouille)
  (:objects
    board_1 board_2 sink_1 sink_2 sink_3 fryer_1 fryer_2 table_1 table_2 table_3 table_4 - station
    topbun_1 chicken_1 chicken_2 bread_1 bread_2 lettuce_1 tomato_1 - item
    robot_1 - player
  )
  (:init
    ; Station identity
    (isboard board_1) (isboard board_2)
    (issink sink_1) (issink sink_2) (issink sink_3)
    (isfryer fryer_1) (isfryer fryer_2)
    (istable table_1) (istable table_2) (istable table_3) (istable table_4)
    ; Item identity
    (istopbun topbun_1)
    (ischicken chicken_1) (ischicken chicken_2)
    (isbread bread_1) (isbread bread_2)
    (islettuce lettuce_1)
    (istomato tomato_1)
    ; Player identity and state
    (isrobot robot_1)
    (loc robot_1 board_1)
    (has robot_1 bread_1)
    ; Capability flags
    (iscookable chicken_1)
    (isfryable chicken_2)
    (iscuttable lettuce_1)
    (iscuttable tomato_1)
    ; Items on stations (not held)
    (on topbun_1 sink_3) (at topbun_1 sink_3)
    (on chicken_1 board_2) (at chicken_1 board_2)
    (on bread_2 board_1) (at bread_2 board_1)
    (on chicken_2 sink_2) (at chicken_2 sink_2)
    (on lettuce_1 fryer_2) (at lettuce_1 fryer_2)
    (on tomato_1 table_2) (at tomato_1 table_2)
    ; Clear: topmost item at each occupied station (not held)
    (clear topbun_1)
    (clear chicken_1)
    (clear bread_2)
    (clear chicken_2)
    (clear lettuce_1)
    (clear tomato_1)
    ; Empty: stations with no items on surface (stack-level 0)
    (empty fryer_1)
    (empty table_1)
    (empty table_3)
    (empty table_4)
    ; Vacant: stations where no player stands
    (vacant fryer_1)
    (vacant fryer_2)
    (vacant sink_1)
    (vacant sink_2)
    (vacant sink_3)
    (vacant board_2)
    (vacant table_1)
    (vacant table_2)
    (vacant table_3)
    (vacant table_4)
    ; item-free: all items start free
    (item-free topbun_1)
    (item-free chicken_1)
    (item-free chicken_2)
    (item-free bread_1)
    (item-free bread_2)
    (item-free lettuce_1)
    (item-free tomato_1)
  )
  (:goal (and
    (on bread_1 table_1)
    (iscut lettuce_1)
    (at lettuce_1 table_1)
    (iscut tomato_1)
    (at tomato_1 table_1)
    (isfried chicken_1)
    (at chicken_1 table_1)
    (at bread_2 table_1)
    (clear bread_2)
  ))
)
