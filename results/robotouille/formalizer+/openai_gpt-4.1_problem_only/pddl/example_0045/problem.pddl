(define (problem onion-cheese-burger-and-onion-rings)
  (:domain robotouille)
  (:objects
    board_1 board_2 table_1 table_2 table_3 table_4 table_5 fryer_1 stove_1 stove_2 - station
    onion_1 onion_2 lettuce_1 patty_1 patty_2 cheese_1 bottombun_1 bottombun_2 topbun_1 - item
    robot_1 - player
  )
  (:init
    ; Station identity
    (isboard board_1) (isboard board_2)
    (istable table_1) (istable table_2) (istable table_3) (istable table_4) (istable table_5)
    (isfryer fryer_1)
    (isstove stove_1) (isstove stove_2)
    ; Item identity
    (isonion onion_1) (isonion onion_2)
    (islettuce lettuce_1)
    (ispatty patty_1) (ispatty patty_2)
    (ischeese cheese_1)
    (isbottombun bottombun_1) (isbottombun bottombun_2)
    (istopbun topbun_1)
    ; Player identity and state
    (isrobot robot_1)
    (loc robot_1 board_2)
    (has robot_1 bottombun_1)
    ; Capability flags
    (iscuttable onion_1) (isfryableifcut onion_1)
    (iscuttable onion_2) (isfryableifcut onion_2)
    (iscuttable lettuce_1)
    (iscookable patty_1) (iscookable patty_2)
    ; Items on stations (not held)
    (on onion_2 table_4) (at onion_2 table_4)
    (on lettuce_1 stove_2) (at lettuce_1 stove_2)
    (on patty_2 stove_1) (at patty_2 stove_1)
    (on cheese_1 fryer_1) (at cheese_1 fryer_1)
    (on patty_1 table_3) (at patty_1 table_3)
    (on bottombun_2 board_2) (at bottombun_2 board_2)
    (on onion_1 table_2) (at onion_1 table_2)
    (on topbun_1 board_1) (at topbun_1 board_1)
    ; Clear items (topmost at each stack, not held)
    (clear onion_2)
    (clear lettuce_1)
    (clear patty_2)
    (clear cheese_1)
    (clear patty_1)
    (clear bottombun_2)
    (clear onion_1)
    (clear topbun_1)
    ; Empty stations (no item with stack-level 0 on them)
    (empty table_1)
    (empty table_5)
    ; Vacant stations (no player at them)
    (vacant board_1) (vacant table_1) (vacant table_2) (vacant table_3) (vacant table_4) (vacant table_5) (vacant fryer_1) (vacant stove_1) (vacant stove_2)
    ; item-free: all items start free
    (item-free onion_1) (item-free onion_2) (item-free lettuce_1) (item-free patty_1) (item-free patty_2) (item-free cheese_1) (item-free bottombun_1) (item-free bottombun_2) (item-free topbun_1)
  )
  (:goal (and
    (on bottombun_1 table_1)
    (iscooked patty_1)
    (at patty_1 table_1)
    (iscut onion_1)
    (at onion_1 table_1)
    (at cheese_1 table_1)
    (at topbun_1 table_1)
    (clear topbun_1)
    (iscut onion_2)
    (isfried onion_2)
    (on onion_2 table_2)
  ))
)
