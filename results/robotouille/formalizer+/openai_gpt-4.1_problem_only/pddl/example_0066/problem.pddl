    (istable table_1) (istable table_2) (istable table_3) (istable table_4) (istable table_5) (istable table_6) (istable table_7)
    (isfryer fryer_1)
    (isstove stove_1)
    (isboard board_1)
    (isonion onion_1) (isonion onion_2) (isonion onion_3)
    (istopbun topbun_1)
    (isbottombun bottombun_1)
    (isrobot robot_1)
    (loc robot_1 sink_1)
    (nothing robot_1)
    (iscuttable onion_1) (iscuttable onion_2) (iscuttable onion_3)
    (on onion_1 sink_1) (at onion_1 sink_1)
    (on onion_2 table_6) (at onion_2 table_6)
    (on onion_3 table_7) (at onion_3 table_7)
    (on topbun_1 table_2) (at topbun_1 table_2)
    (on bottombun_1 table_4) (at bottombun_1 table_4)
