    ;; (isboiling water_1)
    ;; (addedto onion_1 water_1)
    ;; (addedto onion_2 water_1)
    ;; (addedto onion_3 water_1)
    ;; (container_at bowl_1 table_1)
    (iscut onion_1)
    (iscut onion_2)
    (iscut onion_3)
  ))
