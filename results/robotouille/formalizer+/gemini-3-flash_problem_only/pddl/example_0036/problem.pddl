(define (problem tomato-burger-and-fries)
  (:domain robotouille)
  (:objects
    board_1 fryer_1 stove_2 table_3 table_1 table_2 stove_1 table_4 - station
    bread_1 bottombun_1 topbun_1 potato_1 tomato_1 patty_1 - item
    robot_1 - player
  )
  (:init
    (isboard board_1) (isfryer fryer_1) (isstove stove_2) (istable table_3) (istable table_1) (istable table_2) (isstove stove_1) (istable table_4)
    (isbread bread_1) (isbottombun bottombun_1) (istopbun topbun_1) (ispotato potato_1) (istomato tomato_1) (ispatty patty_1)
    (isrobot robot_1)
    (loc robot_1 board_1)
    (nothing robot_1)
    (iscuttable potato_1) (isfryableifcut potato_1)
    (iscuttable tomato_1)
    (iscookable patty_1)
    (on bread_1 table_3) (at bread_1 table_3)
    (on bottombun_1 table_1) (at bottombun_1 table_1)
    (on topbun_1 board_1) (at topbun_1 board_1)
    (on potato_1 fryer_1) (at potato_1 fryer_1)
    (on tomato_1 table_2) (at tomato_1 table_2)
    (on patty_1 stove_2) (at patty_1 stove_2)
    (clear bread_1) (clear bottombun_1) (clear topbun_1) (clear potato_1) (clear tomato_1) (clear patty_1)
    (empty stove_1) (empty table_4)
    (vacant fryer_1) (vacant stove_2) (vacant table_3) (vacant table_1) (vacant table_2) (vacant stove_1) (vacant table_4)
    (item-free bread_1) (item-free bottombun_1) (item-free topbun_1) (item-free potato_1) (item-free tomato_1) (item-free patty_1)
  )
  (:goal (and
    (on bottombun_1 table_1)
    (iscooked patty_1)
    (at patty_1 table_1)
    (iscut tomato_1)
    (at tomato_1 table_1)
    (at topbun_1 table_1)
    (clear topbun_1)
    (iscut potato_1)
    (isfried potato_1)
    (on potato_1 table_2)
  ))
)