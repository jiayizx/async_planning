    (vacant fryer_2) (vacant board_1) (vacant board_2) (vacant stove_1) (vacant stove_2) (vacant table_1) (vacant table_2) (vacant table_3) (vacant table_4) (vacant table_5)
    (item-free potato_1) (item-free topbun_1) (item-free tomato_1) (item-free tomato_2) (item-free cheese_1) (item-free patty_1) (item-free bottombun_1)
  )
  (:goal (and
