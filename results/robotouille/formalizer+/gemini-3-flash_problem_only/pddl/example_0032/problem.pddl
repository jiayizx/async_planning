    (loc robot_1 fryer_1)
    (has robot_1 tomato_2)
    (iscuttable potato_1) (isfryableifcut potato_1)
    (iscuttable tomato_1)
    (iscuttable tomato_2)
    (iscookable patty_1)
    (on potato_1 board_2) (at potato_1 board_2)
