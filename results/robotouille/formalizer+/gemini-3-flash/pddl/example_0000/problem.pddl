(define (problem cheese-chicken-sandwich)
    (:domain robotouille-async)
    (:objects
        robot_1 - player
        table_1 stove_1 table_2 table_3 - station
        bread_1 bread_2 chicken_1 cheese_1 - item
    )
    (:init
        (isrobot robot_1)
        (istable table_1)
        (isstove stove_1)
        (istable table_2)
        (istable table_3)
        (isbread bread_1)
        (isbread bread_2)
        (ischicken chicken_1)
        (ischeese cheese_1)
        (iscookable chicken_1)
        (station_free stove_1)
        (station_free table_1)
        (station_free table_2)
        (station_free table_3)
        (loc robot_1 table_1)
        (vacant stove_1)
        (vacant table_2)
        (vacant table_3)
        (nothing robot_1)
        (nocontainer robot_1)
        (on bread_1 table_1)
        (at bread_1 table_1)
        (atop bread_2 bread_1)
        (at bread_2 table_1)
        (clear bread_2)
        (on chicken_1 table_2)
        (at chicken_1 table_2)
        (clear chicken_1)
        (on cheese_1 table_3)
        (at cheese_1 table_3)
        (clear cheese_1)
        (empty stove_1)
    )
    (:goal
        (and
            (iscooked chicken_1)
            (on bread_1 table_1)
            (atop chicken_1 bread_1)
            (atop cheese_1 chicken_1)
            (atop bread_2 cheese_1)
            (clear bread_2)
        )
    )
)