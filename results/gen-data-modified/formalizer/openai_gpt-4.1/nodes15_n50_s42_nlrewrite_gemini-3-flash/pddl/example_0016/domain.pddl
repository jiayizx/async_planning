(define (domain learning_disability_diagnosis)
  (:requirements :durative-actions)
  (:predicates
    (review_final_diagnostic_report_with_specialist_pending)
    (review_final_diagnostic_report_with_specialist_done)
    (conduct_formal_clinical_observation_in_classroom_pending)
    (conduct_formal_clinical_observation_in_classroom_done)
    (draft_iep_proposal_pending)
    (draft_iep_proposal_done)
    (hold_formal_iep_meeting_with_school_board_pending)
    (hold_formal_iep_meeting_with_school_board_done)
    (administer_standardized_cognitive_tests_pending)
    (administer_standardized_cognitive_tests_done)
    (schedule_initial_consultation_with_child_psychologist_pending)
    (schedule_initial_consultation_with_child_psychologist_done)
    (gather_previous_report_cards_and_teacher_feedback_pending)
    (gather_previous_report_cards_and_teacher_feedback_done)
    (file_completed_assessment_records_with_school_district_pending)
    (file_completed_assessment_records_with_school_district_done)
    (complete_developmental_history_questionnaire_pending)
    (complete_developmental_history_questionnaire_done)
    (obtain_written_parental_consent_for_formal_testing_pending)
    (obtain_written_parental_consent_for_formal_testing_done)
    (perform_comprehensive_speech_and_language_evaluation_pending)
    (perform_comprehensive_speech_and_language_evaluation_done)
    (request_vision_and_hearing_screening_from_pediatrician_pending)
    (request_vision_and_hearing_screening_from_pediatrician_done)
    (attend_intake_interview_to_discuss_concerns_pending)
    (attend_intake_interview_to_discuss_concerns_done)
    (research_local_clinics_and_insurance_coverage_pending)
    (research_local_clinics_and_insurance_coverage_done)
    (analyze_test_scores_and_behavioral_data_pending)
    (analyze_test_scores_and_behavioral_data_done)
  )

  (:durative-action review_final_diagnostic_report_with_specialist
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (review_final_diagnostic_report_with_specialist_pending))
                    (at start (schedule_initial_consultation_with_child_psychologist_done))
                    (at start (perform_comprehensive_speech_and_language_evaluation_done)))
    :effect (and (at start (not (review_final_diagnostic_report_with_specialist_pending)))
                 (at end (review_final_diagnostic_report_with_specialist_done)))
  )

  (:durative-action conduct_formal_clinical_observation_in_classroom
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (conduct_formal_clinical_observation_in_classroom_pending))
                    (at start (gather_previous_report_cards_and_teacher_feedback_done))
                    (at start (complete_developmental_history_questionnaire_done))
                    (at start (obtain_written_parental_consent_for_formal_testing_done)))
    :effect (and (at start (not (conduct_formal_clinical_observation_in_classroom_pending)))
                 (at end (conduct_formal_clinical_observation_in_classroom_done)))
  )

  (:durative-action draft_iep_proposal
    :parameters ()
    :duration (= ?duration 259200)
    :condition (and (at start (draft_iep_proposal_pending))
                    (at start (analyze_test_scores_and_behavioral_data_done)))
    :effect (and (at start (not (draft_iep_proposal_pending)))
                 (at end (draft_iep_proposal_done)))
  )

  (:durative-action hold_formal_iep_meeting_with_school_board
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (hold_formal_iep_meeting_with_school_board_pending))
                    (at start (draft_iep_proposal_done)))
    :effect (and (at start (not (hold_formal_iep_meeting_with_school_board_pending)))
                 (at end (hold_formal_iep_meeting_with_school_board_done)))
  )

  (:durative-action administer_standardized_cognitive_tests
    :parameters ()
    :duration (= ?duration 14400)
    :condition (and (at start (administer_standardized_cognitive_tests_pending))
                    (at start (conduct_formal_clinical_observation_in_classroom_done)))
    :effect (and (at start (not (administer_standardized_cognitive_tests_pending)))
                 (at end (administer_standardized_cognitive_tests_done)))
  )

  (:durative-action schedule_initial_consultation_with_child_psychologist
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (schedule_initial_consultation_with_child_psychologist_pending))
    :effect (and (at start (not (schedule_initial_consultation_with_child_psychologist_pending)))
                 (at end (schedule_initial_consultation_with_child_psychologist_done)))
  )

  (:durative-action gather_previous_report_cards_and_teacher_feedback
    :parameters ()
    :duration (= ?duration 7200)
    :condition (at start (gather_previous_report_cards_and_teacher_feedback_pending))
    :effect (and (at start (not (gather_previous_report_cards_and_teacher_feedback_pending)))
                 (at end (gather_previous_report_cards_and_teacher_feedback_done)))
  )

  (:durative-action file_completed_assessment_records_with_school_district
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (file_completed_assessment_records_with_school_district_pending))
                    (at start (perform_comprehensive_speech_and_language_evaluation_done)))
    :effect (and (at start (not (file_completed_assessment_records_with_school_district_pending)))
                 (at end (file_completed_assessment_records_with_school_district_done)))
  )

  (:durative-action complete_developmental_history_questionnaire
    :parameters ()
    :duration (= ?duration 5400)
    :condition (and (at start (complete_developmental_history_questionnaire_pending))
                    (at start (gather_previous_report_cards_and_teacher_feedback_done)))
    :effect (and (at start (not (complete_developmental_history_questionnaire_pending)))
                 (at end (complete_developmental_history_questionnaire_done)))
  )

  (:durative-action obtain_written_parental_consent_for_formal_testing
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (obtain_written_parental_consent_for_formal_testing_pending))
                    (at start (complete_developmental_history_questionnaire_done))
                    (at start (attend_intake_interview_to_discuss_concerns_done)))
    :effect (and (at start (not (obtain_written_parental_consent_for_formal_testing_pending)))
                 (at end (obtain_written_parental_consent_for_formal_testing_done)))
  )

  (:durative-action perform_comprehensive_speech_and_language_evaluation
    :parameters ()
    :duration (= ?duration 10800)
    :condition (and (at start (perform_comprehensive_speech_and_language_evaluation_pending))
                    (at start (hold_formal_iep_meeting_with_school_board_done)))
    :effect (and (at start (not (perform_comprehensive_speech_and_language_evaluation_pending)))
                 (at end (perform_comprehensive_speech_and_language_evaluation_done)))
  )

  (:durative-action request_vision_and_hearing_screening_from_pediatrician
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (request_vision_and_hearing_screening_from_pediatrician_pending))
                    (at start (attend_intake_interview_to_discuss_concerns_done)))
    :effect (and (at start (not (request_vision_and_hearing_screening_from_pediatrician_pending)))
                 (at end (request_vision_and_hearing_screening_from_pediatrician_done)))
  )

  (:durative-action attend_intake_interview_to_discuss_concerns
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (attend_intake_interview_to_discuss_concerns_pending))
    :effect (and (at start (not (attend_intake_interview_to_discuss_concerns_pending)))
                 (at end (attend_intake_interview_to_discuss_concerns_done)))
  )

  (:durative-action research_local_clinics_and_insurance_coverage
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (research_local_clinics_and_insurance_coverage_pending))
                    (at start (schedule_initial_consultation_with_child_psychologist_done)))
    :effect (and (at start (not (research_local_clinics_and_insurance_coverage_pending)))
                 (at end (research_local_clinics_and_insurance_coverage_done)))
  )

  (:durative-action analyze_test_scores_and_behavioral_data
    :parameters ()
    :duration (= ?duration 604800)
    :condition (and (at start (analyze_test_scores_and_behavioral_data_pending))
                    (at start (administer_standardized_cognitive_tests_done))
                    (at start (obtain_written_parental_consent_for_formal_testing_done)))
    :effect (and (at start (not (analyze_test_scores_and_behavioral_data_pending)))
                 (at end (analyze_test_scores_and_behavioral_data_done)))
  )
)
