(define (domain solve_system_equations)
  (:requirements :durative-actions)
  (:predicates
    (identify_variables_and_coefficients_pending)
    (identify_variables_and_coefficients_done)
    (write_final_solution_set_pending)
    (write_final_solution_set_done)
    (solve_by_back_substitution_pending)
    (solve_by_back_substitution_done)
    (verify_solution_pending)
    (verify_solution_done)
    (multiply_first_equation_pending)
    (multiply_first_equation_done)
    (determine_variable_to_eliminate_pending)
    (determine_variable_to_eliminate_done)
    (rewrite_equations_standard_form_pending)
    (rewrite_equations_standard_form_done)
    (check_arithmetic_errors_pending)
    (check_arithmetic_errors_done)
    (eliminate_one_variable_pending)
    (eliminate_one_variable_done)
    (solve_single_variable_equation_pending)
    (solve_single_variable_equation_done)
    (choose_method_pending)
    (choose_method_done)
    (document_steps_pending)
    (document_steps_done)
    (copy_system_pending)
    (copy_system_done)
    (isolate_first_variable_pending)
    (isolate_first_variable_done)
    (substitute_into_second_equation_pending)
    (substitute_into_second_equation_done)
  )

  (:durative-action identify_variables_and_coefficients
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (identify_variables_and_coefficients_pending))
    :effect (and (at start (not (identify_variables_and_coefficients_pending)))
                 (at end (identify_variables_and_coefficients_done)))
  )

  (:durative-action write_final_solution_set
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (write_final_solution_set_pending))
                    (at start (identify_variables_and_coefficients_done))
                    (at start (multiply_first_equation_done))
                    (at start (eliminate_one_variable_done))
                    (at start (solve_single_variable_equation_done)))
    :effect (and (at start (not (write_final_solution_set_pending)))
                 (at end (write_final_solution_set_done)))
  )

  (:durative-action solve_by_back_substitution
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (solve_by_back_substitution_pending))
                    (at start (isolate_first_variable_done)))
    :effect (and (at start (not (solve_by_back_substitution_pending)))
                 (at end (solve_by_back_substitution_done)))
  )

  (:durative-action verify_solution
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (verify_solution_pending))
                    (at start (substitute_into_second_equation_done)))
    :effect (and (at start (not (verify_solution_pending)))
                 (at end (verify_solution_done)))
  )

  (:durative-action multiply_first_equation
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (multiply_first_equation_pending))
                    (at start (determine_variable_to_eliminate_done))
                    (at start (rewrite_equations_standard_form_done))
                    (at start (choose_method_done)))
    :effect (and (at start (not (multiply_first_equation_pending)))
                 (at end (multiply_first_equation_done)))
  )

  (:durative-action determine_variable_to_eliminate
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (determine_variable_to_eliminate_pending))
                    (at start (choose_method_done)))
    :effect (and (at start (not (determine_variable_to_eliminate_pending)))
                 (at end (determine_variable_to_eliminate_done)))
  )

  (:durative-action rewrite_equations_standard_form
    :parameters ()
    :duration (= ?duration 240)
    :condition (and (at start (rewrite_equations_standard_form_pending))
                    (at start (identify_variables_and_coefficients_done)))
    :effect (and (at start (not (rewrite_equations_standard_form_pending)))
                 (at end (rewrite_equations_standard_form_done)))
  )

  (:durative-action check_arithmetic_errors
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (check_arithmetic_errors_pending))
                    (at start (copy_system_done)))
    :effect (and (at start (not (check_arithmetic_errors_pending)))
                 (at end (check_arithmetic_errors_done)))
  )

  (:durative-action eliminate_one_variable
    :parameters ()
    :duration (= ?duration 240)
    :condition (and (at start (eliminate_one_variable_pending))
                    (at start (choose_method_done)))
    :effect (and (at start (not (eliminate_one_variable_pending)))
                 (at end (eliminate_one_variable_done)))
  )

  (:durative-action solve_single_variable_equation
    :parameters ()
    :duration (= ?duration 360)
    :condition (and (at start (solve_single_variable_equation_pending))
                    (at start (verify_solution_done)))
    :effect (and (at start (not (solve_single_variable_equation_pending)))
                 (at end (solve_single_variable_equation_done)))
  )

  (:durative-action choose_method
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (choose_method_pending))
    :effect (and (at start (not (choose_method_pending)))
                 (at end (choose_method_done)))
  )

  (:durative-action document_steps
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (document_steps_pending))
                    (at start (solve_single_variable_equation_done)))
    :effect (and (at start (not (document_steps_pending)))
                 (at end (document_steps_done)))
  )

  (:durative-action copy_system
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (copy_system_pending))
                    (at start (identify_variables_and_coefficients_done)))
    :effect (and (at start (not (copy_system_pending)))
                 (at end (copy_system_done)))
  )

  (:durative-action isolate_first_variable
    :parameters ()
    :duration (= ?duration 480)
    :condition (and (at start (isolate_first_variable_pending))
                    (at start (choose_method_done)))
    :effect (and (at start (not (isolate_first_variable_pending)))
                 (at end (isolate_first_variable_done)))
  )

  (:durative-action substitute_into_second_equation
    :parameters ()
    :duration (= ?duration 420)
    :condition (and (at start (substitute_into_second_equation_pending))
                    (at start (solve_by_back_substitution_done)))
    :effect (and (at start (not (substitute_into_second_equation_pending)))
                 (at end (substitute_into_second_equation_done)))
  )
)
