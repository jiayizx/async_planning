(define (domain pumpkin-dog-treats)
  (:requirements :durative-actions)
  (:predicates
    (purchase_fresh_pumpkin_puree_and_whole_wheat_flour_pending)
    (purchase_fresh_pumpkin_puree_and_whole_wheat_flour_done)
    (roll_out_the_dough_pending)
    (roll_out_the_dough_done)
    (preheat_the_oven_pending)
    (preheat_the_oven_done)
    (mix_wet_and_dry_ingredients_pending)
    (mix_wet_and_dry_ingredients_done)
    (wash_and_dry_bowls_and_utensils_pending)
    (wash_and_dry_bowls_and_utensils_done)
    (measure_pumpkin_and_flour_pending)
    (measure_pumpkin_and_flour_done)
    (clear_and_sanitize_workspace_pending)
    (clear_and_sanitize_workspace_done)
    (line_baking_sheet_pending)
    (line_baking_sheet_done)
    (research_recipe_pending)
    (research_recipe_done)
    (cut_dough_into_bone_shapes_pending)
    (cut_dough_into_bone_shapes_done)
    (grease_cookie_cutters_pending)
    (grease_cookie_cutters_done)
    (bake_treats_pending)
    (bake_treats_done)
    (place_treats_on_baking_sheet_pending)
    (place_treats_on_baking_sheet_done)
    (cool_treats_on_wire_rack_pending)
    (cool_treats_on_wire_rack_done)
    (organize_workspace_for_cutting_pending)
    (organize_workspace_for_cutting_done)
  )

  (:durative-action purchase_fresh_pumpkin_puree_and_whole_wheat_flour
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (purchase_fresh_pumpkin_puree_and_whole_wheat_flour_pending))
                    (at start (research_recipe_done)))
    :effect (and (at start (not (purchase_fresh_pumpkin_puree_and_whole_wheat_flour_pending)))
                 (at end (purchase_fresh_pumpkin_puree_and_whole_wheat_flour_done)))
  )

  (:durative-action roll_out_the_dough
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (roll_out_the_dough_pending))
                    (at start (mix_wet_and_dry_ingredients_done)))
    :effect (and (at start (not (roll_out_the_dough_pending)))
                 (at end (roll_out_the_dough_done)))
  )

  (:durative-action preheat_the_oven
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (preheat_the_oven_pending))
    :effect (and (at start (not (preheat_the_oven_pending)))
                 (at end (preheat_the_oven_done)))
  )

  (:durative-action mix_wet_and_dry_ingredients
    :parameters ()
    :duration (= ?duration 480)
    :condition (and (at start (mix_wet_and_dry_ingredients_pending))
                    (at start (clear_and_sanitize_workspace_done)))
    :effect (and (at start (not (mix_wet_and_dry_ingredients_pending)))
                 (at end (mix_wet_and_dry_ingredients_done)))
  )

  (:durative-action wash_and_dry_bowls_and_utensils
    :parameters ()
    :duration (= ?duration 720)
    :condition (at start (wash_and_dry_bowls_and_utensils_pending))
    :effect (and (at start (not (wash_and_dry_bowls_and_utensils_pending)))
                 (at end (wash_and_dry_bowls_and_utensils_done)))
  )

  (:durative-action measure_pumpkin_and_flour
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (measure_pumpkin_and_flour_pending))
                    (at start (purchase_fresh_pumpkin_puree_and_whole_wheat_flour_done)))
    :effect (and (at start (not (measure_pumpkin_and_flour_pending)))
                 (at end (measure_pumpkin_and_flour_done)))
  )

  (:durative-action clear_and_sanitize_workspace
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (clear_and_sanitize_workspace_pending))
    :effect (and (at start (not (clear_and_sanitize_workspace_pending)))
                 (at end (clear_and_sanitize_workspace_done)))
  )

  (:durative-action line_baking_sheet
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (line_baking_sheet_pending))
                    (at start (wash_and_dry_bowls_and_utensils_done))
                    (at start (measure_pumpkin_and_flour_done)))
    :effect (and (at start (not (line_baking_sheet_pending)))
                 (at end (line_baking_sheet_done)))
  )

  (:durative-action research_recipe
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (research_recipe_pending))
    :effect (and (at start (not (research_recipe_pending)))
                 (at end (research_recipe_done)))
  )

  (:durative-action cut_dough_into_bone_shapes
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (cut_dough_into_bone_shapes_pending))
                    (at start (research_recipe_done))
                    (at start (organize_workspace_for_cutting_done)))
    :effect (and (at start (not (cut_dough_into_bone_shapes_pending)))
                 (at end (cut_dough_into_bone_shapes_done)))
  )

  (:durative-action grease_cookie_cutters
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (grease_cookie_cutters_pending))
    :effect (and (at start (not (grease_cookie_cutters_pending)))
                 (at end (grease_cookie_cutters_done)))
  )

  (:durative-action bake_treats
    :parameters ()
    :duration (= ?duration 2400)
    :condition (and (at start (bake_treats_pending))
                    (at start (preheat_the_oven_done))
                    (at start (place_treats_on_baking_sheet_done)))
    :effect (and (at start (not (bake_treats_pending)))
                 (at end (bake_treats_done)))
  )

  (:durative-action place_treats_on_baking_sheet
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (place_treats_on_baking_sheet_pending))
                    (at start (cut_dough_into_bone_shapes_done))
                    (at start (grease_cookie_cutters_done)))
    :effect (and (at start (not (place_treats_on_baking_sheet_pending)))
                 (at end (place_treats_on_baking_sheet_done)))
  )

  (:durative-action cool_treats_on_wire_rack
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (cool_treats_on_wire_rack_pending))
                    (at start (bake_treats_done)))
    :effect (and (at start (not (cool_treats_on_wire_rack_pending)))
                 (at end (cool_treats_on_wire_rack_done)))
  )

  (:durative-action organize_workspace_for_cutting
    :parameters ()
    :duration (= ?duration 240)
    :condition (and (at start (organize_workspace_for_cutting_pending))
                    (at start (wash_and_dry_bowls_and_utensils_done)))
    :effect (and (at start (not (organize_workspace_for_cutting_pending)))
                 (at end (organize_workspace_for_cutting_done)))
  )
)
