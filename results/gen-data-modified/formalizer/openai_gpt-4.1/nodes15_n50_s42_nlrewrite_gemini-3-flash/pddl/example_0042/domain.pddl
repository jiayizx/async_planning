(define (domain beach_scene)
  (:requirements :durative-actions)
  (:predicates
    (apply_final_glossy_fixative_spray_pending)
    (apply_final_glossy_fixative_spray_done)
    (sketch_rough_outline_palm_trees_pending)
    (sketch_rough_outline_palm_trees_done)
    (paint_distant_blue_ocean_water_pending)
    (paint_distant_blue_ocean_water_done)
    (layer_white_foam_crashing_waves_pending)
    (layer_white_foam_crashing_waves_done)
    (block_in_basic_shapes_tide_pending)
    (block_in_basic_shapes_tide_done)
    (prime_canvas_light_gesso_pending)
    (prime_canvas_light_gesso_done)
    (sketch_distant_sailboats_horizon_pending)
    (sketch_distant_sailboats_horizon_done)
    (set_up_easel_organize_brushes_pending)
    (set_up_easel_organize_brushes_done)
    (mix_various_shades_sand_tan_paint_pending)
    (mix_various_shades_sand_tan_paint_done)
    (add_detailed_texture_palm_tree_trunks_pending)
    (add_detailed_texture_palm_tree_trunks_done)
    (paint_details_clouds_sky_pending)
    (paint_details_clouds_sky_done)
    (sketch_initial_positions_clouds_pending)
    (sketch_initial_positions_clouds_done)
    (sign_bottom_corner_artwork_pending)
    (sign_bottom_corner_artwork_done)
    (purchase_necessary_art_supplies_pending)
    (purchase_necessary_art_supplies_done)
    (blend_colors_shoreline_pending)
    (blend_colors_shoreline_done)
  )

  (:durative-action apply_final_glossy_fixative_spray
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (apply_final_glossy_fixative_spray_pending))
                    (at start (prime_canvas_light_gesso_done))
                    (at start (sign_bottom_corner_artwork_done)))
    :effect (and (at start (not (apply_final_glossy_fixative_spray_pending)))
                 (at end (apply_final_glossy_fixative_spray_done)))
  )

  (:durative-action sketch_rough_outline_palm_trees
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (sketch_rough_outline_palm_trees_pending))
                    (at start (purchase_necessary_art_supplies_done)))
    :effect (and (at start (not (sketch_rough_outline_palm_trees_pending)))
                 (at end (sketch_rough_outline_palm_trees_done)))
  )

  (:durative-action paint_distant_blue_ocean_water
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (paint_distant_blue_ocean_water_pending))
                    (at start (prime_canvas_light_gesso_done))
                    (at start (set_up_easel_organize_brushes_done)))
    :effect (and (at start (not (paint_distant_blue_ocean_water_pending)))
                 (at end (paint_distant_blue_ocean_water_done)))
  )

  (:durative-action layer_white_foam_crashing_waves
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (layer_white_foam_crashing_waves_pending))
                    (at start (block_in_basic_shapes_tide_done)))
    :effect (and (at start (not (layer_white_foam_crashing_waves_pending)))
                 (at end (layer_white_foam_crashing_waves_done)))
  )

  (:durative-action block_in_basic_shapes_tide
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (block_in_basic_shapes_tide_pending))
                    (at start (prime_canvas_light_gesso_done)))
    :effect (and (at start (not (block_in_basic_shapes_tide_pending)))
                 (at end (block_in_basic_shapes_tide_done)))
  )

  (:durative-action prime_canvas_light_gesso
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (prime_canvas_light_gesso_pending))
                    (at start (purchase_necessary_art_supplies_done)))
    :effect (and (at start (not (prime_canvas_light_gesso_pending)))
                 (at end (prime_canvas_light_gesso_done)))
  )

  (:durative-action sketch_distant_sailboats_horizon
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (sketch_distant_sailboats_horizon_pending))
                    (at start (set_up_easel_organize_brushes_done)))
    :effect (and (at start (not (sketch_distant_sailboats_horizon_pending)))
                 (at end (sketch_distant_sailboats_horizon_done)))
  )

  (:durative-action set_up_easel_organize_brushes
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (set_up_easel_organize_brushes_pending))
    :effect (and (at start (not (set_up_easel_organize_brushes_pending)))
                 (at end (set_up_easel_organize_brushes_done)))
  )

  (:durative-action mix_various_shades_sand_tan_paint
    :parameters ()
    :duration (= ?duration 720)
    :condition (and (at start (mix_various_shades_sand_tan_paint_pending))
                    (at start (set_up_easel_organize_brushes_done)))
    :effect (and (at start (not (mix_various_shades_sand_tan_paint_pending)))
                 (at end (mix_various_shades_sand_tan_paint_done)))
  )

  (:durative-action add_detailed_texture_palm_tree_trunks
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (add_detailed_texture_palm_tree_trunks_pending))
                    (at start (sketch_rough_outline_palm_trees_done)))
    :effect (and (at start (not (add_detailed_texture_palm_tree_trunks_pending)))
                 (at end (add_detailed_texture_palm_tree_trunks_done)))
  )

  (:durative-action paint_details_clouds_sky
    :parameters ()
    :duration (= ?duration 2400)
    :condition (and (at start (paint_details_clouds_sky_pending))
                    (at start (sketch_distant_sailboats_horizon_done))
                    (at start (set_up_easel_organize_brushes_done))
                    (at start (sketch_initial_positions_clouds_done)))
    :effect (and (at start (not (paint_details_clouds_sky_pending)))
                 (at end (paint_details_clouds_sky_done)))
  )

  (:durative-action sketch_initial_positions_clouds
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (sketch_initial_positions_clouds_pending))
    :effect (and (at start (not (sketch_initial_positions_clouds_pending)))
                 (at end (sketch_initial_positions_clouds_done)))
  )

  (:durative-action sign_bottom_corner_artwork
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (sign_bottom_corner_artwork_pending))
                    (at start (blend_colors_shoreline_done)))
    :effect (and (at start (not (sign_bottom_corner_artwork_pending)))
                 (at end (sign_bottom_corner_artwork_done)))
  )

  (:durative-action purchase_necessary_art_supplies
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (purchase_necessary_art_supplies_pending))
    :effect (and (at start (not (purchase_necessary_art_supplies_pending)))
                 (at end (purchase_necessary_art_supplies_done)))
  )

  (:durative-action blend_colors_shoreline
    :parameters ()
    :duration (= ?duration 1500)
    :condition (and (at start (blend_colors_shoreline_pending))
                    (at start (layer_white_foam_crashing_waves_done)))
    :effect (and (at start (not (blend_colors_shoreline_pending)))
                 (at end (blend_colors_shoreline_done)))
  )
)
