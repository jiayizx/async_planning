(define (domain visit_ruins)
  (:requirements :durative-actions)
  (:predicates
    (purchase_tickets_pending) (purchase_tickets_done)
    (download_map_pending) (download_map_done)
    (pack_day_bag_pending) (pack_day_bag_done)
    (withdraw_currency_pending) (withdraw_currency_done)
    (charge_camera_pending) (charge_camera_done)
    (research_customs_pending) (research_customs_done)
    (book_guide_pending) (book_guide_done)
    (buy_boots_pending) (buy_boots_done)
    (check_weather_pending) (check_weather_done)
    (apply_permit_pending) (apply_permit_done)
    (renew_passport_pending) (renew_passport_done)
    (confirm_hotel_pending) (confirm_hotel_done)
    (book_flight_pending) (book_flight_done)
    (arrange_sitter_pending) (arrange_sitter_done)
    (buy_insurance_pending) (buy_insurance_done)
    (break_in_boots_pending) (break_in_boots_done)
    (reserve_car_pending) (reserve_car_done)
    (pickup_car_keys_pending) (pickup_car_keys_done)
    (schedule_vaccine_pending) (schedule_vaccine_done)
    (select_site_pending) (select_site_done)
    (consult_agency_pending) (consult_agency_done)
    (hire_driver_pending) (hire_driver_done)
    (request_timeoff_pending) (request_timeoff_done)
    (drive_to_ruins_pending) (drive_to_ruins_done)
    (pack_firstaid_pending) (pack_firstaid_done)
    (print_confirmations_pending) (print_confirmations_done)
    (exchange_tips_pending) (exchange_tips_done)
    (map_route_pending) (map_route_done)
    (confirm_flight_pending) (confirm_flight_done)
    (checkup_pending) (checkup_done)
  )

  (:durative-action purchase_tickets
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (purchase_tickets_pending)) (at start (apply_permit_done)) (at start (arrange_sitter_done)) (at start (confirm_flight_done)))
    :effect (and (at start (not (purchase_tickets_pending))) (at end (purchase_tickets_done)))
  )
  (:durative-action download_map
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (download_map_pending)) (at start (checkup_done)))
    :effect (and (at start (not (download_map_pending))) (at end (download_map_done)))
  )
  (:durative-action pack_day_bag
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (pack_day_bag_pending)) (at start (select_site_done)) (at start (request_timeoff_done)))
    :effect (and (at start (not (pack_day_bag_pending))) (at end (pack_day_bag_done)))
  )
  (:durative-action withdraw_currency
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (withdraw_currency_pending)) (at start (research_customs_done)))
    :effect (and (at start (not (withdraw_currency_pending))) (at end (withdraw_currency_done)))
  )
  (:durative-action charge_camera
    :parameters ()
    :duration (= ?duration 43200)
    :condition (and (at start (charge_camera_pending)) (at start (pack_day_bag_done)) (at start (renew_passport_done)))
    :effect (and (at start (not (charge_camera_pending))) (at end (charge_camera_done)))
  )
  (:durative-action research_customs
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (research_customs_pending)) (at start (renew_passport_done)) (at start (select_site_done)))
    :effect (and (at start (not (research_customs_pending))) (at end (research_customs_done)))
  )
  (:durative-action book_guide
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (book_guide_pending)) (at start (checkup_done)))
    :effect (and (at start (not (book_guide_pending))) (at end (book_guide_done)))
  )
  (:durative-action buy_boots
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (buy_boots_pending)) (at start (consult_agency_done)))
    :effect (and (at start (not (buy_boots_pending))) (at end (buy_boots_done)))
  )
  (:durative-action check_weather
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (check_weather_pending))
    :effect (and (at start (not (check_weather_pending))) (at end (check_weather_done)))
  )
  (:durative-action apply_permit
    :parameters ()
    :duration (= ?duration 259200)
    :condition (and (at start (apply_permit_pending)) (at start (book_guide_done)))
    :effect (and (at start (not (apply_permit_pending))) (at end (apply_permit_done)))
  )
  (:durative-action renew_passport
    :parameters ()
    :duration (= ?duration 2419200)
    :condition (at start (renew_passport_pending))
    :effect (and (at start (not (renew_passport_pending))) (at end (renew_passport_done)))
  )
  (:durative-action confirm_hotel
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (confirm_hotel_pending)) (at start (book_flight_done)))
    :effect (and (at start (not (confirm_hotel_pending))) (at end (confirm_hotel_done)))
  )
  (:durative-action book_flight
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (book_flight_pending))
    :effect (and (at start (not (book_flight_pending))) (at end (book_flight_done)))
  )
  (:durative-action arrange_sitter
    :parameters ()
    :duration (= ?duration 172800)
    :condition (at start (arrange_sitter_pending))
    :effect (and (at start (not (arrange_sitter_pending))) (at end (arrange_sitter_done)))
  )
  (:durative-action buy_insurance
    :parameters ()
    :duration (= ?duration 2700)
    :condition (at start (buy_insurance_pending))
    :effect (and (at start (not (buy_insurance_pending))) (at end (buy_insurance_done)))
  )
  (:durative-action break_in_boots
    :parameters ()
    :duration (= ?duration 345600)
    :condition (and (at start (break_in_boots_pending)) (at start (select_site_done)))
    :effect (and (at start (not (break_in_boots_pending))) (at end (break_in_boots_done)))
  )
  (:durative-action reserve_car
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (reserve_car_pending)) (at start (book_flight_done)) (at start (schedule_vaccine_done)))
    :effect (and (at start (not (reserve_car_pending))) (at end (reserve_car_done)))
  )
  (:durative-action pickup_car_keys
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (pickup_car_keys_pending)) (at start (reserve_car_done)))
    :effect (and (at start (not (pickup_car_keys_pending))) (at end (pickup_car_keys_done)))
  )
  (:durative-action schedule_vaccine
    :parameters ()
    :duration (= ?duration 604800)
    :condition (and (at start (schedule_vaccine_pending)) (at start (apply_permit_done)) (at start (checkup_done)))
    :effect (and (at start (not (schedule_vaccine_pending))) (at end (schedule_vaccine_done)))
  )
  (:durative-action select_site
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (select_site_pending)) (at start (buy_boots_done)))
    :effect (and (at start (not (select_site_pending))) (at end (select_site_done)))
  )
  (:durative-action consult_agency
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (consult_agency_pending)) (at start (apply_permit_done)))
    :effect (and (at start (not (consult_agency_pending))) (at end (consult_agency_done)))
  )
  (:durative-action hire_driver
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (hire_driver_pending)) (at start (exchange_tips_done)))
    :effect (and (at start (not (hire_driver_pending))) (at end (hire_driver_done)))
  )
  (:durative-action request_timeoff
    :parameters ()
    :duration (= ?duration 432000)
    :condition (and (at start (request_timeoff_pending)) (at start (renew_passport_done)) (at start (schedule_vaccine_done)))
    :effect (and (at start (not (request_timeoff_pending))) (at end (request_timeoff_done)))
  )
  (:durative-action drive_to_ruins
    :parameters ()
    :duration (= ?duration 10800)
    :condition (and (at start (drive_to_ruins_pending)) (at start (pack_firstaid_done)))
    :effect (and (at start (not (drive_to_ruins_pending))) (at end (drive_to_ruins_done)))
  )
  (:durative-action pack_firstaid
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (pack_firstaid_pending)) (at start (research_customs_done)) (at start (hire_driver_done)))
    :effect (and (at start (not (pack_firstaid_pending))) (at end (pack_firstaid_done)))
  )
  (:durative-action print_confirmations
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (print_confirmations_pending)) (at start (purchase_tickets_done)) (at start (buy_insurance_done)))
    :effect (and (at start (not (print_confirmations_pending))) (at end (print_confirmations_done)))
  )
  (:durative-action exchange_tips
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (exchange_tips_pending)) (at start (pack_day_bag_done)) (at start (withdraw_currency_done)) (at start (research_customs_done)) (at start (check_weather_done)) (at start (request_timeoff_done)) (at start (confirm_flight_done)))
    :effect (and (at start (not (exchange_tips_pending))) (at end (exchange_tips_done)))
  )
  (:durative-action map_route
    :parameters ()
    :duration (= ?duration 2400)
    :condition (and (at start (map_route_pending)) (at start (book_flight_done)))
    :effect (and (at start (not (map_route_pending))) (at end (map_route_done)))
  )
  (:durative-action confirm_flight
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (confirm_flight_pending)) (at start (map_route_done)))
    :effect (and (at start (not (confirm_flight_pending))) (at end (confirm_flight_done)))
  )
  (:durative-action checkup
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (checkup_pending)) (at start (renew_passport_done)))
    :effect (and (at start (not (checkup_pending))) (at end (checkup_done)))
  )
)
