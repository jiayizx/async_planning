(define (domain knit-blanket)
  (:requirements :durative-actions)
  (:predicates
    (choose_pattern_and_purchase_yarn_pending)
    (choose_pattern_and_purchase_yarn_done)
    (wind_yarn_pending)
    (wind_yarn_done)
    (knit_main_body_pending)
    (knit_main_body_done)
    (cast_on_pending)
    (cast_on_done)
    (weave_in_ends_pending)
    (weave_in_ends_done)
    (swatch_and_measure_pending)
    (swatch_and_measure_done)
    (knit_border_pending)
    (knit_border_done)
    (hand_wash_pending)
    (hand_wash_done)
    (organize_needles_pending)
    (organize_needles_done)
    (block_and_dry_pending)
    (block_and_dry_done)
  )

  (:durative-action choose_pattern_and_purchase_yarn
    :parameters ()
    :duration (= ?duration 2700)
    :condition (at start (choose_pattern_and_purchase_yarn_pending))
    :effect (and (at start (not (choose_pattern_and_purchase_yarn_pending)))
                 (at end (choose_pattern_and_purchase_yarn_done)))
  )

  (:durative-action wind_yarn
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (wind_yarn_pending))
                    (at start (choose_pattern_and_purchase_yarn_done)))
    :effect (and (at start (not (wind_yarn_pending)))
                 (at end (wind_yarn_done)))
  )

  (:durative-action knit_main_body
    :parameters ()
    :duration (= ?duration 1209600)
    :condition (and (at start (knit_main_body_pending))
                    (at start (cast_on_done)))
    :effect (and (at start (not (knit_main_body_pending)))
                 (at end (knit_main_body_done)))
  )

  (:durative-action cast_on
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (cast_on_pending))
                    (at start (swatch_and_measure_done)))
    :effect (and (at start (not (cast_on_pending)))
                 (at end (cast_on_done)))
  )

  (:durative-action weave_in_ends
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (weave_in_ends_pending))
                    (at start (knit_border_done)))
    :effect (and (at start (not (weave_in_ends_pending)))
                 (at end (weave_in_ends_done)))
  )

  (:durative-action swatch_and_measure
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (swatch_and_measure_pending))
                    (at start (choose_pattern_and_purchase_yarn_done)))
    :effect (and (at start (not (swatch_and_measure_pending)))
                 (at end (swatch_and_measure_done)))
  )

  (:durative-action knit_border
    :parameters ()
    :duration (= ?duration 259200)
    :condition (and (at start (knit_border_pending))
                    (at start (wind_yarn_done))
                    (at start (organize_needles_done)))
    :effect (and (at start (not (knit_border_pending)))
                 (at end (knit_border_done)))
  )

  (:durative-action hand_wash
    :parameters ()
    :duration (= ?duration 2400)
    :condition (and (at start (hand_wash_pending))
                    (at start (weave_in_ends_done)))
    :effect (and (at start (not (hand_wash_pending)))
                 (at end (hand_wash_done)))
  )

  (:durative-action organize_needles
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (organize_needles_pending))
    :effect (and (at start (not (organize_needles_pending)))
                 (at end (organize_needles_done)))
  )

  (:durative-action block_and_dry
    :parameters ()
    :duration (= ?duration 86400)
    :condition (and (at start (block_and_dry_pending))
                    (at start (hand_wash_done)))
    :effect (and (at start (not (block_and_dry_pending)))
                 (at end (block_and_dry_done)))
  )
)
