(define (problem nintendo-ds-play-problem)
  (:domain nintendo-ds-play)
  (:init
    (insert_game_pending)
    (calibrate_touch_pending)
    (locate_console_pending)
    (charge_battery_pending)
    (connect_ac_pending)
    (power_on_pending)
    (select_game_pending)
    (clean_case_pending)
    (configure_clock_pending)
    (open_lid_pending)
  )
  (:goal (and
    (insert_game_done)
    (calibrate_touch_done)
    (locate_console_done)
    (charge_battery_done)
    (connect_ac_done)
    (power_on_done)
    (select_game_done)
    (clean_case_done)
    (configure_clock_done)
    (open_lid_done)
  ))
)
