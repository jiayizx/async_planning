(define (problem remove-pet-hair-prob)
  (:domain remove-pet-hair)
  (:objects step1 step2 step3 step4 - step)
  (:init
    (step_pending step1)
    (step_pending step2)
    (step_pending step3)
    (step_pending step4)
  )
  ;; Goal requires all steps done AND the final semantic predicate (vacuum_done)
  (:goal (and
            (step_done step1)
            (step_done step2)
            (step_done step3)
            (step_done step4)
            (vacuum_done)
         ))
)
