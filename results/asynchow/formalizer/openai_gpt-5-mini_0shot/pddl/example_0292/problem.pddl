(define (problem eat-kumquat-prob)
  (:domain eat-kumquat)
  (:init
    (step_pending step1)
    (step_pending step2)
    (step_pending step3)
    (step_pending step4)
    (step_pending step5)
    (step_pending step6)
  )
  ;; Goal: all steps done AND ensure the main chain completes (eat_done)
  (:goal (and
           (step_done step1)
           (step_done step2)
           (step_done step3)
           (step_done step4)
           (step_done step5)
           (step_done step6)
           (eat_done)
         ))
)
