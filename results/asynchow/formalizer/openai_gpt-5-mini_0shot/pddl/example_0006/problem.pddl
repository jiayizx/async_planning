    (step_pending step2)
    (step_pending step3)
    (step_pending step4)
    (step_pending step5)
    (step_pending step6)
    (is_s1 step1)
    (is_s2 step2)
    (is_s3 step3)
    (is_s4 step4)
    (is_s5 step5)
    (is_s6 step6)
  )
  (:goal (and
