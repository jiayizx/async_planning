(define (problem organize-small-house-prob)
  (:domain organize-house)
  (:objects step1 step2 step3 step4 step5 - step)
  (:init
    ;; all steps start pending
    (step_pending step1)
    (step_pending step2)
    (step_pending step3)
    (step_pending step4)
    (step_pending step5)
  )
  ;; Goal: all steps completed and include the terminal semantic predicates
  ;; Terminal semantic predicates are the outcomes of the last actions (steps 2-5)
  (:goal (and
    (step_done step1)
    (step_done step2)
    (step_done step3)
    (step_done step4)
    (step_done step5)
    (bought_storage_done)
    (bookshelves_done)
    (drawers_done)
    (bought_kitchen_done)
  ))
)
