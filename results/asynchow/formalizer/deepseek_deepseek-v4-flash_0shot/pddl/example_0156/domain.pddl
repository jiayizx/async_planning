(define (domain keep_sodium_levels_up)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending)
    (step1_done)
    (step2_pending)
    (step2_done)
    (step3_pending)
    (step3_done)
    (talk_done)
    (nausea_done)
    (diarrheals_done)
  )
  (:durative-action do_step1
    :duration (= ?duration 1800)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (talk_done)))
  )
  (:durative-action do_step2
    :duration (= ?duration 3600)
    :condition (and (at start (step2_pending)) (at start (talk_done)))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (nausea_done)))
  )
  (:durative-action do_step3
    :duration (= ?duration 3600)
    :condition (and (at start (step3_pending)) (at start (talk_done)))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (diarrheals_done)))
  )
)