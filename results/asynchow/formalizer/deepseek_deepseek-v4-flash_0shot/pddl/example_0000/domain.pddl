(define (domain impress_girls)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (interests_researched)
    (popular_girls_known)
    (hangout_known)
    (loc_reached)
    (impression_made)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (interests_researched)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (popular_girls_known)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (popular_girls_known)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (hangout_known)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s)) (at start (hangout_known)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (loc_reached)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s)) (at start (interests_researched)) (at start (loc_reached)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (impression_made)))
  )
)