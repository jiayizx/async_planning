(define (domain play_chinchilla)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending)
    (step2_pending)
    (step3_pending)
    (step4_pending)
    (step1_done)
    (step2_done)
    (step3_done)
    (step4_done)
    (play_ready)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 5)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending)))
                 (at end (step1_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step2_pending))
                    (at start (step1_done)))
    :effect (and (at start (not (step2_pending)))
                 (at end (step2_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 15)
    :condition (and (at start (step3_pending))
                    (at start (step1_done)))
    :effect (and (at start (not (step3_pending)))
                 (at end (step3_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step4_pending))
                    (at start (step1_done)))
    :effect (and (at start (not (step4_pending)))
                 (at end (step4_done))
                 (at end (play_ready)))
  )
)