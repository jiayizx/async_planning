(define (domain make-friends)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (find_gathering_done)
    (go_to_gatherings_done)
    (introduce_done)
    (have_conversations_done)
    (find_common_done)
    (invite_coffee_done)
    (meet_coffee_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (find_gathering_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 2592000)
    :condition (and (at start (step_pending step2)) (at start (find_gathering_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (go_to_gatherings_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step3)) (at start (go_to_gatherings_done)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (introduce_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step4)) (at start (go_to_gatherings_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (have_conversations_done)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step5)) (at start (introduce_done)) (at start (have_conversations_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (find_common_done)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step6)) (at start (find_common_done)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (invite_coffee_done)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 2592000)
    :condition (and (at start (step_pending step7)) (at start (invite_coffee_done)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (meet_coffee_done)))
  )
)