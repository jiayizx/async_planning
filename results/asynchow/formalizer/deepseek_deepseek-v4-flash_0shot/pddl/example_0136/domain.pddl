(define (domain asl)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (understand_done)
    (practice_done)
    (learn_done)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (understand_done)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s)) (at start (understand_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (practice_done)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s)) (at start (understand_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (learn_done)))
  )
)