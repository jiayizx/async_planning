(define (domain watching_game)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (snacks_bought)
    (clothes_changed)
    (sat_on_couch)
    (snacks_in_bowls)
    (tv_on)
    (bowls_on_table)
    (channel_flipped)
  )
  (:durative-action do_buy_snacks
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (snacks_bought)))
  )
  (:durative-action do_change_clothes
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step2)) (at start (snacks_bought)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (clothes_changed)))
  )
  (:durative-action do_sit_on_couch
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step3)) (at start (clothes_changed)) (at start (bowls_on_table)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (sat_on_couch)))
  )
  (:durative-action do_put_snacks_in_bowls
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step4)) (at start (snacks_bought)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (snacks_in_bowls)))
  )
  (:durative-action do_turn_on_tv
    :parameters ()
    :duration (= ?duration 3)
    :condition (and (at start (step_pending step5)) (at start (snacks_bought)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (tv_on)))
  )
  (:durative-action do_put_bowls_on_table
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step6)) (at start (snacks_in_bowls)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (bowls_on_table)))
  )
  (:durative-action do_flip_channel
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step7)) (at start (tv_on)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (channel_flipped)))
  )
)