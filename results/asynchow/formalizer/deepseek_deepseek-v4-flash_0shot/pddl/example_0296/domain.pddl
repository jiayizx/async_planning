(define (domain cook_mushrooms)
  (:requirements :durative-actions :duration-inequalities :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (heat_oil_done)
    (prepare_mushrooms_done)
    (add_shiitakes_done)
    (cook_done)
    (season_serve_done)
  )
  (:durative-action do_heat_oil
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (heat_oil_done)))
  )
  (:durative-action do_prepare_mushrooms
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (prepare_mushrooms_done)))
  )
  (:durative-action do_add_shiitakes
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step3)) (at start (heat_oil_done)) (at start (prepare_mushrooms_done)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (add_shiitakes_done)))
  )
  (:durative-action do_cook
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step4)) (at start (add_shiitakes_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (cook_done)))
  )
  (:durative-action do_season_serve
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step5)) (at start (cook_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (season_serve_done)))
  )
)