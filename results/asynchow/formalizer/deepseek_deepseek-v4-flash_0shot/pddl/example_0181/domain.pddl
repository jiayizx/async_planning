(define (domain recycle_wood)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (search_done)
    (remove_done)
    (cut_done)
    (transport_done)
  )
  (:durative-action do_Search
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (search_done)))
  )
  (:durative-action do_Remove
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (remove_done)))
  )
  (:durative-action do_Cut
    :parameters ()
    :duration (= ?duration 7200)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (cut_done)))
  )
  (:durative-action do_Transport
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step4))
                    (at start (search_done))
                    (at start (remove_done))
                    (at start (cut_done)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (transport_done)))
  )
)