(define (domain double-jointed)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (lift_pinky_done)
    (push_thumb_done)
    (open_elbow_done)
    (extend_knees_done)
    (bend_waist_done)
    (total_points_done)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (lift_pinky_done)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (push_thumb_done)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 3)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (open_elbow_done)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 3)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (extend_knees_done)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (bend_waist_done)))
  )
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (lift_pinky_done)) (at start (push_thumb_done)) (at start (open_elbow_done)) (at start (extend_knees_done)) (at start (bend_waist_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (total_points_done)))
  )
)
