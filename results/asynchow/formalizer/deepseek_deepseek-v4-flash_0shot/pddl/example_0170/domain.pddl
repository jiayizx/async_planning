(define (domain minimalist)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (changes_discussed)
    (moving_considered)
    (car_less_thought)
    (furniture_cleared)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 172800)
    :condition (and (at start (step_pending step1)) (at start (moving_considered)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (furniture_cleared)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 5184000)
    :condition (and (at start (step_pending step2)) (at start (changes_discussed)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (moving_considered)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 5184000)
    :condition (and (at start (step_pending step3)) (at start (changes_discussed)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (car_less_thought)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 1209600)
    :condition (at start (step_pending step4))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (changes_discussed)))
  )
)