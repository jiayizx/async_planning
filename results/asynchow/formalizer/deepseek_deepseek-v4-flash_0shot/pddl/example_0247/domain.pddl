(define (domain get_period_home_alone)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (looked_under_sink)
    (looked_in_linen_closet)
    (asked_neighbor)
    (went_to_store)
    (period_handled)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (looked_under_sink)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 180)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (looked_in_linen_closet)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (asked_neighbor)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (went_to_store)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (looked_under_sink)) (at start (looked_in_linen_closet)) (at start (asked_neighbor)) (at start (went_to_store)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (period_handled)))
  )
)
