(define (domain backflip)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (youtube_searched)
    (videos_watched)
    (gym_contacted)
    (teach_asked)
    (trainer_booked)
    (advice_followed)
    (ready)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (youtube_searched)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step2)) (at start (youtube_searched)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (videos_watched)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step3)) (at start (videos_watched)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (gym_contacted)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step4)) (at start (gym_contacted)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (teach_asked)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step5)) (at start (gym_contacted)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (trainer_booked)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 2592000)
    :condition (and (at start (step_pending step6)) (at start (teach_asked)) (at start (trainer_booked)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (advice_followed)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 2592000)
    :condition (and (at start (step_pending step7)) (at start (advice_followed)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (ready)))
  )
)