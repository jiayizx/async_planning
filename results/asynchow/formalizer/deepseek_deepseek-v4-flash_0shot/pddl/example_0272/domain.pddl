(define (domain equity-calculation)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (pending ?s - step)
    (done ?s - step)
    (assets_added)
    (contra_calculated)
    (net_asset_calculated)
    (liabilities_calculated)
    (equity_amount_calculated)
    (equity_individual_calculated)
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (pending step4))
    :effect (and (at start (not (pending step4))) (at end (done step4)) (at end (liabilities_calculated)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (pending step5)) (at start (liabilities_calculated)))
    :effect (and (at start (not (pending step5))) (at end (done step5)) (at end (equity_amount_calculated)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (pending step6)) (at start (equity_amount_calculated)))
    :effect (and (at start (not (pending step6))) (at end (done step6)) (at end (equity_individual_calculated)))
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (pending step1)) (at start (equity_individual_calculated)))
    :effect (and (at start (not (pending step1))) (at end (done step1)) (at end (assets_added)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (pending step2)) (at start (equity_individual_calculated)))
    :effect (and (at start (not (pending step2))) (at end (done step2)) (at end (contra_calculated)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (pending step3)) (at start (assets_added)) (at start (contra_calculated)))
    :effect (and (at start (not (pending step3))) (at end (done step3)) (at end (net_asset_calculated)))
  )
)