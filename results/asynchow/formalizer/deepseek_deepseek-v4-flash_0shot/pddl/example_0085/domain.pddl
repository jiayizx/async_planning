(define (domain adopt_child)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (call_done)
    (identification_checks_done)
    (callback_done)
    (meet_child_done)
    (last_id_checks_done)
    (bring_child_home_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (call_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 432000)
    :condition (and (at start (step_pending step2)) (at start (call_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (identification_checks_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 31536000)
    :condition (and (at start (step_pending step3)) (at start (identification_checks_done)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (callback_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step4)) (at start (callback_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (meet_child_done)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 31536000)
    :condition (and (at start (step_pending step5)) (at start (callback_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (last_id_checks_done)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step6)) (at start (meet_child_done)) (at start (last_id_checks_done)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (bring_child_home_done)))
  )
)