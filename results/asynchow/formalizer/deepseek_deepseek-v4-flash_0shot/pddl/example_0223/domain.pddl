(define (domain groom_labradoodle)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (bathe_done)
    (setup_done)
    (shampoo_done)
    (rinse_done)
    (dry_done)
  )
  (:durative-action do_bathe
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (bathe_done)))
  )
  (:durative-action do_setup
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (setup_done)))
  )
  (:durative-action do_shampoo
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s))
                    (at start (setup_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (shampoo_done)))
  )
  (:durative-action do_rinse
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s))
                    (at start (shampoo_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (rinse_done)))
  )
  (:durative-action do_dry
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s))
                    (at start (rinse_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (dry_done)))
  )
)