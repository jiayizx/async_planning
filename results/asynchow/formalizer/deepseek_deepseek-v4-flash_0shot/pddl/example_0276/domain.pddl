(define (domain puzzle1)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (hint_observed)
    (policeman_given)
    (chef_given)
    (doctor_given)
    (fireman_given)
    (object_dragged)
    (level_completed)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 2)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (hint_observed)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 4)
    :condition (and (at start (step_pending step2)) (at start (hint_observed)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (policeman_given)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 4)
    :condition (and (at start (step_pending step3)) (at start (hint_observed)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (chef_given)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 4)
    :condition (and (at start (step_pending step4)) (at start (hint_observed)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (doctor_given)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 4)
    :condition (and (at start (step_pending step5)) (at start (hint_observed)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (fireman_given)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step6)) (at start (policeman_given)) (at start (chef_given)) (at start (doctor_given)) (at start (fireman_given)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (object_dragged)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step7)) (at start (object_dragged)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (level_completed)))
  )
)