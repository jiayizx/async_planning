(define (domain snack_domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (walked_into_kitchen)
    (cupboard_opened)
    (items_looked_through)
    (decision_made)
    (food_reached)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (walked_into_kitchen)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (and (at start (step_pending ?s))
                    (at start (walked_into_kitchen)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (cupboard_opened)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s))
                    (at start (cupboard_opened)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (items_looked_through)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s))
                    (at start (cupboard_opened)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (decision_made)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 1)
    :condition (and (at start (step_pending ?s))
                    (at start (items_looked_through))
                    (at start (decision_made)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (food_reached)))
  )
)