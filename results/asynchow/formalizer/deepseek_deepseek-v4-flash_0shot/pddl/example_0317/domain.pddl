(define (domain cinnamon_french_toast)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (bread_chosen)
    (custard_created)
    (skillet_preheated)
    (bread_dipped)
    (toast_cooked)
    (slices_set)
    (syrup_ingredients_combined)
    (mixture_boiled)
    (heat_lowered)
    (syrup_cooled)
    (sandwich_made)
    (toast_served)
    (toast_with_ice_cream)
  )
  
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 5)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (bread_chosen)))
  )
  
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 5)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (custard_created)))
  )
  
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 5)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (skillet_preheated)))
  )
  
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step4))
                    (at start (bread_chosen))
                    (at start (custard_created)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (bread_dipped)))
  )
  
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 3)
    :condition (and (at start (step_pending step5))
                    (at start (skillet_preheated))
                    (at start (bread_dipped)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (toast_cooked)))
  )
  
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step6))
                    (at start (toast_cooked)))
    :effect (and (at start (not (step_pending step6)))
                 (at end (step_done step6))
                 (at end (slices_set)))
  )
  
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step7))
                    (at start (slices_set)))
    :effect (and (at start (not (step_pending step7)))
                 (at end (step_done step7))
                 (at end (syrup_ingredients_combined)))
  )
  
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step_pending step8))
                    (at start (syrup_ingredients_combined)))
    :effect (and (at start (not (step_pending step8)))
                 (at end (step_done step8))
                 (at end (mixture_boiled)))
  )
  
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step9))
                    (at start (mixture_boiled)))
    :effect (and (at start (not (step_pending step9)))
                 (at end (step_done step9))
                 (at end (heat_lowered)))
  )
  
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step10))
                    (at start (heat_lowered)))
    :effect (and (at start (not (step_pending step10)))
                 (at end (step_done step10))
                 (at end (syrup_cooled)))
  )
  
  (:durative-action do_step11
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step11))
                    (at start (sandwich_made)))
    :effect (and (at start (not (step_pending step11)))
                 (at end (step_done step11))
                 (at end (toast_served)))
  )
  
  (:durative-action do_step12
    :parameters ()
    :duration (= ?duration 4)
    :condition (and (at start (step_pending step12))
                    (at start (syrup_cooled)))
    :effect (and (at start (not (step_pending step12)))
                 (at end (step_done step12))
                 (at end (sandwich_made)))
  )
  
  (:durative-action do_step13
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step13))
                    (at start (sandwich_made)))
    :effect (and (at start (not (step_pending step13)))
                 (at end (step_done step13))
                 (at end (toast_with_ice_cream)))
  )
)
