(define (domain diagnose_patellar_luxation)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending)
    (step2_pending)
    (step3_pending)
    (step4_pending)
    (step1_done)
    (step2_done)
    (step3_done)
    (step4_done)
    (physical_exam_done)
    (xray_done)
    (management_done)
    (surgery_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (physical_exam_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step2_pending)) (at start (physical_exam_done)))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (xray_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 2419200)
    :condition (and (at start (step3_pending)) (at start (xray_done)))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (management_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 10800)
    :condition (and (at start (step4_pending)) (at start (xray_done)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (surgery_done)))
  )
)