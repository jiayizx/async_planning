(define (domain walk_to_door)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (door_located)
    (turned_toward)
    (left_leg_lifted)
    (right_leg_lifted)
    (left_leg_moved)
    (right_leg_moved)
    (walked_to_door)
  )
  (:durative-action locate_front_door
    :parameters ()
    :duration (= ?duration 3)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (door_located)))
  )
  (:durative-action turn_toward_door
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step2)) (at start (door_located)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (turned_toward)))
  )
  (:durative-action lift_left_leg
    :parameters ()
    :duration (= ?duration 1)
    :condition (and (at start (step_pending step3)) (at start (turned_toward)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (left_leg_lifted)))
  )
  (:durative-action lift_right_leg
    :parameters ()
    :duration (= ?duration 1)
    :condition (and (at start (step_pending step4)) (at start (turned_toward)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (right_leg_lifted)))
  )
  (:durative-action move_left_leg_forward
    :parameters ()
    :duration (= ?duration 1)
    :condition (and (at start (step_pending step5)) (at start (left_leg_lifted)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (left_leg_moved)))
  )
  (:durative-action move_right_leg_forward
    :parameters ()
    :duration (= ?duration 1)
    :condition (and (at start (step_pending step6)) (at start (right_leg_lifted)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (right_leg_moved)))
  )
  (:durative-action move_forward_until_door_reached
    :parameters ()
    :duration (= ?duration 6)
    :condition (and (at start (step_pending step7)) (at start (left_leg_moved)) (at start (right_leg_moved)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (walked_to_door)))
  )
)