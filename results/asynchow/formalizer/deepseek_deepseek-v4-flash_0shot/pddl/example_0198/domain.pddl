(define (domain diagnose_hamster)
  (:requirements :durative-actions)
  (:predicates (pending_step2) (pending_step3) (pending_step1)
               (done_step2) (done_step3) (done_step1)
               (s2_done) (s3_done) (diagnosis_done))
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 604800)
    :condition (at start (pending_step2))
    :effect (and (at start (not (pending_step2)))
                 (at end (done_step2))
                 (at end (s2_done))))
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (pending_step3))
    :effect (and (at start (not (pending_step3)))
                 (at end (done_step3))
                 (at end (s3_done))))
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (pending_step1))
                    (at start (s2_done))
                    (at start (s3_done)))
    :effect (and (at start (not (pending_step1)))
                 (at end (done_step1))
                 (at end (diagnosis_done))))
)