(define (domain wedding)
  (:requirements :durative-actions :typing)
  (:predicates
    (pending_step1) (pending_step2) (pending_step3) (pending_step4) (pending_step5) (pending_step6) (pending_step7)
    (step1_done) (step2_done) (step3_done) (step4_done) (step5_done) (step6_done) (step7_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (pending_step1))
    :effect (and (at start (not (pending_step1))) (at end (step1_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (pending_step2)) (at start (step5_done)))
    :effect (and (at start (not (pending_step2))) (at end (step2_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (pending_step3)) (at start (step2_done)))
    :effect (and (at start (not (pending_step3))) (at end (step3_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (pending_step4)) (at start (step3_done)))
    :effect (and (at start (not (pending_step4))) (at end (step4_done)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (pending_step5)) (at start (step1_done)) (at start (step6_done)) (at start (step7_done)))
    :effect (and (at start (not (pending_step5))) (at end (step5_done)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (pending_step6))
    :effect (and (at start (not (pending_step6))) (at end (step6_done)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (pending_step7))
    :effect (and (at start (not (pending_step7))) (at end (step7_done)))
  )
)