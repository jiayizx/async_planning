(define (domain field_trip)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 step4 step5 step6 step7 - step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (permission_obtained)
    (permission_slips_sent)
    (driver_scheduled)
    (schedule_created)
    (groups_organized)
    (bus_boarded)
    (headed_to_jamestown)
  )
  (:durative-action get_permission
    :parameters ()
    :duration (= ?duration 86400)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (permission_obtained)))
  )
  (:durative-action send_permission_slips
    :parameters ()
    :duration (= ?duration 86400)
    :condition (and (at start (step_pending step2)) (at start (permission_obtained)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (permission_slips_sent)))
  )
  (:durative-action schedule_driver
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step3)) (at start (permission_obtained)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (driver_scheduled)))
  )
  (:durative-action create_schedule
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step4)) (at start (permission_obtained)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (schedule_created)))
  )
  (:durative-action organize_groups
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step5)) (at start (permission_slips_sent)) (at start (driver_scheduled)) (at start (schedule_created)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (groups_organized)))
  )
  (:durative-action board_bus
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step6)) (at start (groups_organized)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (bus_boarded)))
  )
  (:durative-action head_to_jamestown
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step7)) (at start (bus_boarded)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (headed_to_jamestown)))
  )
)