(define (domain androgen_reduction)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending)
    (step2_pending)
    (step3_pending)
    (step4_pending)
    (tested_confirmed)
    (step1_done)
    (step2_done)
    (step3_done)
    (step4_done)
  )
  (:durative-action do_step1
    :duration (= ?duration 2)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (tested_confirmed)))
  )
  (:durative-action do_step2
    :duration (= ?duration 12)
    :condition (and (at start (step2_pending)) (at start (tested_confirmed)))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)))
  )
  (:durative-action do_step3
    :duration (= ?duration 24)
    :condition (and (at start (step3_pending)) (at start (tested_confirmed)))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)))
  )
  (:durative-action do_step4
    :duration (= ?duration 24)
    :condition (and (at start (step4_pending)) (at start (tested_confirmed)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)))
  )
)