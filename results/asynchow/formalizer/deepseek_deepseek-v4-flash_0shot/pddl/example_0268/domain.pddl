(define (domain make_signal_flare)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (mix_done)
    (light_done)
    (heat_done)
    (cool_done)
    (shape_done)
    (wrap_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 5)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (mix_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 2)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (light_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step3)) (at start (mix_done)) (at start (light_done)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (heat_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step4)) (at start (heat_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (cool_done)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step_pending step5)) (at start (cool_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (shape_done)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step6)) (at start (shape_done)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (wrap_done)))
  )
)