(define (domain find_neutrons)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (located_element)
    (atomic_number_found)
    (atomic_weight_found)
    (atomic_mass_rounded)
    (neutrons_calculated)
    (formula_remembered)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (located_element)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (located_element)))
    :effect (and (at start (not (step_pending ?s))) (at end (atomic_number_found)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (located_element)))
    :effect (and (at start (not (step_pending ?s))) (at end (atomic_weight_found)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (atomic_weight_found)))
    :effect (and (at start (not (step_pending ?s))) (at end (atomic_mass_rounded)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (atomic_number_found)) (at start (atomic_mass_rounded)))
    :effect (and (at start (not (step_pending ?s))) (at end (neutrons_calculated)))
  )
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (formula_remembered)))
  )
)