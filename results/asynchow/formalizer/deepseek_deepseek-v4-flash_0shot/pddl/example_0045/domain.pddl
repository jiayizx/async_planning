(define (domain travel_domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (purchase_done)
    (pack_done)
    (fill_food_done)
    (fill_gas_done)
    (set_out_done)
  )
  (:durative-action purchase_rv
    :parameters (?s - step)
    :duration (= ?duration 10800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (purchase_done)))
  )
  (:durative-action pack_belongings
    :parameters (?s - step)
    :duration (= ?duration 172800)
    :condition (and (at start (step_pending ?s))
                    (at start (purchase_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (pack_done)))
  )
  (:durative-action fill_food
    :parameters (?s - step)
    :duration (= ?duration 18000)
    :condition (and (at start (step_pending ?s))
                    (at start (pack_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (fill_food_done)))
  )
  (:durative-action fill_gas
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s))
                    (at start (pack_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (fill_gas_done)))
  )
  (:durative-action set_out
    :parameters (?s - step)
    :duration (= ?duration 180)
    :condition (and (at start (step_pending ?s))
                    (at start (fill_food_done))
                    (at start (fill_gas_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (set_out_done)))
  )
)