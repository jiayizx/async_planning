(define (domain fresh_milk)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (pending ?s - step)
    (done ?s - step)
    (drink_fresh_milk)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 5)
    :condition (at start (pending step1))
    :effect (and (at start (not (pending step1))) (at end (done step1)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (pending step2)) (at start (done step1)))
    :effect (and (at start (not (pending step2))) (at end (done step2)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (pending step3)) (at start (done step2)) (at start (done step6)))
    :effect (and (at start (not (pending step3))) (at end (done step3)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (pending step4)) (at start (done step3)))
    :effect (and (at start (not (pending step4))) (at end (done step4)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 5)
    :condition (at start (pending step5))
    :effect (and (at start (not (pending step5))) (at end (done step5)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (pending step6)) (at start (done step5)))
    :effect (and (at start (not (pending step6))) (at end (done step6)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (pending step7)) (at start (done step4)))
    :effect (and (at start (not (pending step7))) (at end (done step7)) (at end (drink_fresh_milk)))
  )
)