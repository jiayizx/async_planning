(define (domain drift_tuning)
  (:requirements :durative-actions :typing)
  (:predicates
    (pending1) (pending2) (pending3) (pending4) (pending5)
    (done1) (done2) (done3) (done4) (done5)
    (tuning_settings_set)
    (suspension_set)
    (drivetrain_set)
    (aero_set)
    (tire_brakes_set))
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (pending1))
    :effect (and (at start (not (pending1)))
                 (at end (done1))
                 (at end (tuning_settings_set))))
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (pending2))
                    (at start (tuning_settings_set)))
    :effect (and (at start (not (pending2)))
                 (at end (done2))
                 (at end (suspension_set))))
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (pending3))
                    (at start (tuning_settings_set)))
    :effect (and (at start (not (pending3)))
                 (at end (done3))
                 (at end (drivetrain_set))))
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (pending4))
                    (at start (tuning_settings_set)))
    :effect (and (at start (not (pending4)))
                 (at end (done4))
                 (at end (aero_set))))
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (pending5))
                    (at start (tuning_settings_set)))
    :effect (and (at start (not (pending5)))
                 (at end (done5))
                 (at end (tire_brakes_set))))
)