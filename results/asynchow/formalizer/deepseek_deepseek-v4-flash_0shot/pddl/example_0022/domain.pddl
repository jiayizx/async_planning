(define (domain lasagna)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (go_store_done)
    (buy_noodles_done)
    (buy_sauce_done)
    (go_home_done)
    (assemble_done)
    (preheat_done)
    (cover_done)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (go_store_done)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (go_store_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (buy_noodles_done)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (go_store_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (buy_sauce_done)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (buy_noodles_done)) (at start (buy_sauce_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (go_home_done)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending ?s)) (at start (go_home_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (assemble_done)))
  )
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 30)
    :condition (and (at start (step_pending ?s)) (at start (go_home_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (preheat_done)))
  )
  (:durative-action do_step7
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (go_home_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (cover_done)))
  )
)