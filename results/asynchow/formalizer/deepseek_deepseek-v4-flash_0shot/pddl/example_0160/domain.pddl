(define (domain bumped_flight)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 step4 - step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (gate_agent_spoken)
    (flight_confirmed)
    (cash_asked)
    (vouchers_asked)
  )
  (:durative-action do_speak
    :parameters ()
    :duration (= ?duration 10)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (gate_agent_spoken)))
  )
  (:durative-action do_confirm
    :parameters ()
    :duration (= ?duration 20)
    :condition (and (at start (step_pending step2)) (at start (gate_agent_spoken)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (flight_confirmed)))
  )
  (:durative-action do_ask_cash
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step3)) (at start (gate_agent_spoken)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (cash_asked)))
  )
  (:durative-action do_ask_vouchers
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step4)) (at start (gate_agent_spoken)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (vouchers_asked)))
  )
)
