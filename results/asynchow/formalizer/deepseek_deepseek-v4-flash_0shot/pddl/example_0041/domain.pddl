(define (domain amusement_park)
  (:requirements :durative-actions :typing :fluents)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (money_obtained)
    (park_found)
    (traveled)
    (pass_purchased)
    (entered)
  )
  (:durative-action do_get_money
    :parameters (?s - step)
    :duration (= ?duration 30)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (money_obtained)))
  )
  (:durative-action do_find_park
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (park_found)))
  )
  (:durative-action do_travel
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s)) (at start (park_found)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (traveled)))
  )
  (:durative-action do_purchase_pass
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (money_obtained)) (at start (traveled)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (pass_purchased)))
  )
  (:durative-action do_enter_park
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (pass_purchased)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (entered)))
  )
)
