(define (domain gym)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending)
    (step2_pending)
    (step3_pending)
    (step4_pending)
    (step5_pending)
    (step1_done)
    (step2_done)
    (step3_done)
    (step4_done)
    (step5_done)
    (internet_searched)
    (prices_compared)
    (compatible_hours_found)
    (gym_reached)
    (membership_obtained)
  )
  (:durative-action search_internet
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (internet_searched)))
  )
  (:durative-action compare_prices
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step2_pending)) (at start (internet_searched)))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (prices_compared)))
  )
  (:durative-action find_hours
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step3_pending)) (at start (internet_searched)))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (compatible_hours_found)))
  )
  (:durative-action drive_to_gym
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step4_pending)) (at start (prices_compared)) (at start (compatible_hours_found)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (gym_reached)))
  )
  (:durative-action get_membership
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step5_pending)) (at start (gym_reached)))
    :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (membership_obtained)))
  )
)