(define (domain film_knowledge)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 step4 step5 - step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (area_decided)
    (research_done)
    (library_done)
    (reading_done)
    (film_knowledge_gained)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (area_decided)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step2)) (at start (area_decided)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (research_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step3)) (at start (area_decided)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (library_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step4)) (at start (research_done)) (at start (library_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (reading_done)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step5)) (at start (reading_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (film_knowledge_gained)))
  )
)