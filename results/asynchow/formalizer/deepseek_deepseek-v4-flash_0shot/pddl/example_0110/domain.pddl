(define (domain baseball)
  (:requirements :durative-actions :typing)
  (:predicates
    (pending_step1)
    (pending_step2)
    (pending_step3)
    (pending_step4)
    (pending_step5)
    (pending_step6)
    (done_step1)
    (done_step2)
    (done_step3)
    (done_step4)
    (done_step5)
    (done_step6)
    (baseball_played)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (pending_step1))
    :effect (and (at start (not (pending_step1))) (at end (done_step1)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (pending_step2))
    :effect (and (at start (not (pending_step2))) (at end (done_step2)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (pending_step3)) (at start (done_step2)))
    :effect (and (at start (not (pending_step3))) (at end (done_step3)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (pending_step4)) (at start (done_step1)) (at start (done_step3)))
    :effect (and (at start (not (pending_step4))) (at end (done_step4)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (pending_step5)) (at start (done_step4)))
    :effect (and (at start (not (pending_step5))) (at end (done_step5)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (pending_step6)) (at start (done_step5)))
    :effect (and (at start (not (pending_step6))) (at end (done_step6)) (at end (baseball_played)))
  )
)