(define (domain remove_lead)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (accredited_lab_found)
    (water_samples_collected)
    (water_samples_tested))
  (:durative-action do_find_lab
    :parameters (?s - step)
    :duration (= ?duration 86400)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (accredited_lab_found))))
  (:durative-action do_collect_samples
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (water_samples_collected))))
  (:durative-action do_take_to_lab
    :parameters (?s - step)
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending ?s))
                    (at start (accredited_lab_found))
                    (at start (water_samples_collected)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (water_samples_tested))))
)