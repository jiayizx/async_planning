(define (domain coconut_oil_sugar_face_scrub)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (gathered)
    (sugar_added)
    (oil_added)
    (mixed)
    (applied)
    (rinsed)
    (dried)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 5)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (gathered)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 1)
    :condition (and (at start (step_pending step2)) (at start (gathered)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (sugar_added)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 1)
    :condition (and (at start (step_pending step3)) (at start (gathered)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (oil_added)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step4)) (at start (sugar_added)) (at start (oil_added)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (mixed)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step_pending step5)) (at start (mixed)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (applied)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 3)
    :condition (and (at start (step_pending step6)) (at start (applied)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (rinsed)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 3)
    :condition (and (at start (step_pending step7)) (at start (rinsed)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (dried)))
  )
)