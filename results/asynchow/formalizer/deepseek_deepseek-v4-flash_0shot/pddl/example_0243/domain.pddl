(define (domain sew_button)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (old_button_removed)
    (thread_found)
    (needle_threaded)
    (knot_tied)
    (fabric_marked)
  )
  (:durative-action do_remove_old_button
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (old_button_removed)))
  )
  (:durative-action do_find_thread
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (thread_found)))
  )
  (:durative-action do_thread_needle
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step3)) (at start (thread_found)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (needle_threaded)))
  )
  (:durative-action do_tie_knot
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step4)) (at start (needle_threaded)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (knot_tied)))
  )
  (:durative-action do_mark_fabric
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step5)) (at start (old_button_removed)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (fabric_marked)))
  )
)
