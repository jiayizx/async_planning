(define (domain save_for_vacation)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (budget_created)
    (work_more_done)
    (save_groceries_done)
    (reduce_alcohol_done)
    (stop_eating_out_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (budget_created)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 5184000)
    :condition (and (at start (step_pending step2)) (at start (budget_created)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (work_more_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 5184000)
    :condition (and (at start (step_pending step3)) (at start (budget_created)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (save_groceries_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 5184000)
    :condition (and (at start (step_pending step4)) (at start (budget_created)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (reduce_alcohol_done)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 5184000)
    :condition (and (at start (step_pending step5)) (at start (budget_created)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (stop_eating_out_done)))
  )
)