(define (domain whelp-domain)
  (:requirements :durative-actions :typing)
  (:predicates
    (step_pending_step1)
    (step_pending_step2)
    (step_pending_step3)
    (step_done_step1)
    (step_done_step2)
    (step_done_step3)
    (prepare_done)
    (line_done)
    (heat_lamp_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 30)
    :condition (at start (step_pending_step1))
    :effect (and (at start (not (step_pending_step1))) (at end (step_done_step1)) (at end (prepare_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 15)
    :condition (and (at start (step_pending_step2)) (at start (step_done_step1)))
    :effect (and (at start (not (step_pending_step2))) (at end (step_done_step2)) (at end (line_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending_step3)) (at start (step_done_step1)))
    :effect (and (at start (not (step_pending_step3))) (at end (step_done_step3)) (at end (heat_lamp_done)))
  )
)