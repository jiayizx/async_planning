(define (domain find_restaurant)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (phone_picked)
    (search_done)
    (narrowed)
    (menus_looked)
    (ratings_looked)
    (pricing_checked)
  )
  (:durative-action pickup_phone
    :parameters (?s - step)
    :duration (= ?duration 1)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (phone_picked)))
  )
  (:durative-action search_restaurants
    :parameters (?s - step)
    :duration (= ?duration 20)
    :condition (and (at start (step_pending ?s))
                    (at start (phone_picked)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (search_done)))
  )
  (:durative-action narrow_options
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s))
                    (at start (search_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (narrowed)))
  )
  (:durative-action look_menus
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s))
                    (at start (narrowed)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (menus_looked)))
  )
  (:durative-action look_ratings
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s))
                    (at start (narrowed)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (ratings_looked)))
  )
  (:durative-action look_pricing
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s))
                    (at start (menus_looked))
                    (at start (ratings_looked)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (pricing_checked)))
  )
)