(define (domain concert)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending)
    (step1_done)
    (step2_pending)
    (step2_done)
    (step3_pending)
    (step3_done)
    (step4_pending)
    (step4_done)
    (step5_pending)
    (step5_done)
    (step6_pending)
    (step6_done)
    (tickets_bought)
    (dressed)
    (hair_styled)
    (makeup_done)
    (directions_obtained)
    (drove_to_concert)
  )
  (:durative-action do-step1
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (tickets_bought)))
  )
  (:durative-action do-step2
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step2_pending)) (at start (tickets_bought)))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (dressed)))
  )
  (:durative-action do-step3
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step3_pending)) (at start (dressed)))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (hair_styled)))
  )
  (:durative-action do-step4
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step4_pending)) (at start (dressed)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (makeup_done)))
  )
  (:durative-action do-step5
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step5_pending)) (at start (hair_styled)) (at start (makeup_done)))
    :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (directions_obtained)))
  )
  (:durative-action do-step6
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step6_pending)) (at start (directions_obtained)))
    :effect (and (at start (not (step6_pending))) (at end (step6_done)) (at end (drove_to_concert)))
  )
)