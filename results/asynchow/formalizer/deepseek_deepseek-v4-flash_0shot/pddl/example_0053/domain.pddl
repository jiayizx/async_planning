(define (domain nature)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
              (step_done ?s - step)
              (took_week_off)
              (drove_to_park)
              (hiked_out)
              (lived_off_land)
              (stayed_away_electronics))
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 604800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (took_week_off))))
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 10800)
    :condition (and (at start (step_pending ?s))
                    (at start (took_week_off)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (drove_to_park))))
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending ?s))
                    (at start (drove_to_park)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (hiked_out))))
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending ?s))
                    (at start (hiked_out)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (lived_off_land))))
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending ?s))
                    (at start (hiked_out)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (stayed_away_electronics))))
)