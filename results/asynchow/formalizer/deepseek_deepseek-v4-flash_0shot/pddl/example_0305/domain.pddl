(define (domain learn_digital_art)
  (:requirements :durative-actions)
  (:predicates
    (choose_computer_done)
    (download_gimp_done)
    (consider_corel_done)
    (choose_clip_done)
    (pay_photoshop_done)
  )
  (:durative-action do_choose_computer
    :parameters ()
    :duration (= ?duration 15)
    :effect (at end (choose_computer_done))
  )
  (:durative-action do_download_gimp
    :parameters ()
    :duration (= ?duration 30)
    :condition (at start (choose_computer_done))
    :effect (at end (download_gimp_done))
  )
  (:durative-action do_consider_corel
    :parameters ()
    :duration (= ?duration 30)
    :condition (at start (choose_computer_done))
    :effect (at end (consider_corel_done))
  )
  (:durative-action do_choose_clip
    :parameters ()
    :duration (= ?duration 20)
    :condition (at start (choose_computer_done))
    :effect (at end (choose_clip_done))
  )
  (:durative-action do_pay_photoshop
    :parameters ()
    :duration (= ?duration 20)
    :condition (at start (choose_computer_done))
    :effect (at end (pay_photoshop_done))
  )
)