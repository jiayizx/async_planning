(define (domain choose_cruise)
  (:requirements :durative-actions :typing)
  (:predicates 
    (step1_pending)
    (step1_done)
    (step2_pending)
    (step2_done)
    (step3_pending)
    (step3_done)
    (cost_calculated)
    (acknowledged)
    (budget_stuck)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step1_pending)) (at start (cost_calculated)) (at start (acknowledged)))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (budget_stuck)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (step2_pending))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (cost_calculated)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (step3_pending))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (acknowledged)))
  )
)