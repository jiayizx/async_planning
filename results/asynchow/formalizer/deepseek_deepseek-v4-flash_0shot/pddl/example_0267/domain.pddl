(define (domain ear_reflexology)
  (:requirements :durative-actions :typing :numeric-fluents)
  (:predicates
    (step1_pending)
    (step2_pending)
    (step3_pending)
    (step4_pending)
    (step5_pending)
    (step1_complete)
    (step2_complete)
    (step3_complete)
    (step4_complete)
    (step5_complete)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 15)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_complete)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step2_pending)) (at start (step1_complete)))
    :effect (and (at start (not (step2_pending))) (at end (step2_complete)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step3_pending)) (at start (step1_complete)))
    :effect (and (at start (not (step3_pending))) (at end (step3_complete)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step4_pending)) (at start (step1_complete)))
    :effect (and (at start (not (step4_pending))) (at end (step4_complete)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step5_pending)) (at start (step1_complete)))
    :effect (and (at start (not (step5_pending))) (at end (step5_complete)))
  )
)