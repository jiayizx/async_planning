(define (domain use-watch-as-compass)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_done ?s - step)
    (s1_pending)
    (s1_complete)
    (s2_pending)
    (s2_complete)
    (s3_pending)
    (s3_complete)
    (s4_pending)
    (s4_complete)
    (s5_pending)
    (s5_complete)
    (s6_pending)
    (s6_complete)
    (s7_pending)
    (s7_complete)
    (s8_pending)
    (s8_complete)
  )
  (:durative-action do-step1
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (s1_pending)) (at start (s6_complete)))
    :effect (and (at start (not (s1_pending))) (at end (s1_complete)) (at end (step_done step1)))
  )
  (:durative-action do-step2
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (s2_pending)) (at start (s1_complete)))
    :effect (and (at start (not (s2_pending))) (at end (s2_complete)) (at end (step_done step2)))
  )
  (:durative-action do-step3
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (s3_pending)) (at start (s2_complete)))
    :effect (and (at start (not (s3_pending))) (at end (s3_complete)) (at end (step_done step3)))
  )
  (:durative-action do-step4
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (s4_pending)) (at start (s7_complete)) (at start (s8_complete)))
    :effect (and (at start (not (s4_pending))) (at end (s4_complete)) (at end (step_done step4)))
  )
  (:durative-action do-step5
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (s5_pending)) (at start (s4_complete)))
    :effect (and (at start (not (s5_pending))) (at end (s5_complete)) (at end (step_done step5)))
  )
  (:durative-action do-step6
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (s6_pending)) (at start (s5_complete)))
    :effect (and (at start (not (s6_pending))) (at end (s6_complete)) (at end (step_done step6)))
  )
  (:durative-action do-step7
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (s7_pending))
    :effect (and (at start (not (s7_pending))) (at end (s7_complete)) (at end (step_done step7)))
  )
  (:durative-action do-step8
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (s8_pending))
    :effect (and (at start (not (s8_pending))) (at end (s8_complete)) (at end (step_done step8)))
  )
)