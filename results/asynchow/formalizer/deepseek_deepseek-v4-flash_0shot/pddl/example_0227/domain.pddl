(define (domain season_tilapia)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 step4 step5 - step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (butter_melted)
    (lemon_prepared)
    (sauce_whisked)
    (sauce_poured)
    (fish_baked)
  )
  (:durative-action do_melt_butter
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (butter_melted)))
  )
  (:durative-action do_zest_lemon
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (lemon_prepared)))
  )
  (:durative-action do_whisk
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step3)) (at start (butter_melted)) (at start (lemon_prepared)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (sauce_whisked)))
  )
  (:durative-action do_pour
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step4)) (at start (sauce_whisked)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (sauce_poured)))
  )
  (:durative-action do_bake
    :parameters ()
    :duration (= ?duration 720)
    :condition (and (at start (step_pending step5)) (at start (sauce_poured)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (fish_baked)))
  )
)