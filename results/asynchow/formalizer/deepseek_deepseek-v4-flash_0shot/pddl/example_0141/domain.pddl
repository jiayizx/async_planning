(define (domain cherry_tree_pruning)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (shears_sterilized)
    (tree_measured)
    (tree_pruned)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 15)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (shears_sterilized)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (tree_measured)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 30)
    :condition (and (at start (step_pending ?s)) (at start (shears_sterilized)) (at start (tree_measured)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (tree_pruned)))
  )
)