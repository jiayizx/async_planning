(define (domain use_sumac)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (purchased)
    (used_in_dish)
    (added_to_dips)
    (used_as_marinade)
    (added_to_zaatar)
    (added_to_frittata)
    (sprinkled)
  )
  (:durative-action purchase_sumac
    :duration (duration 30)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (purchased)))
  )
  (:durative-action use_sumac_in_dish
    :duration (duration 5)
    :condition (and (at start (step_pending step2)) (at start (purchased)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (used_in_dish)))
  )
  (:durative-action add_to_dips
    :duration (duration 3)
    :condition (and (at start (step_pending step3)) (at start (purchased)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (added_to_dips)))
  )
  (:durative-action use_as_marinade
    :duration (duration 10)
    :condition (and (at start (step_pending step4)) (at start (purchased)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (used_as_marinade)))
  )
  (:durative-action add_to_zaatar
    :duration (duration 3)
    :condition (and (at start (step_pending step5)) (at start (purchased)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (added_to_zaatar)))
  )
  (:durative-action add_to_frittata
    :duration (duration 8)
    :condition (and (at start (step_pending step6)) (at start (purchased)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (added_to_frittata)))
  )
  (:durative-action sprinkle_over_vegetables
    :duration (duration 3)
    :condition (and (at start (step_pending step7)) (at start (purchased)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (sprinkled)))
  )
)