(define (domain sculpt_concrete)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (cut_mesh_done)
    (wrap_mesh_done)
    (mix_concrete_done)
    (apply_concrete_done)
    (let_concrete_dry_done)
  )
  (:durative-action cut_mesh
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (cut_mesh_done)))
  )
  (:durative-action wrap_mesh
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step2))
                    (at start (cut_mesh_done)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (wrap_mesh_done)))
  )
  (:durative-action mix_concrete
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (mix_concrete_done)))
  )
  (:durative-action apply_concrete
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending step4))
                    (at start (wrap_mesh_done))
                    (at start (mix_concrete_done)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (apply_concrete_done)))
  )
  (:durative-action let_concrete_dry
    :parameters ()
    :duration (= ?duration 86400)
    :condition (and (at start (step_pending step5))
                    (at start (apply_concrete_done)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (let_concrete_dry_done)))
  )
)