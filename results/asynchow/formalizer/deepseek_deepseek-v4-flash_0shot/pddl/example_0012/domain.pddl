(define (domain diet-domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (recs_obtained)
    (diets_looked_up)
    (diets_compared)
    (doc_consulted)
    (commitment_made)
  )
  (:durative-action do_recs
    :parameters ()
    :duration (= ?duration 10800)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (recs_obtained)))
  )
  (:durative-action do_lookup
    :parameters ()
    :duration (= ?duration 18000)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (diets_looked_up)))
  )
  (:durative-action do_compare
    :parameters ()
    :duration (= ?duration 10800)
    :condition (at start (step_pending step4))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (diets_compared)))
  )
  (:durative-action do_doctor
    :parameters ()
    :duration (= ?duration 10800)
    :condition (at start (step_pending step5))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (doc_consulted)))
  )
  (:durative-action do_commit
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step3)) (at start (recs_obtained)) (at start (diets_looked_up)) (at start (diets_compared)) (at start (doc_consulted)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (commitment_made)))
  )
)
