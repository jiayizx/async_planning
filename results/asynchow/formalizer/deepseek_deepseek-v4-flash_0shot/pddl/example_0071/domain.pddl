(define (domain purchase_soil_domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (wallet_grabbed)
    (keys_grabbed)
    (house_exited)
    (car_gotten)
    (store_reached)
  )
  (:durative-action do_grab_wallet
    :parameters ()
    :duration (= ?duration 30)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (wallet_grabbed)))
  )
  (:durative-action do_grab_keys
    :parameters ()
    :duration (= ?duration 20)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (keys_grabbed)))
  )
  (:durative-action do_exit_house
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step3)) (at start (wallet_grabbed)) (at start (keys_grabbed)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (house_exited)))
  )
  (:durative-action do_get_in_car
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step4)) (at start (house_exited)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (car_gotten)))
  )
  (:durative-action do_drive_to_store
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step5)) (at start (car_gotten)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (store_reached)))
  )
)