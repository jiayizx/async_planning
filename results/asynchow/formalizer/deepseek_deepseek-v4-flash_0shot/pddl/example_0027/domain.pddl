(define (domain wait_for_bus)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (destination_thought)
    (bus_looked_up)
    (bus_stop_mapped)
    (bus_stop_walked)
    (bus_pass_bought)
    (bus_pass_collected)
    (bus_on_time_checked)
  )
  (:durative-action think_destination
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (destination_thought)))
  )
  (:durative-action lookup_bus
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (destination_thought)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (bus_looked_up)))
  )
  (:durative-action map_bus_stop
    :parameters (?s - step)
    :duration (= ?duration 180)
    :condition (and (at start (step_pending ?s)) (at start (bus_looked_up)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (bus_stop_mapped)))
  )
  (:durative-action walk_to_bus_stop
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (bus_stop_mapped)) (at start (bus_pass_collected)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (bus_stop_walked)))
  )
  (:durative-action buy_bus_pass
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (bus_pass_bought)))
  )
  (:durative-action collect_bus_pass
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (bus_pass_bought)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (bus_pass_collected)))
  )
  (:durative-action check_bus_on_time
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (bus_stop_walked)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (bus_on_time_checked)))
  )
)