(define (domain add_large_animal)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (call_done)
    (drive_done)
    (paperwork_done)
    (area_done)
    (receive_done)
  )
  (:durative-action do_call
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (call_done)))
  )
  (:durative-action do_drive
    :parameters (?s - step)
    :duration (= ?duration 2100)
    :condition (and (at start (step_pending ?s)) (at start (call_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (drive_done)))
  )
  (:durative-action do_paperwork
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (drive_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (paperwork_done)))
  )
  (:durative-action do_area
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s)) (at start (drive_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (area_done)))
  )
  (:durative-action do_receive
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s)) (at start (paperwork_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (receive_done)))
  )
)