(define (domain coffee_grounds)
  (:requirements :durative-actions)
  (:predicates
    (step1_pending)
    (step2_pending)
    (step3_pending)
    (step4_pending)
    (step5_pending)
    (step1_done)
    (step2_done)
    (step3_done)
    (step4_done)
    (step5_done)
    (grounds_added_to_compost)
    (soil_acidity_increased)
    (ph_balanced)
    (nutrients_added)
    (liquid_plant_food_made)
  )
  (:durative-action step1
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending)))
                 (at end (step1_done))
                 (at end (grounds_added_to_compost)))
  )
  (:durative-action step2
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step2_pending))
    :effect (and (at start (not (step2_pending)))
                 (at end (step2_done))
                 (at end (soil_acidity_increased)))
  )
  (:durative-action step3
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step3_pending)) (at start (soil_acidity_increased)))
    :effect (and (at start (not (step3_pending)))
                 (at end (step3_done))
                 (at end (ph_balanced)))
  )
  (:durative-action step4
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (step4_pending))
    :effect (and (at start (not (step4_pending)))
                 (at end (step4_done))
                 (at end (nutrients_added)))
  )
  (:durative-action step5
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (step5_pending))
    :effect (and (at start (not (step5_pending)))
                 (at end (step5_done))
                 (at end (liquid_plant_food_made)))
  )
)