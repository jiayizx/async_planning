(define (domain screenshot)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (l_held)
    (r_held)
    (picture_taken)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (l_held)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (r_held)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 25)
    :condition (and (at start (step_pending ?s))
                    (at start (l_held))
                    (at start (r_held)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (picture_taken)))
  )
)