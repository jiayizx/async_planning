(define (domain make_den)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (pending ?s - step)
              (step_done ?s - step)
              (materials_found)
              (case_made)
              (item_cut)
              (sewn)
              (den_ready))
  (:constants step1 step2 step3 step4 step5 - step)
  (:durative-action do_find_materials
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (pending step1))
    :effect (and (at start (not (pending step1))) (at end (step_done step1)) (at end (materials_found))))
  (:durative-action do_make_case
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (pending step2)) (at start (materials_found)))
    :effect (and (at start (not (pending step2))) (at end (step_done step2)) (at end (case_made))))
  (:durative-action do_cut_item
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (pending step3)) (at start (materials_found)))
    :effect (and (at start (not (pending step3))) (at end (step_done step3)) (at end (item_cut))))
  (:durative-action do_sew
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (pending step4)) (at start (case_made)) (at start (item_cut)))
    :effect (and (at start (not (pending step4))) (at end (step_done step4)) (at end (sewn))))
  (:durative-action do_get_used
    :parameters ()
    :duration (= ?duration 1209600)
    :condition (and (at start (pending step5)) (at start (sewn)))
    :effect (and (at start (not (pending step5))) (at end (step_done step5)) (at end (den_ready))))
)