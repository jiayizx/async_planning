(define (domain chicken_tenders)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (is_step1 ?s - step)
    (is_step2 ?s - step)
    (is_step3 ?s - step)
    (is_step4 ?s - step)
    (is_step5 ?s - step)
    (is_step6 ?s - step)
    (taken_nuggets)
    (oven_preheated)
    (pan_gotten)
    (tinfoil_laid)
    (nuggets_arranged)
    (cooked)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (and (at start (step_pending ?s)) (at start (is_step1 ?s)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (taken_nuggets)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (is_step2 ?s)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (oven_preheated)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (and (at start (step_pending ?s)) (at start (is_step3 ?s)) (at start (taken_nuggets)) (at start (oven_preheated)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (pan_gotten)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (and (at start (step_pending ?s)) (at start (is_step4 ?s)) (at start (pan_gotten)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (tinfoil_laid)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (is_step5 ?s)) (at start (tinfoil_laid)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (nuggets_arranged)))
  )
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (is_step6 ?s)) (at start (nuggets_arranged)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (cooked)))
  )
)