(define (domain buy_fishing_rod)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (note_made)
    (pay_done)
    (receipt_stored)
  )
  (:durative-action do_make_note
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (note_made)))
  )
  (:durative-action do_pay
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (pay_done)))
  )
  (:durative-action do_store_receipt
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s))
                    (at start (pay_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (receipt_stored)))
  )
)