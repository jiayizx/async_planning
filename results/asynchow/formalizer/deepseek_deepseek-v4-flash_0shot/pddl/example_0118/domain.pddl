(define (domain app_development)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (idea_ready)
    (functions_planned)
    (logistics_planned)
    (code_written)
    (app_made)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 30)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (idea_ready)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step2)) (at start (idea_ready)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (functions_planned)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending step3)) (at start (idea_ready)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (logistics_planned)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 432000)
    :condition (and (at start (step_pending step4)) (at start (functions_planned)) (at start (logistics_planned)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (code_written)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending step5)) (at start (code_written)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (app_made)))
  )
)