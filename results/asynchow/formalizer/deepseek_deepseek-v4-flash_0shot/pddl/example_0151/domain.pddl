(define (domain buy_firearms_brazil)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (documents_prepared_2_done)
    (documents_prepared_3_done)
    (application_filled_done)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s)) (at start (documents_prepared_2_done)) (at start (documents_prepared_3_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (application_filled_done)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (documents_prepared_2_done)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (documents_prepared_3_done)))
  )
)