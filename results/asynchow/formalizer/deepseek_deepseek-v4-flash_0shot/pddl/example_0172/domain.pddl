(define (domain peel_papaya)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (papaya_sliced)
    (seeds_removed)
    (wedges_created)
    (papaya_peeled)
  )
  (:durative-action do_slice
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (papaya_sliced)))
  )
  (:durative-action do_remove_seeds
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s))
                    (at start (papaya_sliced)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (seeds_removed)))
  )
  (:durative-action do_slice_wedges
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s))
                    (at start (papaya_sliced)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (wedges_created)))
  )
  (:durative-action do_peel_skin
    :parameters (?s - step)
    :duration (= ?duration 180)
    :condition (and (at start (step_pending ?s))
                    (at start (wedges_created)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (papaya_peeled)))
  )
)