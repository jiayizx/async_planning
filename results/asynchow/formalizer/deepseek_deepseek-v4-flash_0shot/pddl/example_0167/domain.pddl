(define (domain clean_bathtub)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (mixed)
    (rubbed)
    (rinsed)
    (weekly_cleaned)
  )
  (:durative-action do_mix
    :parameters ()
    :duration (= ?duration 5)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (mixed)))
  )
  (:durative-action do_rub
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step2)) (at start (mixed)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (rubbed)))
  )
  (:durative-action do_rinse
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step_pending step3)) (at start (rubbed)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (rinsed)))
  )
  (:durative-action do_clean_weekly
    :parameters ()
    :duration (= ?duration 30)
    :condition (at start (step_pending step4))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (weekly_cleaned)))
  )
)