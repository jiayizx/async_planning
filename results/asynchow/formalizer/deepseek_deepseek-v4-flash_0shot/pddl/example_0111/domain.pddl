(define (domain haunted_house)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (go_done)
    (buy_done)
    (design_done)
    (get_done)
    (look_done)
  )
  (:durative-action go_to_store
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (go_done)))
  )
  (:durative-action buy_scary_supplies
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step2)) (at start (look_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (buy_done)))
  )
  (:durative-action design_layout
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (design_done)))
  )
  (:durative-action get_nails_hammer
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step4)) (at start (design_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (get_done)))
  )
  (:durative-action look_for_supplies
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step5)) (at start (go_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (look_done)))
  )
)