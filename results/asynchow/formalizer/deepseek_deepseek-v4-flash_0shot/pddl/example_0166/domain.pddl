(define (domain baby_breath_crown)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (choose_done)
    (trim_done)
    (tape_done)
    (circle_done)
  )
  (:durative-action do_choose
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (choose_done)))
  )
  (:durative-action do_trim
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (choose_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (trim_done)))
  )
  (:durative-action do_circle
    :parameters (?s - step)
    :duration (= ?duration 240)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (circle_done)))
  )
  (:durative-action do_tape
    :parameters (?s - step)
    :duration (= ?duration 180)
    :condition (and (at start (step_pending ?s)) (at start (trim_done)) (at start (circle_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (tape_done)))
  )
)
