(define (domain reference_check)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 - step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (intro_done)
    (reliable_done)
    (positive_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (intro_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step2)) (at start (intro_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (reliable_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step3)) (at start (intro_done)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (positive_done)))
  )
)