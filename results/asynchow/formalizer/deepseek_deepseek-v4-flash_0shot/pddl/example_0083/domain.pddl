(define (domain metal-symphony)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (plug_done)
    (pick_paper_done)
    (pen_riff_done)
    (revise_done)
    (pick_pen_done)
    (turn_on_amp_done)
    (come_up_riff_done)
  )
  (:durative-action do_plug
    :parameters (?s - step)
    :duration (= ?duration 35)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (plug_done)))
  )
  (:durative-action do_pick_paper
    :parameters (?s - step)
    :duration (= ?duration 35)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (pick_paper_done)))
  )
  (:durative-action do_pen_riff
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s)) (at start (pick_paper_done)) (at start (pick_pen_done)) (at start (come_up_riff_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (pen_riff_done)))
  )
  (:durative-action do_revise
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s)) (at start (pen_riff_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (revise_done)))
  )
  (:durative-action do_pick_pen
    :parameters (?s - step)
    :duration (= ?duration 35)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (pick_pen_done)))
  )
  (:durative-action do_turn_on_amp
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (and (at start (step_pending ?s)) (at start (plug_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (turn_on_amp_done)))
  )
  (:durative-action do_come_up_riff
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s)) (at start (turn_on_amp_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (come_up_riff_done)))
  )
)