(define (domain cook_ground_turkey)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (mix_done)
    (shape_done)
    (heat_done)
    (cook_done)
    (serve_done)
  )
  (:durative-action do_mix
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (mix_done)))
  )
  (:durative-action do_shape
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step2)) (at start (mix_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (shape_done)))
  )
  (:durative-action do_heat
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (heat_done)))
  )
  (:durative-action do_cook
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step4)) (at start (shape_done)) (at start (heat_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (cook_done)))
  )
  (:durative-action do_serve
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step5)) (at start (cook_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (serve_done)))
  )
)