(define (domain build_snowman)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 step4 step5 step6 step7 - step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (decide_done)
    (gloves_done)
    (boots_done)
    (coat_done)
    (hat_done)
    (walk_done)
    (roll_done)
  )
  (:durative-action do_decide
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (decide_done)))
  )
  (:durative-action do_gloves
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step2))
                    (at start (decide_done)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (gloves_done)))
  )
  (:durative-action do_boots
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step3))
                    (at start (decide_done)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (boots_done)))
  )
  (:durative-action do_coat
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step4))
                    (at start (decide_done)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (coat_done)))
  )
  (:durative-action do_hat
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step5))
                    (at start (decide_done)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (hat_done)))
  )
  (:durative-action do_walk
    :parameters ()
    :duration (= ?duration 20)
    :condition (and (at start (step_pending step6))
                    (at start (gloves_done))
                    (at start (boots_done))
                    (at start (coat_done))
                    (at start (hat_done)))
    :effect (and (at start (not (step_pending step6)))
                 (at end (step_done step6))
                 (at end (walk_done)))
  )
  (:durative-action do_roll
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending step7))
                    (at start (walk_done)))
    :effect (and (at start (not (step_pending step7)))
                 (at end (step_done step7))
                 (at end (roll_done)))
  )
)