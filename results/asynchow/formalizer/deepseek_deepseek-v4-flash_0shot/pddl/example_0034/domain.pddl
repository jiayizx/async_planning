(define (domain impress)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (girl_impressed)
  )
  (:durative-action do_look_wardrobe ()
    :duration (= ?duration 900)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)))
  )
  (:durative-action do_look_up_pickup_lines ()
    :duration (= ?duration 900)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)))
  )
  (:durative-action do_memorize_pickup_lines ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step3)) (at start (step_done step2)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)))
  )
  (:durative-action do_look_in_mirror ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step4)) (at start (step_done step3)) (at start (step_done step5)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)))
  )
  (:durative-action do_put_together_outfit ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step5)) (at start (step_done step1)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)))
  )
  (:durative-action do_walk_to_school ()
    :duration (= ?duration 1500)
    :condition (and (at start (step_pending step6)) (at start (step_done step4)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)))
  )
  (:durative-action do_talk_to_girl ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step7)) (at start (step_done step6)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (girl_impressed)))
  )
)