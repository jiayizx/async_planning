(define (domain graduation)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (invitation_received)
    (gift_prepared)
    (directions_obtained)
    (dressed_up)
    (arrived_at_venue)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 604800)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (invitation_received)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step2)) (at start (invitation_received)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (gift_prepared)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step3)) (at start (invitation_received)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (directions_obtained)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step4)) (at start (directions_obtained)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (dressed_up)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step5)) (at start (dressed_up)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (arrived_at_venue)))
  )
)
