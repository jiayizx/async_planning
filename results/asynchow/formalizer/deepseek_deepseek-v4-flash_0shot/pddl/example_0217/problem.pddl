(define (problem operate_nest_thermostat_problem)
  (:domain operate_nest_thermostat)
  (:init
    (step_pending step1)
    (step_pending step2)
    (step_pending step3)
    (step_pending step4)
    (step_pending step5)
  )
  (:goal (and
    (step_done step1)
    (step_done step2)
    (step_done step3)
    (step_done step4)
    (step_done step5)
    (s5_done)
  ))
  (:metric minimize (total-time))
)