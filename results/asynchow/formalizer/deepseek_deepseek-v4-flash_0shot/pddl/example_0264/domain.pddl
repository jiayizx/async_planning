(define (domain berry_poutine)
  (:requirements :durative-actions)
  (:predicates
    (step1_pending)
    (step1_done)
    (step2_pending)
    (step2_done)
    (step3_pending)
    (step3_done)
    (step4_pending)
    (step4_done)
    (step5_pending)
    (step5_done)
    (step6_pending)
    (step6_done)
    (preheat_done)
    (arrange_done)
    (make_cake_done)
    (pour_done)
    (bake_done)
    (serve_done)
  )
  (:durative-action preheat_oven
    :duration (= ?duration 10)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (preheat_done)))
  )
  (:durative-action arrange_berries
    :duration (= ?duration 5)
    :condition (at start (step2_pending))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (arrange_done)))
  )
  (:durative-action make_cake_part
    :duration (= ?duration 15)
    :condition (at start (step3_pending))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (make_cake_done)))
  )
  (:durative-action pour_mixture
    :duration (= ?duration 2)
    :condition (and (at start (step4_pending)) (at start (arrange_done)) (at start (make_cake_done)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (pour_done)))
  )
  (:durative-action place_in_oven
    :duration (= ?duration 30)
    :condition (and (at start (step5_pending)) (at start (preheat_done)) (at start (pour_done)))
    :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (bake_done)))
  )
  (:durative-action remove_and_serve
    :duration (= ?duration 2)
    :condition (and (at start (step6_pending)) (at start (bake_done)))
    :effect (and (at start (not (step6_pending))) (at end (step6_done)) (at end (serve_done)))
  )
)