(define (domain get_in_car)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (shirt_on)
    (pants_on)
    (right_sock_on)
    (left_sock_on)
    (right_shoe_on)
    (left_shoe_on)
    (keys_obtained)
  )
  (:durative-action put_on_shirt
    :parameters ()
    :duration (= ?duration 10)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (shirt_on)))
  )
  (:durative-action put_on_pants
    :parameters ()
    :duration (= ?duration 15)
    :condition (and (at start (step_pending step2)) (at start (shirt_on)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (pants_on)))
  )
  (:durative-action put_on_right_sock
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step3)) (at start (pants_on)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (right_sock_on)))
  )
  (:durative-action put_on_left_sock
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step4)) (at start (pants_on)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (left_sock_on)))
  )
  (:durative-action put_on_right_shoe
    :parameters ()
    :duration (= ?duration 25)
    :condition (and (at start (step_pending step5)) (at start (right_sock_on)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (right_shoe_on)))
  )
  (:durative-action put_on_left_shoe
    :parameters ()
    :duration (= ?duration 25)
    :condition (and (at start (step_pending step6)) (at start (left_sock_on)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (left_shoe_on)))
  )
  (:durative-action get_car_keys
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step7)) (at start (right_shoe_on)) (at start (left_shoe_on)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (keys_obtained)))
  )
)