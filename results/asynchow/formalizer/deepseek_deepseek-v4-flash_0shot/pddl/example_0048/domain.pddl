(define (domain grill)
  (:requirements :durative-actions :typing)
  (:predicates
    (grill_pending)
    (charcoal_pending)
    (patties_pending)
    (cook_pending)
    (bun_pending)
    (grill_lit)
    (charcoal_warmed)
    (patties_made)
    (burgers_cooked)
    (buns_on)
  )
  (:durative-action light_grill
    :duration (= ?duration 180)
    :condition (at start (grill_pending))
    :effect (and (at start (not (grill_pending))) (at end (grill_lit)))
  )
  (:durative-action warm_charcoal
    :duration (= ?duration 1200)
    :condition (and (at start (charcoal_pending)) (at start (grill_lit)))
    :effect (and (at start (not (charcoal_pending))) (at end (charcoal_warmed)))
  )
  (:durative-action make_patties
    :duration (= ?duration 300)
    :condition (and (at start (patties_pending)) (at start (grill_lit)))
    :effect (and (at start (not (patties_pending))) (at end (patties_made)))
  )
  (:durative-action cook_burgers
    :duration (= ?duration 900)
    :condition (and (at start (cook_pending)) (at start (charcoal_warmed)) (at start (patties_made)))
    :effect (and (at start (not (cook_pending))) (at end (burgers_cooked)))
  )
  (:durative-action put_bun
    :duration (= ?duration 300)
    :condition (and (at start (bun_pending)) (at start (burgers_cooked)))
    :effect (and (at start (not (bun_pending))) (at end (buns_on)))
  )
)