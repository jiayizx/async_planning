(define (domain skincare)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (wash_done)
    (moisturize_done)
    (remove_makeup_done)
    (refresh_done)
  )
  (:durative-action do_wash
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step1)) (at start (remove_makeup_done)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (wash_done)))
  )
  (:durative-action do_moisturize
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step2)) (at start (wash_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (moisturize_done)))
  )
  (:durative-action do_remove_makeup
    :parameters (?s - step)
    :duration (= ?duration 180)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (remove_makeup_done)))
  )
  (:durative-action do_refresh
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (at start (step_pending step4))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (refresh_done)))
  )
)
