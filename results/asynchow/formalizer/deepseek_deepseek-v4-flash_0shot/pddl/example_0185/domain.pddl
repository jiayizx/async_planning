(define (domain hedgehog_care)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (symptoms_recognized)
    (vet_found)
    (diagnosis_obtained)
    (care_plan_discussed)
  )
  (:durative-action recognize_symptoms
    :parameters (?s - step)
    :duration (= ?duration 86400)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (symptoms_recognized)))
  )
  (:durative-action find_vet
    :parameters (?s - step)
    :duration (= ?duration 172800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (vet_found)))
  )
  (:durative-action get_diagnosis
    :parameters (?s - step)
    :duration (= ?duration 1209600)
    :condition (and (at start (step_pending ?s))
                    (at start (symptoms_recognized))
                    (at start (vet_found)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (diagnosis_obtained)))
  )
  (:durative-action discuss_care_plan
    :parameters (?s - step)
    :duration (= ?duration 172800)
    :condition (and (at start (step_pending ?s))
                    (at start (diagnosis_obtained)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (care_plan_discussed)))
  )
)