(define (domain party)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending) (step1_done)
    (step2_pending) (step2_done)
    (step3_pending) (step3_done)
    (step4_pending) (step4_done)
    (step5_pending) (step5_done)
    (step6_pending) (step6_done)
    (step7_pending) (step7_done)
    (invited) (costume_bought) (makeup_bought)
    (dressed_up) (arrived) (parked) (entered)
  )
  (:durative-action do_invite
    :duration (= ?duration 600)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (invited)))
  )
  (:durative-action do_shop_costume
    :duration (= ?duration 7200)
    :condition (and (at start (step2_pending)) (at start (invited)))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (costume_bought)))
  )
  (:durative-action do_shop_makeup
    :duration (= ?duration 3600)
    :condition (and (at start (step3_pending)) (at start (invited)))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (makeup_bought)))
  )
  (:durative-action do_dress
    :duration (= ?duration 3600)
    :condition (and (at start (step4_pending)) (at start (costume_bought)) (at start (makeup_bought)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (dressed_up)))
  )
  (:durative-action do_drive
    :duration (= ?duration 1800)
    :condition (and (at start (step5_pending)) (at start (dressed_up)))
    :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (arrived)))
  )
  (:durative-action do_park
    :duration (= ?duration 180)
    :condition (and (at start (step6_pending)) (at start (arrived)))
    :effect (and (at start (not (step6_pending))) (at end (step6_done)) (at end (parked)))
  )
  (:durative-action do_enter
    :duration (= ?duration 180)
    :condition (and (at start (step7_pending)) (at start (parked)))
    :effect (and (at start (not (step7_pending))) (at end (step7_done)) (at end (entered)))
  )
)