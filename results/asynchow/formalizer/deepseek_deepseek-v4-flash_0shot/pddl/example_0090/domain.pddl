(define (domain walmart)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (clothes_on)
    (grocery_list_made)
    (in_car)
    (at_walmart)
    (parked)
  )
  (:durative-action do_put_on_clothes
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (clothes_on)))
  )
  (:durative-action do_make_grocery_list
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (grocery_list_made)))
  )
  (:durative-action do_get_in_car
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step3))
                    (at start (clothes_on))
                    (at start (grocery_list_made)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (in_car)))
  )
  (:durative-action do_drive_to_walmart
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending step4))
                    (at start (in_car)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (at_walmart)))
  )
  (:durative-action do_find_parking_spot
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step5))
                    (at start (at_walmart)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (parked)))
  )
)