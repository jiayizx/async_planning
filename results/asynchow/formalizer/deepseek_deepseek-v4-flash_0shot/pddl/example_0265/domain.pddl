(define (domain sort_out_life) (:requirements :durative-actions :typing) (:types step) (:constants step1 step2 step3 step4 - step) (:predicates (step_pending ?s - step) (step_done ?s - step) (skill_learned) (resume_written) (change_made) (school_completed)) (:durative-action do_learn_skill :parameters () :duration (= ?duration 3) :condition (at start (step_pending step1)) :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (skill_learned)))) (:durative-action do_write_resume :parameters () :duration (= ?duration 0.5) :condition (and (at start (step_pending step2)) (at start (skill_learned)) (at start (school_completed))) :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (resume_written)))) (:durative-action do_make_change :parameters () :duration (= ?duration 2) :condition (and (at start (step_pending step3)) (at start (resume_written))) :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (change_made)))) (:durative-action do_go_back_to_school :parameters () :duration (= ?duration 48) :condition (at start (step_pending step4)) :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (school_completed)))))