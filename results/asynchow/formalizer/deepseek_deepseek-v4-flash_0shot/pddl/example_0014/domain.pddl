(define (domain poker_learning)
  (:requirements :durative-actions)
  (:predicates
    (step1_pending) (step1_done)
    (step2_pending) (step2_done)
    (step3_pending) (step3_done)
    (step4_pending) (step4_done)
    (step5_pending) (step5_done)
    (step6_pending) (step6_done)
    (books_read)
    (internet_accessed)
    (strategies_researched)
    (practiced_fun)
    (played_money)
    (played_casino)
  )
  (:durative-action do_step1
    :duration (= ?duration 10368000)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (books_read)))
  )
  (:durative-action do_step2
    :duration (= ?duration 60)
    :condition (at start (step2_pending))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (internet_accessed)))
  )
  (:durative-action do_step3
    :duration (= ?duration 604800)
    :condition (and (at start (step3_pending)) (at start (internet_accessed)))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (strategies_researched)))
  )
  (:durative-action do_step4
    :duration (= ?duration 604800)
    :condition (and (at start (step4_pending)) (at start (step1_done)) (at start (strategies_researched)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (practiced_fun)))
  )
  (:durative-action do_step5
    :duration (= ?duration 604800)
    :condition (and (at start (step5_pending)) (at start (practiced_fun)))
    :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (played_money)))
  )
  (:durative-action do_step6
    :duration (= ?duration 5184000)
    :condition (and (at start (step6_pending)) (at start (played_money)))
    :effect (and (at start (not (step6_pending))) (at end (step6_done)) (at end (played_casino)))
  )
)