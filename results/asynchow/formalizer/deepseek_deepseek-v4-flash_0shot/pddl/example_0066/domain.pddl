(define (domain grocery_list)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending)
    (step2_pending)
    (step3_pending)
    (step4_pending)
    (step5_pending)
    (step1_done)
    (step2_done)
    (step3_done)
    (step4_done)
    (step5_done)
    (cabinets_checked)
    (fridge_checked)
    (requirements_considered)
    (pen_paper_got)
    (list_made)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 180)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (cabinets_checked)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step2_pending))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (fridge_checked)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step3_pending)) (at start (cabinets_checked)) (at start (fridge_checked)))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (requirements_considered)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 15)
    :condition (and (at start (step4_pending)) (at start (requirements_considered)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (pen_paper_got)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step5_pending)) (at start (requirements_considered)))
    :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (list_made)))
  )
)