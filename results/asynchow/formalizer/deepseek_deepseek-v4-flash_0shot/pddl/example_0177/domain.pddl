(define (domain boost)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (caution_done)
    (lavender_done)
    (ginger_done)
    (blackpepper_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (caution_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step2)) (at start (caution_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (lavender_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step3)) (at start (caution_done)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (ginger_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending step4)) (at start (caution_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (blackpepper_done)))
  )
)