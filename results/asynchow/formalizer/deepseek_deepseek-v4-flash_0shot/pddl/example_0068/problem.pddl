(define (problem get_computer_problem)
  (:domain get_computer)
  (:requirements :durative-actions :typing)
  (:init
    (research_pending)
    (save_money_pending)
    (go_website_pending)
    (purchase_pending)
    (wait_sale_pending)
  )
  (:goal (and
    (research_done)
    (save_money_done)
    (go_website_done)
    (purchase_done)
    (wait_sale_done)
    (computer_obtained)
  ))
)