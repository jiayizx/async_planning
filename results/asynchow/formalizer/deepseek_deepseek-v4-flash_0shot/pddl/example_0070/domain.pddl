(define (domain marathon_signup)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (laptop_taken_out)
    (internet_gone_on)
    (website_looked_up)
    (payment_options_checked)
    (date_checked)
    (personal_info_started)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 30)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (laptop_taken_out)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (and (at start (step_pending ?s))
                    (at start (laptop_taken_out)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (internet_gone_on)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s))
                    (at start (internet_gone_on)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (website_looked_up)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 20)
    :condition (and (at start (step_pending ?s))
                    (at start (website_looked_up)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (payment_options_checked)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 30)
    :condition (and (at start (step_pending ?s))
                    (at start (website_looked_up)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (date_checked)))
  )
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s))
                    (at start (payment_options_checked))
                    (at start (date_checked)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (personal_info_started)))
  )
)