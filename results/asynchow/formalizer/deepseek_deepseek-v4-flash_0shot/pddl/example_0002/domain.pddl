(define (domain travel_to_europe)
  (:requirements :durative-actions :typing :equality)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (finished_1)
    (finished_2)
    (finished_3)
    (finished_4)
    (finished_5)
    (finished_6)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending ?s)) (at start (= ?s s1)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (finished_1)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending ?s)) (at start (= ?s s2)) (at start (finished_1)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (finished_2)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 259200)
    :condition (and (at start (step_pending ?s)) (at start (= ?s s3)) (at start (finished_2)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (finished_3)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s)) (at start (= ?s s4)) (at start (finished_3)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (finished_4)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 259200)
    :condition (and (at start (step_pending ?s)) (at start (= ?s s5)) (at start (finished_4)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (finished_5)))
  )
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 7776000)
    :condition (and (at start (step_pending ?s)) (at start (= ?s s6)) (at start (finished_4)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (finished_6)))
  )
)