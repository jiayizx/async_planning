(define (domain corned_beef_hash)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (ingredients_gathered)
               (mixture_combined)
               (bread_toasted)
               (hash_spread))
  (:durative-action gather_ingredients
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (ingredients_gathered))))
  (:durative-action combine_mixture
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step2))
                    (at start (ingredients_gathered)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (mixture_combined))))
  (:durative-action toast_bread
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (bread_toasted))))
  (:durative-action spread_hash
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step4))
                    (at start (mixture_combined))
                    (at start (bread_toasted)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (hash_spread))))
)