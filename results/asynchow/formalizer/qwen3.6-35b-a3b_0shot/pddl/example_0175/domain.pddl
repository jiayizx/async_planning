(define (domain cow_pregnancy)
  (:requirements :durative-actions :typing)
  (:types step - object)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (obs_done)
               (phys_done)
               (diag_done)
               (fetal_done))
  (:durative-action do_step1
    (:parameters (?s - step))
    (:duration 60)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end obs_done))))
  (:durative-action do_step2
    (:parameters (?s - step))
    (:duration 90)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end phys_done))))
  (:durative-action do_step4
    (:parameters (?s - step))
    (:duration 14)
    (:condition (and (at start (step_pending ?s))
                     (at start obs_done)
                     (at start phys_done)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end diag_done))))
  (:durative-action do_step3
    (:parameters (?s - step))
    (:duration 30)
    (:condition (and (at start (step_pending ?s))
                     (at start diag_done)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end fetal_done))))
)