(define (domain cook_ground_turkey)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (mix_done)
               (shape_done)
               (heat_done)
               (cook_done)
               (serve_done))
  (:durative-action do_mix
    (:parameters ?s)
    (:duration 300)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (mix_done)))))
  (:durative-action do_shape
    (:parameters ?s)
    (:duration 300)
    (:condition (and (at start (step_pending ?s))
                     (at start (mix_done))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (shape_done)))))
  (:durative-action do_heat
    (:parameters ?s)
    (:duration 120)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (heat_done)))))
  (:durative-action do_cook
    (:parameters ?s)
    (:duration 600)
    (:condition (and (at start (step_pending ?s))
                     (at start (shape_done))
                     (at start (heat_done))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (cook_done)))))
  (:durative-action do_serve
    (:parameters ?s)
    (:duration 60)
    (:condition (and (at start (step_pending ?s))
                     (at start (cook_done))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (serve_done)))))
)