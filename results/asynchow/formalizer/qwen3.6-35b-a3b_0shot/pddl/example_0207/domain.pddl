(define (domain look_good_party)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (scheduling_done)
               (grooming_done)
               (hair_done)
               (route_done))
  (:durative-action schedule_party
    (:parameters (?s - step))
    :duration (= ?duration 900)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end scheduling_done)))
  (:durative-action groom_hands_feet
    (:parameters (?s - step))
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s)) (at start scheduling_done))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end grooming_done)))
  (:durative-action make_hair_appointment
    (:parameters (?s - step))
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s)) (at start scheduling_done))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end hair_done)))
  (:durative-action figure_out_route
    (:parameters (?s - step))
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s)) (at start scheduling_done))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end route_done)))
)