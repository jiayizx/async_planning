(define (domain cookie_storage)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_done ?s - step)
               (step_pending ?s - step)
               (stored_in_container)
               (paper_towel_added)
               (bread_included))
  (:durative-action store_cookies
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (stored_in_container))))
  (:durative-action add_paper_towel
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s))
                    (at start (stored_in_container)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (paper_towel_added))))
  (:durative-action add_bread
    :parameters (?s - step)
    :duration (= ?duration 86400)
    :condition (and (at start (step_pending ?s))
                    (at start (stored_in_container)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (bread_included))))
)