(define (domain drift_tuning)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates (step_done ?s - step) (step_pending ?s - step)
               (tuning_configured) (suspension_configured) (drivetrain_configured)
               (aerodynamics_configured) (tires_configured))
  (:durative-action step1
    :duration (= ?duration 120)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (tuning_configured))))
  (:durative-action step2
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step2)) (at start (tuning_configured)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (suspension_configured))))
  (:durative-action step3
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step3)) (at start (tuning_configured)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (drivetrain_configured))))
  (:durative-action step4
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step4)) (at start (tuning_configured)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (aerodynamics_configured))))
  (:durative-action step5
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step5)) (at start (tuning_configured)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (tires_configured))))
)