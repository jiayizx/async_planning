(define (domain take_garcinia)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (dose_learned)
               (pill_taken)
               (liquid_considered))
  (:durative-action learn_dose
    :parameters (?s - step)
    :duration (= ?duration 86400)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (dose_learned))))
  (:durative-action take_pill
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s))
                    (at start (dose_learned)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (pill_taken))))
  (:durative-action consider_liquid
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s))
                    (at start (dose_learned)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (liquid_considered))))
)