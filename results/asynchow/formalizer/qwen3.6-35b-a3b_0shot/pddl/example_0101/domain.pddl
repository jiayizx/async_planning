(define (domain get_in_car)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (shirt_done)
               (pants_done)
               (right_sock_done)
               (left_sock_done)
               (right_shoe_done)
               (left_shoe_done)
               (keys_obtained))
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (shirt_done))))
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 15)
    :condition (and (at start (step_pending ?s)) (at start (shirt_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (pants_done))))
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (and (at start (step_pending ?s)) (at start (pants_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (right_sock_done))))
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (and (at start (step_pending ?s)) (at start (pants_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (left_sock_done))))
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 25)
    :condition (and (at start (step_pending ?s)) (at start (right_sock_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (right_shoe_done))))
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 25)
    :condition (and (at start (step_pending ?s)) (at start (left_sock_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (left_shoe_done))))
  (:durative-action do_step7
    :parameters (?s - step)
    :duration (= ?duration 10)
    :condition (and (at start (step_pending ?s))
                    (at start (right_shoe_done))
                    (at start (left_shoe_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (keys_obtained)))))