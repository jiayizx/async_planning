(define (problem succulents_care_prob)
  (:domain succulents_care)
  (:objects step1 step2 step3 - step)
  (:init (step_pending step1)
         (step_pending step2)
         (step_pending step3))
  (:goal (and (step_done step1)
              (step_done step2)
              (step_done step3)
              (pests_identified)
              (bugs_fought)
              (plants_quarantined))))