(define (domain film_learning)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (area_decided)
               (research_done)
               (library_done)
               (reading_done)
               (respect_enjoyed))
  (:durative-action decide_area
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step1)))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (area_decided))))
  (:durative-action research_online
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step2)) (at start (area_decided)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (research_done))))
  (:durative-action go_library
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step3)) (at start (area_decided)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (library_done))))
  (:durative-action read_research
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step4))
                    (at start (research_done))
                    (at start (library_done)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (reading_done))))
  (:durative-action enjoy_respect
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step5)) (at start (reading_done)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (respect_enjoyed))))
)