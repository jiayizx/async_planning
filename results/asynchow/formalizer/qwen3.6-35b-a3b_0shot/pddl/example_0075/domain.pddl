(define (domain vacation_location)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates (step_done ?s - step) (step_pending ?s - step)
               (mull_done) (ask_done) (select_done) (write_done) (put_done) (draw_done))
  (:durative-action mull_over
    :parameters ()
    :duration (= ?duration 172800)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (mull_done))))
  (:durative-action ask_husband
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step2)) (at start (mull_done)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (ask_done))))
  (:durative-action select_self
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step3)) (at start (mull_done)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (select_done))))
  (:durative-action write_locations
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step4)) (at start (ask_done)) (at start (select_done)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (write_done))))
  (:durative-action put_in_hat
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step5)) (at start (write_done)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (put_done))))
  (:durative-action draw_paper
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step6)) (at start (put_done)))
    :effect (and (at start (not (step_pending step6)))
                 (at end (step_done step6))
                 (at end (draw_done))))
)