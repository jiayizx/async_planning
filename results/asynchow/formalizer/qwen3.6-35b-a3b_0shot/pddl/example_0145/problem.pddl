(define (problem deter_squirrels_prob)
  (:domain deter_squirrels)
  (:objects step1 step2 step3 - step)
  (:init (step_pending step1)
         (step_pending step2)
         (step_pending step3))
  (:goal (and (step_done step1)
              (step_done step2)
              (step_done step3)
              feeder_hung))
  (:metric minimize (< ?duration>)))