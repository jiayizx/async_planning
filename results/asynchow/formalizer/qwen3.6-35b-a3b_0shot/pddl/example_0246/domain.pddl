(define (domain puppy_homes)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (req_established)
               (return_policy_established)
               (spay_neuter_clause_added)
               (owners_signed))
  (:durative-action establish_requirements
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step1)))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (req_established))))
  (:durative-action establish_return_policy
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step2)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (return_policy_established))))
  (:durative-action add_spay_neuter_clause
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step3)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (spay_neuter_clause_added))))
  (:durative-action have_owners_sign
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step4))
                   (at start (req_established))
                   (at start (return_policy_established))
                   (at start (spay_neuter_clause_added)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (owners_signed))))
)