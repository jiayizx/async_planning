(define (domain cookie_baking)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_done ?s - step)
               (step_pending ?s - step)
               (preheat_done)
               (flour_mixed_done)
               (sugars_blended_done)
               (dough_blended_done)
               (cookies_placed_done))
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (preheat_done))))
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (flour_mixed_done))))
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 240)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (sugars_blended_done))))
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 360)
    :condition (and (at start (step_pending ?s)) (at start (flour_mixed_done)) (at start (sugars_blended_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (dough_blended_done))))
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (dough_blended_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (cookies_placed_done))))
)