(define (domain milk_drinking)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (cabinet_reached)
               (glass_grabbed)
               (items_on_counter)
               (milk_poured)
               (fridge_reached)
               (new_milk_grabbed)
               (milk_drunk))
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (cabinet_reached))))
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (and (at start (step_pending ?s))
                    (at start (cabinet_reached)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (glass_grabbed))))
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (and (at start (step_pending ?s))
                    (at start (glass_grabbed))
                    (at start (new_milk_grabbed)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (items_on_counter))))
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (and (at start (step_pending ?s))
                    (at start (items_on_counter)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (milk_poured))))
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (fridge_reached))))
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 5)
    :condition (and (at start (step_pending ?s))
                    (at start (fridge_reached)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (new_milk_grabbed))))
  (:durative-action do_step7
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s))
                    (at start (milk_poured)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (milk_drunk))))
)