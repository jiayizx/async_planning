(define (domain snack_asynchronous)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_done ?s - step) 
               (step_pending ?s - step) 
               (kitchen_entered) 
               (cupboard_opened) 
               (items_examined) 
               (food_decided) 
               (snatch_reached))
  (:durative-action do_step1
    :duration (= ?duration 60)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (kitchen_entered))))
  (:durative-action do_step2
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step2)) (at start (kitchen_entered)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (cupboard_opened))))
  (:durative-action do_step3
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step3)) (at start (cupboard_opened)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (items_examined))))
  (:durative-action do_step4
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step4)) (at start (cupboard_opened)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (food_decided))))
  (:durative-action do_step5
    :duration (= ?duration 1)
    :condition (and (at start (step_pending step5)) (at start (items_examined)) (at start (food_decided)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (snatch_reached))))
)