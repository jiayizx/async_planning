(define (problem get_dressed)
  (:domain get_dressed)
  (:requirements :durative-actions :typing)
  (:objects step1 step2 step3 step4 step5 step6 - step)
  (:init (step_pending step1) (step_pending step2) (step_pending step3)
         (step_pending step4) (step_pending step5) (step_pending step6)
         (not (step_done step1)) (not (step_done step2)) (not (step_done step3))
         (not (step_done step4)) (not (step_done step5)) (not (step_done step6))
         (not (shirt_on)) (not (underwear_on)) (not (pants_on))
         (not (appearance_checked)) (not (socks_on)) (not (shoes_on)))
  (:goal (and (step_done step1) (step_done step2) (step_done step3)
              (step_done step4) (step_done step5) (step_done step6)
              (appearance_checked)))
)