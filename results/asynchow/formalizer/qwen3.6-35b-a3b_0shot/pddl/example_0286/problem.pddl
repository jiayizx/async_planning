(define (problem book_poetry_prob)
  (:domain book_poetry)
  (:objects step1 step2 step3 step4 - step)
  (:init 
    (step_pending step1)
    (step_pending step2)
    (step_pending step3)
    (step_pending step4)
    (not (step_done step1))
    (not (step_done step2))
    (not (step_done step3))
    (not (step_done step4))
    (not (manuscript_ready))
    (not (route_found))
    (not (collection_assembled))
    (not (materials_sent)))
  (:goal (and (step_done step1) (step_done step2) (step_done step3) (step_done step4) (materials_sent)))
)