(define (domain book_poetry)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (manuscript_ready)
    (route_found)
    (collection_assembled)
    (materials_sent))
  (:durative-action do_step1
    (:parameters (?s - step))
    (:duration (= ?duration 60))
    (:condition (at start (and (step_pending ?s) (collection_assembled))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (manuscript_ready)))))
  (:durative-action do_step2
    (:parameters (?s - step))
    (:duration (= ?duration 14))
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (route_found)))))
  (:durative-action do_step3
    (:parameters (?s - step))
    (:duration (= ?duration 60))
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (collection_assembled)))))
  (:durative-action do_step4
    (:parameters (?s - step))
    (:duration (= ?duration 14))
    (:condition (at start (and (step_pending ?s) (manuscript_ready) (route_found))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (materials_sent)))))
)