(define (domain sumac)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (sumac_purchased)
               (used_in_dish)
               (added_to_dips)
               (used_in_marinade)
               (added_to_zatar)
               (added_to_frittata)
               (sprinkled_on_vegetables))
  (:durative-action purchase_sumac
    :parameters (?s - step)
    :duration (= (?duration) 30)
    :condition (and (at start (step_pending ?s)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (sumac_purchased))))
  (:durative-action use_in_dish
    :parameters (?s - step)
    :duration (= (?duration) 5)
    :condition (and (at start (step_pending ?s)) (at start (sumac_purchased)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (used_in_dish))))
  (:durative-action add_to_dips
    :parameters (?s - step)
    :duration (= (?duration) 3)
    :condition (and (at start (step_pending ?s)) (at start (sumac_purchased)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (added_to_dips))))
  (:durative-action use_in_marinade
    :parameters (?s - step)
    :duration (= (?duration) 10)
    :condition (and (at start (step_pending ?s)) (at start (sumac_purchased)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (used_in_marinade))))
  (:durative-action add_to_zatar
    :parameters (?s - step)
    :duration (= (?duration) 3)
    :condition (and (at start (step_pending ?s)) (at start (sumac_purchased)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (added_to_zatar))))
  (:durative-action add_to_frittata
    :parameters (?s - step)
    :duration (= (?duration) 8)
    :condition (and (at start (step_pending ?s)) (at start (sumac_purchased)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (added_to_frittata))))
  (:durative-action sprinkle_on_vegetables
    :parameters (?s - step)
    :duration (= (?duration) 3)
    :condition (and (at start (step_pending ?s)) (at start (sumac_purchased)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (sprinkled_on_vegetables))))
)