(define (domain game_watching)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (snacks_bought)
               (clothes_changed)
               (on_couch)
               (snacks_in_bowls)
               (tv_on)
               (bowls_on_table)
               (channel_flipped))
  (:durative-action step1
    :duration (= ?duration 1800)
    :parameters (?s - step)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (snacks_bought))))
  (:durative-action step2
    :duration (= ?duration 120)
    :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start (snacks_bought)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (clothes_changed))))
  (:durative-action step3
    :duration (= ?duration 2)
    :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start (clothes_changed)) (at start (bowls_on_table)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (on_couch))))
  (:durative-action step4
    :duration (= ?duration 600)
    :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start (snacks_bought)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (snacks_in_bowls))))
  (:durative-action step5
    :duration (= ?duration 3)
    :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start (snacks_bought)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (tv_on))))
  (:durative-action step6
    :duration (= ?duration 60)
    :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start (snacks_in_bowls)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (bowls_on_table))))
  (:durative-action step7
    :duration (= ?duration 60)
    :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start (tv_on)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (channel_flipped))))
)