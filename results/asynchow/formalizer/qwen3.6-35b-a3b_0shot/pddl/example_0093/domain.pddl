(define (domain party_domain)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (invited)
    (costume_ready)
    (makeup_ready)
    (ready_to_go)
    (arrived_at_venue)
    (car_parked)
    (entered_party))
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step1)))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (invited))))
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step2)) (at start (invited)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (costume_ready))))
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step3)) (at start (invited)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (makeup_ready))))
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step4)) 
                    (at start (costume_ready)) 
                    (at start (makeup_ready)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (ready_to_go))))
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step5)) (at start (ready_to_go)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (arrived_at_venue))))
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step6)) (at start (arrived_at_venue)))
    :effect (and (at start (not (step_pending step6)))
                 (at end (step_done step6))
                 (at end (car_parked))))
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step7)) (at start (car_parked)))
    :effect (and (at start (not (step_pending step7)))
                 (at end (step_done step7))
                 (at end (entered_party))))
)