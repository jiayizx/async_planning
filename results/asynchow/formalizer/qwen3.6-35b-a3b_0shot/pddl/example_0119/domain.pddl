(define (domain laundry)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (soft_bought)
    (detergent_bought)
    (clothes_gathered)
    (machine_open)
    (clothes_in_machine)
    (detergent_added)
    (machine_on))
  (:durative-action buy_fabric_softener
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending ?s)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (soft_bought))))
  (:durative-action buy_laundry_detergent
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending ?s)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (detergent_bought))))
  (:durative-action gather_dirty_clothes
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s))
                    (at start (soft_bought))
                    (at start (detergent_bought)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (clothes_gathered))))
  (:durative-action open_washing_machine
    :parameters (?s - step)
    :duration (= ?duration 20)
    :condition (and (at start (step_pending ?s))
                    (at start (clothes_gathered)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (machine_open))))
  (:durative-action put_clothes_in_machine
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s))
                    (at start (machine_open)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (clothes_in_machine))))
  (:durative-action add_laundry_detergent
    :parameters (?s - step)
    :duration (= ?duration 30)
    :condition (and (at start (step_pending ?s))
                    (at start (machine_open)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (detergent_added))))
  (:durative-action turn_on_washing_machine
    :parameters (?s - step)
    :duration (= ?duration 20)
    :condition (and (at start (step_pending ?s))
                    (at start (clothes_in_machine))
                    (at start (detergent_added)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (machine_on))))
)