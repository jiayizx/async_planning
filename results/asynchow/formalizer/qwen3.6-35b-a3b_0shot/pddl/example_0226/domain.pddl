(define (domain organize_house)
  (:requirements :durative-actions)
  (:predicates (step_pending ?s) (step_done ?s) (s1_done) (s2_done) (s3_done) (s4_done) (s5_done))
  (:durative-action do_step1 (?s)
    :duration 7200
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (s1_done))))
  (:durative-action do_step2 (?s)
    :duration 3600
    :condition (and (at start (step_pending ?s))
                    (at start (s1_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (s2_done))))
  (:durative-action do_step3 (?s)
    :duration 14400
    :condition (and (at start (step_pending ?s))
                    (at start (s1_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (s3_done))))
  (:durative-action do_step4 (?s)
    :duration 7200
    :condition (and (at start (step_pending ?s))
                    (at start (s1_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (s4_done))))
  (:durative-action do_step5 (?s)
    :duration 7200
    :condition (and (at start (step_pending ?s))
                    (at start (s1_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (s5_done))))
)