(define (domain async_money_domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (research_done)
               (signup_done)
               (verification_done)
               (approval_done)
               (browsing_done)
               (tasks_done))
  (:durative-action step1
    :parameters ()
    :duration (= ?duration 10800)
    :condition (and (at start (step_pending step1)))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (research_done))))
  (:durative-action step2
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step2))
                    (at start (research_done)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (signup_done))))
  (:durative-action step3
    :parameters ()
    :duration (= ?duration 86400)
    :condition (and (at start (step_pending step3))
                    (at start (research_done)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (verification_done))))
  (:durative-action step4
    :parameters ()
    :duration (= ?duration 86400)
    :condition (and (at start (step_pending step4))
                    (at start (verification_done)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (approval_done))))
  (:durative-action step5
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step5))
                    (at start (approval_done)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (browsing_done))))
  (:durative-action step6
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step6))
                    (at start (browsing_done)))
    :effect (and (at start (not (step_pending step6)))
                 (at end (step_done step6))
                 (at end (tasks_done)))))