(define (problem put_on_clothes_problem)
  (:domain put_on_clothes)
  (:init
    (open_drawer_pending)
    (take_shirt_pending)
    (take_socks_pending)
    (take_pants_pending)
    (put_shirt_pending)
    (put_socks_pending)
    (put_pants_pending)
  )
  (:goal (and
    (open_drawer_done)
    (take_shirt_done)
    (take_socks_done)
    (take_pants_done)
    (put_shirt_done)
    (put_socks_done)
    (put_pants_done)
  ))
)
