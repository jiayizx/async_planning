(define (problem get_in_car_problem)
  (:domain getting_in_car)
  (:init
    (shirt_pending)
    (pants_pending)
    (right_sock_pending)
    (left_sock_pending)
    (right_shoe_pending)
    (left_shoe_pending)
    (car_keys_pending)
  )
  (:goal (and
    (shirt_done)
    (pants_done)
    (right_sock_done)
    (left_sock_done)
    (right_shoe_done)
    (left_shoe_done)
    (car_keys_done)
  ))
)
