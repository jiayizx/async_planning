(define (domain flight_bump_reaction)
(:requirements :durative-actions)
(:predicates
(step1_pending)
(step1_done)
(step2_pending)
(step2_done)
(step3_pending)
(step3_done)
(step4_pending)
(step4_done)
)
(:durative-action speak_with_gate_agent
:parameters ()
:duration (= ?duration 600)
:condition (at start (step1_pending))
:effect (and (at start (not (step1_pending))) (at end (step1_done)))
)
(:durative-action confirm_flight
:parameters ()
:duration (= ?duration 1200)
:condition (and (at start (step2_pending)) (at start (step1_done)))
:effect (and (at start (not (step2_pending))) (at end (step2_done)))
)
(:durative-action ask_reimbursement
:parameters ()
:duration (= ?duration 600)
:condition (and (at start (step3_pending)) (at start (step1_done)))
:effect (and (at start (not (step3_pending))) (at end (step3_done)))
)
(:durative-action ask_vouchers
:parameters ()
:duration (= ?duration 600)
:condition (and (at start (step4_pending)) (at start (step1_done)))
:effect (and (at start (not (step4_pending))) (at end (step4_done)))
)
)