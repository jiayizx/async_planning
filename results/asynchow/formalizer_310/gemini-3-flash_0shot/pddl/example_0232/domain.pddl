(define (domain understand_math)
(:requirements :durative-actions)
(:predicates
(extra_help_pending)
(extra_help_done)
(practice_pending)
(practice_done)
(hire_tutor_pending)
(hire_tutor_done)
(friend_guidance_pending)
(friend_guidance_done)
)
(:durative-action go_for_extra_help
:parameters ()
:duration (= ?duration 3600)
:condition (at start (extra_help_pending))
:effect (and (at start (not (extra_help_pending))) (at end (extra_help_done)))
)
(:durative-action hire_tutor
:parameters ()
:duration (= ?duration 10800)
:condition (at start (hire_tutor_pending))
:effect (and (at start (not (hire_tutor_pending))) (at end (hire_tutor_done)))
)
(:durative-action look_to_friend
:parameters ()
:duration (= ?duration 1800)
:condition (at start (friend_guidance_pending))
:effect (and (at start (not (friend_guidance_pending))) (at end (friend_guidance_done)))
)
(:durative-action practice_on_own
:parameters ()
:duration (= ?duration 7200)
:condition (and (at start (practice_pending)) (at start (extra_help_done)) (at start (hire_tutor_done)) (at start (friend_guidance_done)))
:effect (and (at start (not (practice_pending))) (at end (practice_done)))
)
)