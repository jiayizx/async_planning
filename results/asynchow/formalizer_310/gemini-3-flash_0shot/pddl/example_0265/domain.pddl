(define (domain sort_out_life)
(:requirements :durative-actions)
(:predicates
(learn_skill_pending)
(learn_skill_done)
(write_resume_pending)
(write_resume_done)
(make_change_pending)
(make_change_done)
(go_to_school_pending)
(go_to_school_done)
)
(:durative-action learn_skill
:parameters ()
:duration (= ?duration 7776000)
:condition (at start (learn_skill_pending))
:effect (and (at start (not (learn_skill_pending))) (at end (learn_skill_done)))
)
(:durative-action write_resume
:parameters ()
:duration (= ?duration 1209600)
:condition (and (at start (write_resume_pending)) (at start (learn_skill_done)) (at start (go_to_school_done)))
:effect (and (at start (not (write_resume_pending))) (at end (write_resume_done)))
)
(:durative-action make_change
:parameters ()
:duration (= ?duration 5184000)
:condition (and (at start (make_change_pending)) (at start (write_resume_done)))
:effect (and (at start (not (make_change_pending))) (at end (make_change_done)))
)
(:durative-action go_to_school
:parameters ()
:duration (= ?duration 126144000)
:condition (at start (go_to_school_pending))
:effect (and (at start (not (go_to_school_pending))) (at end (go_to_school_done)))
)
)