(define (domain hamster_diagnosis)
(:requirements :durative-actions)
(:predicates
(step1_pending)
(step1_done)
(step2_pending)
(step2_done)
(step3_pending)
(step3_done)
)
(:durative-action take_to_vet
:parameters ()
:duration (= ?duration 1800)
:condition (and (at start (step1_pending)) (at start (step2_done)) (at start (step3_done)))
:effect (and (at start (not (step1_pending))) (at end (step1_done)))
)
(:durative-action watch_lethargy
:parameters ()
:duration (= ?duration 604800)
:condition (at start (step2_pending))
:effect (and (at start (not (step2_pending))) (at end (step2_done)))
)
(:durative-action check_discharge
:parameters ()
:duration (= ?duration 300)
:condition (at start (step3_pending))
:effect (and (at start (not (step3_pending))) (at end (step3_done)))
)
)