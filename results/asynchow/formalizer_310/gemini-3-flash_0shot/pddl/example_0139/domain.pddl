(define (domain towel_butterflies)
(:requirements :durative-actions)
(:predicates
(step1_pending)
(step1_done)
(step2_pending)
(step2_done)
(step3_pending)
(step3_done)
)
(:durative-action fold_bath_towel
:parameters ()
:duration (= ?duration 120)
:condition (at start (step1_pending))
:effect (and (at start (not (step1_pending))) (at end (step1_done)))
)
(:durative-action roll_washcloth
:parameters ()
:duration (= ?duration 120)
:condition (at start (step2_pending))
:effect (and (at start (not (step2_pending))) (at end (step2_done)))
)
(:durative-action decorate_butterfly
:parameters ()
:duration (= ?duration 300)
:condition (and (at start (step3_pending)) (at start (step1_done)) (at start (step2_done)))
:effect (and (at start (not (step3_pending))) (at end (step3_done)))
)
)