(define (domain steamed_sweet_potatoes)
(:requirements :durative-actions)
(:predicates
(peel_pending)
(peel_done)
(cut_pending)
(cut_done)
(place_pending)
(place_done)
(boil_pending)
(boil_done)
(serve_pending)
(serve_done)
)
(:durative-action peel_potatoes
:parameters ()
:duration (= ?duration 300)
:condition (at start (peel_pending))
:effect (and (at start (not (peel_pending))) (at end (peel_done)))
)
(:durative-action cut_potatoes
:parameters ()
:duration (= ?duration 180)
:condition (and (at start (cut_pending)) (at start (peel_done)))
:effect (and (at start (not (cut_pending))) (at end (cut_done)))
)
(:durative-action place_in_tray
:parameters ()
:duration (= ?duration 60)
:condition (and (at start (place_pending)) (at start (cut_done)) (at start (boil_done)))
:effect (and (at start (not (place_pending))) (at end (place_done)))
)
(:durative-action boil_water
:parameters ()
:duration (= ?duration 600)
:condition (at start (boil_pending))
:effect (and (at start (not (boil_pending))) (at end (boil_done)))
)
(:durative-action serve_and_enjoy
:parameters ()
:duration (= ?duration 120)
:condition (and (at start (serve_pending)) (at start (place_done)))
:effect (and (at start (not (serve_pending))) (at end (serve_done)))
)
)