(define (domain aloe_vera_processing)
(:requirements :durative-actions)
(:predicates
(step1_pending) (step1_done)
(step2_pending) (step2_done)
(step3_pending) (step3_done)
(step4_pending) (step4_done)
(step5_pending) (step5_done)
(step6_pending) (step6_done)
(step7_pending) (step7_done)
(step8_pending) (step8_done)
(step9_pending) (step9_done)
)
(:durative-action remove_edges
:parameters ()
:duration (= ?duration 120)
:condition (and (at start (step1_pending)) (at start (step2_done)))
:effect (and (at start (not (step1_pending))) (at end (step1_done))))
(:durative-action cut_segments
:parameters ()
:duration (= ?duration 300)
:condition (at start (step2_pending))
:effect (and (at start (not (step2_pending))) (at end (step2_done))))
(:durative-action cut_rind
:parameters ()
:duration (= ?duration 180)
:condition (and (at start (step3_pending)) (at start (step1_done)))
:effect (and (at start (not (step3_pending))) (at end (step3_done))))
(:durative-action prepare_gel_base
:parameters ()
:duration (= ?duration 300)
:condition (at start (step4_pending))
:effect (and (at start (not (step4_pending))) (at end (step4_done))))
(:durative-action treat_sunburn
:parameters ()
:duration (= ?duration 600)
:condition (and (at start (step5_pending)) (at start (step3_done)) (at start (step4_done)))
:effect (and (at start (not (step5_pending))) (at end (step5_done))))
(:durative-action remove_makeup
:parameters ()
:duration (= ?duration 300)
:condition (and (at start (step6_pending)) (at start (step3_done)) (at start (step4_done)))
:effect (and (at start (not (step6_pending))) (at end (step6_done))))
(:durative-action fight_acne
:parameters ()
:duration (= ?duration 420)
:condition (and (at start (step7_pending)) (at start (step3_done)) (at start (step4_done)))
:effect (and (at start (not (step7_pending))) (at end (step7_done))))
(:durative-action clean_mouth
:parameters ()
:duration (= ?duration 120)
:condition (and (at start (step8_pending)) (at start (step3_done)) (at start (step4_done)))
:effect (and (at start (not (step8_pending))) (at end (step8_done))))
(:durative-action shampoo_hair
:parameters ()
:duration (= ?duration 900)
:condition (and (at start (step9_pending)) (at start (step3_done)) (at start (step4_done)))
:effect (and (at start (not (step9_pending))) (at end (step9_done))))
)