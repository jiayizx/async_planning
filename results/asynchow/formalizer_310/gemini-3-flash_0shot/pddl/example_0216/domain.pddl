(define (domain dentist_visit)
(:requirements :durative-actions)
(:predicates
(choose_dentist_pending)
(choose_dentist_done)
(offer_appointment_pending)
(offer_appointment_done)
(go_with_him_pending)
(go_with_him_done)
(give_music_pending)
(give_music_done)
)
(:durative-action choose_dentist
:parameters ()
:duration (= ?duration 300)
:condition (at start (choose_dentist_pending))
:effect (and (at start (not (choose_dentist_pending))) (at end (choose_dentist_done))))
(:durative-action offer_appointment
:parameters ()
:duration (= ?duration 600)
:condition (and (at start (offer_appointment_pending)) (at start (choose_dentist_done)))
:effect (and (at start (not (offer_appointment_pending))) (at end (offer_appointment_done))))
(:durative-action go_with_him
:parameters ()
:duration (= ?duration 7200)
:condition (and (at start (go_with_him_pending)) (at start (offer_appointment_done)))
:effect (and (at start (not (go_with_him_pending))) (at end (go_with_him_done))))
(:durative-action give_music
:parameters ()
:duration (= ?duration 1800)
:condition (at start (give_music_pending))
:effect (and (at start (not (give_music_pending))) (at end (give_music_done))))
)