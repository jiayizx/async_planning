(define (domain wake_up_dream)
(:requirements :durative-actions)
(:predicates
(realize_dreaming_pending)
(realize_dreaming_done)
(wear_watch_pending)
(wear_watch_done)
(mild_technique_pending)
(mild_technique_done)
(prevent_uncomfortable_pending)
(prevent_uncomfortable_done)
(light_stimulus_pending)
(light_stimulus_done)
(combine_techniques_pending)
(combine_techniques_done)
)
(:durative-action realize_dreaming
:parameters ()
:duration (= ?duration 30)
:condition (at start (realize_dreaming_pending))
:effect (and (at start (not (realize_dreaming_pending))) (at end (realize_dreaming_done))))
(:durative-action wear_watch
:parameters ()
:duration (= ?duration 600)
:condition (at start (wear_watch_pending))
:effect (and (at start (not (wear_watch_pending))) (at end (wear_watch_done))))
(:durative-action mild_technique
:parameters ()
:duration (= ?duration 1800)
:condition (at start (mild_technique_pending))
:effect (and (at start (not (mild_technique_pending))) (at end (mild_technique_done))))
(:durative-action prevent_uncomfortable
:parameters ()
:duration (= ?duration 300)
:condition (at start (prevent_uncomfortable_pending))
:effect (and (at start (not (prevent_uncomfortable_pending))) (at end (prevent_uncomfortable_done))))
(:durative-action light_stimulus
:parameters ()
:duration (= ?duration 120)
:condition (at start (light_stimulus_pending))
:effect (and (at start (not (light_stimulus_pending))) (at end (light_stimulus_done))))
(:durative-action combine_techniques
:parameters ()
:duration (= ?duration 900)
:condition (and (at start (combine_techniques_pending)) (at start (mild_technique_done)) (at start (light_stimulus_done)))
:effect (and (at start (not (combine_techniques_pending))) (at end (combine_techniques_done))))
)