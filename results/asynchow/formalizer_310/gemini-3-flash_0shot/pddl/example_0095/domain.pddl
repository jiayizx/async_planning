(define (domain rollerblade_learning)
(:requirements :durative-actions)
(:predicates
(walk_to_bus_stop_pending)
(walk_to_bus_stop_done)
(wait_for_bus_pending)
(wait_for_bus_done)
(take_bus_pending)
(take_bus_done)
(sign_up_lessons_pending)
(sign_up_lessons_done)
(rent_rollerblades_pending)
(rent_rollerblades_done)
(wait_for_lessons_pending)
(wait_for_lessons_done)
(follow_instructions_pending)
(follow_instructions_done)
)
(:durative-action walk_to_bus_stop
:parameters ()
:duration (= ?duration 600)
:condition (at start (walk_to_bus_stop_pending))
:effect (and (at start (not (walk_to_bus_stop_pending))) (at end (walk_to_bus_stop_done))))
(:durative-action wait_for_bus
:parameters ()
:duration (= ?duration 900)
:condition (and (at start (wait_for_bus_pending)) (at start (walk_to_bus_stop_done)))
:effect (and (at start (not (wait_for_bus_pending))) (at end (wait_for_bus_done))))
(:durative-action take_bus
:parameters ()
:duration (= ?duration 1200)
:condition (and (at start (take_bus_pending)) (at start (wait_for_bus_done)))
:effect (and (at start (not (take_bus_pending))) (at end (take_bus_done))))
(:durative-action sign_up_lessons
:parameters ()
:duration (= ?duration 300)
:condition (and (at start (sign_up_lessons_pending)) (at start (take_bus_done)))
:effect (and (at start (not (sign_up_lessons_pending))) (at end (sign_up_lessons_done))))
(:durative-action rent_rollerblades
:parameters ()
:duration (= ?duration 300)
:condition (and (at start (rent_rollerblades_pending)) (at start (take_bus_done)))
:effect (and (at start (not (rent_rollerblades_pending))) (at end (rent_rollerblades_done))))
(:durative-action wait_for_lessons
:parameters ()
:duration (= ?duration 3600)
:condition (and (at start (wait_for_lessons_pending)) (at start (sign_up_lessons_done)))
:effect (and (at start (not (wait_for_lessons_pending))) (at end (wait_for_lessons_done))))
(:durative-action follow_instructions
:parameters ()
:duration (= ?duration 3600)
:condition (and (at start (follow_instructions_pending)) (at start (rent_rollerblades_done)) (at start (wait_for_lessons_done)))
:effect (and (at start (not (follow_instructions_pending))) (at end (follow_instructions_done))))
)