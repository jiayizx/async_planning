(define (domain fire_building)
(:requirements :durative-actions)
(:predicates
(find_lighter_pending)
(find_lighter_done)
(find_wood_pending)
(find_wood_done)
(place_wood_pending)
(place_wood_done)
(tear_newspaper_pending)
(tear_newspaper_done)
(ignite_fire_pending)
(ignite_fire_done)
)
(:durative-action find_lighter
:parameters ()
:duration (= ?duration 300)
:condition (at start (find_lighter_pending))
:effect (and (at start (not (find_lighter_pending))) (at end (find_lighter_done)))
)
(:durative-action find_wood
:parameters ()
:duration (= ?duration 300)
:condition (at start (find_wood_pending))
:effect (and (at start (not (find_wood_pending))) (at end (find_wood_done)))
)
(:durative-action place_wood
:parameters ()
:duration (= ?duration 300)
:condition (and (at start (place_wood_pending)) (at start (find_wood_done)))
:effect (and (at start (not (place_wood_pending))) (at end (place_wood_done)))
)
(:durative-action tear_newspaper
:parameters ()
:duration (= ?duration 120)
:condition (and (at start (tear_newspaper_pending)) (at start (place_wood_done)))
:effect (and (at start (not (tear_newspaper_pending))) (at end (tear_newspaper_done)))
)
(:durative-action ignite_fire
:parameters ()
:duration (= ?duration 780)
:condition (and (at start (ignite_fire_pending)) (at start (find_lighter_done)) (at start (tear_newspaper_done)))
:effect (and (at start (not (ignite_fire_pending))) (at end (ignite_fire_done)))
)
)