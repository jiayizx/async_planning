(define (domain friends_gathering)
(:requirements :durative-actions)
(:predicates
(step1_pending) (step1_done)
(step2_pending) (step2_done)
(step3_pending) (step3_done)
(step4_pending) (step4_done)
(step5_pending) (step5_done)
(step6_pending) (step6_done)
(step7_pending) (step7_done)
)
(:durative-action find_gatherings
:parameters ()
:duration (= ?duration 3600)
:condition (at start (step1_pending))
:effect (and (at start (not (step1_pending))) (at end (step1_done))))
(:durative-action go_to_gatherings
:parameters ()
:duration (= ?duration 2592000)
:condition (and (at start (step2_pending)) (at start (step1_done)))
:effect (and (at start (not (step2_pending))) (at end (step2_done))))
(:durative-action introduce_self
:parameters ()
:duration (= ?duration 3600)
:condition (and (at start (step3_pending)) (at start (step2_done)))
:effect (and (at start (not (step3_pending))) (at end (step3_done))))
(:durative-action have_conversations
:parameters ()
:duration (= ?duration 3600)
:condition (and (at start (step4_pending)) (at start (step2_done)))
:effect (and (at start (not (step4_pending))) (at end (step4_done))))
(:durative-action find_commonality
:parameters ()
:duration (= ?duration 3600)
:condition (and (at start (step5_pending)) (at start (step3_done)) (at start (step4_done)))
:effect (and (at start (not (step5_pending))) (at end (step5_done))))
(:durative-action invite_coffee
:parameters ()
:duration (= ?duration 900)
:condition (and (at start (step6_pending)) (at start (step5_done)))
:effect (and (at start (not (step6_pending))) (at end (step6_done))))
(:durative-action meet_for_coffee
:parameters ()
:duration (= ?duration 2592000)
:condition (and (at start (step7_pending)) (at start (step6_done)))
:effect (and (at start (not (step7_pending))) (at end (step7_done))))
)