(define (domain government_assistance)
(:requirements :durative-actions)
(:predicates
(fafsa_pending)
(fafsa_done)
(pell_grant_pending)
(pell_grant_done)
(fseog_pending)
(fseog_done)
)
(:durative-action fill_fafsa
:parameters ()
:duration (= ?duration 7200)
:condition (at start (fafsa_pending))
:effect (and (at start (not (fafsa_pending))) (at end (fafsa_done)))
)
(:durative-action apply_pell_grant
:parameters ()
:duration (= ?duration 3600)
:condition (and (at start (pell_grant_pending)) (at start (fafsa_done)))
:effect (and (at start (not (pell_grant_pending))) (at end (pell_grant_done)))
)
(:durative-action apply_fseog
:parameters ()
:duration (= ?duration 3600)
:condition (and (at start (fseog_pending)) (at start (fafsa_done)))
:effect (and (at start (not (fseog_pending))) (at end (fseog_done)))
)
)