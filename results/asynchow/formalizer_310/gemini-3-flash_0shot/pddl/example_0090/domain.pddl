(define (domain walmart_trip)
(:requirements :durative-actions)
(:predicates
(clothes_pending) (clothes_done)
(list_pending) (list_done)
(get_in_car_pending) (get_in_car_done)
(drive_pending) (drive_done)
(parking_pending) (parking_done)
)
(:durative-action put_on_clothes
:parameters ()
:duration (= ?duration 300)
:condition (at start (clothes_pending))
:effect (and (at start (not (clothes_pending))) (at end (clothes_done)))
)
(:durative-action make_grocery_list
:parameters ()
:duration (= ?duration 300)
:condition (at start (list_pending))
:effect (and (at start (not (list_pending))) (at end (list_done)))
)
(:durative-action get_in_car
:parameters ()
:duration (= ?duration 60)
:condition (and (at start (get_in_car_pending)) (at start (clothes_done)) (at start (list_done)))
:effect (and (at start (not (get_in_car_pending))) (at end (get_in_car_done)))
)
(:durative-action drive_to_walmart
:parameters ()
:duration (= ?duration 1200)
:condition (and (at start (drive_pending)) (at start (get_in_car_done)))
:effect (and (at start (not (drive_pending))) (at end (drive_done)))
)
(:durative-action find_parking
:parameters ()
:duration (= ?duration 120)
:condition (and (at start (parking_pending)) (at start (drive_done)))
:effect (and (at start (not (parking_pending))) (at end (parking_done)))
)
)