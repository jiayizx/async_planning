(define (domain basketball_learning)
(:requirements :durative-actions)
(:predicates
(hire_coach_pending)
(hire_coach_done)
(buy_ball_pending)
(buy_ball_done)
(find_court_pending)
(find_court_done)
(practice_dribbling_pending)
(practice_dribbling_done)
(practice_shooting_pending)
(practice_shooting_done)
)
(:durative-action hire_coach
:parameters ()
:duration (= ?duration 172800)
:condition (at start (hire_coach_pending))
:effect (and (at start (not (hire_coach_pending))) (at end (hire_coach_done)))
)
(:durative-action buy_ball
:parameters ()
:duration (= ?duration 1200)
:condition (at start (buy_ball_pending))
:effect (and (at start (not (buy_ball_pending))) (at end (buy_ball_done)))
)
(:durative-action find_court
:parameters ()
:duration (= ?duration 900)
:condition (and (at start (find_court_pending)) (at start (buy_ball_done)))
:effect (and (at start (not (find_court_pending))) (at end (find_court_done)))
)
(:durative-action practice_dribbling
:parameters ()
:duration (= ?duration 7200)
:condition (and (at start (practice_dribbling_pending)) (at start (hire_coach_done)) (at start (find_court_done)))
:effect (and (at start (not (practice_dribbling_pending))) (at end (practice_dribbling_done)))
)
(:durative-action practice_shooting
:parameters ()
:duration (= ?duration 10800)
:condition (and (at start (practice_shooting_pending)) (at start (hire_coach_done)) (at start (find_court_done)))
:effect (and (at start (not (practice_shooting_pending))) (at end (practice_shooting_done)))
)
)