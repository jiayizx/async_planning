(define (domain dispose_xray_film)
(:requirements :durative-actions)
(:predicates
(cut_info_pending)
(cut_info_done)
(donate_films_pending)
(donate_films_done)
(arts_crafts_pending)
(arts_crafts_done)
)
(:durative-action cut_info
:parameters ()
:duration (= ?duration 300)
:condition (at start (cut_info_pending))
:effect (and (at start (not (cut_info_pending))) (at end (cut_info_done)))
)
(:durative-action donate_films
:parameters ()
:duration (= ?duration 900)
:condition (and (at start (donate_films_pending)) (at start (cut_info_done)))
:effect (and (at start (not (donate_films_pending))) (at end (donate_films_done)))
)
(:durative-action arts_crafts
:parameters ()
:duration (= ?duration 1800)
:condition (and (at start (arts_crafts_pending)) (at start (cut_info_done)))
:effect (and (at start (not (arts_crafts_pending))) (at end (arts_crafts_done)))
)
)