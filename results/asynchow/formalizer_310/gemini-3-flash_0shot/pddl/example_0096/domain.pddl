(define (domain class_president)
(:requirements :durative-actions)
(:predicates
(speak_classmates_pending)
(speak_classmates_done)
(identify_issues_pending)
(identify_issues_done)
(write_platform_pending)
(write_platform_done)
(make_speeches_pending)
(make_speeches_done)
(make_posters_pending)
(make_posters_done)
)
(:durative-action speak_classmates
:parameters ()
:duration (= ?duration 18000)
:condition (at start (speak_classmates_pending))
:effect (and (at start (not (speak_classmates_pending))) (at end (speak_classmates_done)))
)
(:durative-action identify_issues
:parameters ()
:duration (= ?duration 18000)
:condition (at start (identify_issues_pending))
:effect (and (at start (not (identify_issues_pending))) (at end (identify_issues_done)))
)
(:durative-action write_platform
:parameters ()
:duration (= ?duration 10800)
:condition (and (at start (write_platform_pending)) (at start (identify_issues_done)))
:effect (and (at start (not (write_platform_pending))) (at end (write_platform_done)))
)
(:durative-action make_speeches
:parameters ()
:duration (= ?duration 7200)
:condition (and (at start (make_speeches_pending)) (at start (write_platform_done)))
:effect (and (at start (not (make_speeches_pending))) (at end (make_speeches_done)))
)
(:durative-action make_posters
:parameters ()
:duration (= ?duration 10800)
:condition (at start (make_posters_pending))
:effect (and (at start (not (make_posters_pending))) (at end (make_posters_done)))
)
)