(define (domain bake_soft_cookies)
    (:requirements :durative-actions :time)
    (:predicates
        (store_cookies_pending)
        (store_cookies_done)
        (add_towel_pending)
        (add_towel_done)
        (add_bread_pending)
        (add_bread_done)
    )
    (:durative-action do_store_cookies
        :parameters ()
        :duration (= ?duration 300)
        :condition (at start (store_cookies_pending))
        :effect (and (at start (not (store_cookies_pending))) (at end (store_cookies_done)))
    )
    (:durative-action do_add_towel
        :parameters ()
        :duration (= ?duration 600)
        :condition (and (at start (add_towel_pending)) (at start (store_cookies_done)))
        :effect (and (at start (not (add_towel_pending))) (at end (add_towel_done)))
    )
    (:durative-action do_add_bread
        :parameters ()
        :duration (= ?duration 86400)
        :condition (and (at start (add_bread_pending)) (at start (store_cookies_done)))
        :effect (and (at start (not (add_bread_pending))) (at end (add_bread_done)))
    )
)
