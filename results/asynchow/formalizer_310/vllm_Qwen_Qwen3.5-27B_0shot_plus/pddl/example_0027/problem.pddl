(define (problem bus_wait_problem)
  (:domain bus_wait_domain)
  (:init
    (think_destination_pending)
    (lookup_bus_pending)
    (map_bus_stop_pending)
    (walk_to_stop_pending)
    (buy_pass_pending)
    (collect_pass_pending)
    (check_bus_time_pending)
  )
  (:goal (and
    (think_destination_done)
    (lookup_bus_done)
    (map_bus_stop_done)
    (walk_to_stop_done)
    (buy_pass_done)
    (collect_pass_done)
    (check_bus_time_done)
  ))
)
