(define (domain art_project)
  (:requirements :durative-actions)
  (:predicates
    (gather_materials_pending)
    (gather_materials_done)
    (make_caddy_pending)
    (make_caddy_done)
    (make_drum_pending)
    (make_drum_done)
    (make_bowling_pending)
    (make_bowling_done)
  )
  (:durative-action do_gather_materials
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (gather_materials_pending))
    :effect (and (at start (not (gather_materials_pending))) (at end (gather_materials_done)))
  )
  (:durative-action do_make_caddy
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (make_caddy_pending)) (at start (gather_materials_done)))
    :effect (and (at start (not (make_caddy_pending))) (at end (make_caddy_done)))
  )
  (:durative-action do_make_drum
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (make_drum_pending)) (at start (gather_materials_done)))
    :effect (and (at start (not (make_drum_pending))) (at end (make_drum_done)))
  )
  (:durative-action do_make_bowling
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (make_bowling_pending)) (at start (gather_materials_done)))
    :effect (and (at start (not (make_bowling_pending))) (at end (make_bowling_done)))
  )
)