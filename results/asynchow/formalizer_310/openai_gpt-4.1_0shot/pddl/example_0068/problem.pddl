(define (problem get_working_computer-problem)
  (:domain get_working_computer)
  (:init
    (research_pending)
    (save_pending)
    (goto_website_pending)
    (purchase_pending)
    (wait_sale_pending)
  )
  (:goal (and
    (research_done)
    (save_done)
    (goto_website_done)
    (purchase_done)
    (wait_sale_done)
  ))
)
