(define (domain breakfast)
  (:requirements :durative-actions)
  (:predicates
    (put_frying_pan_on_stove_pending)
    (put_frying_pan_on_stove_done)
    (take_ingredients_out_of_fridge_pending)
    (take_ingredients_out_of_fridge_done)
    (put_butter_in_pan_pending)
    (put_butter_in_pan_done)
    (turn_stove_on_pending)
    (turn_stove_on_done)
    (add_egg_to_pan_pending)
    (add_egg_to_pan_done)
    (cook_egg_pending)
    (cook_egg_done)
    (serve_and_enjoy_pending)
    (serve_and_enjoy_done)
  )

  (:durative-action put_frying_pan_on_stove
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (put_frying_pan_on_stove_pending))
    :effect (and (at start (not (put_frying_pan_on_stove_pending)))
                 (at end (put_frying_pan_on_stove_done)))
  )

  (:durative-action take_ingredients_out_of_fridge
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (take_ingredients_out_of_fridge_pending))
    :effect (and (at start (not (take_ingredients_out_of_fridge_pending)))
                 (at end (take_ingredients_out_of_fridge_done)))
  )

  (:durative-action put_butter_in_pan
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (put_butter_in_pan_pending))
                    (at start (put_frying_pan_on_stove_done))
                    (at start (take_ingredients_out_of_fridge_done)))
    :effect (and (at start (not (put_butter_in_pan_pending)))
                 (at end (put_butter_in_pan_done)))
  )

  (:durative-action turn_stove_on
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (turn_stove_on_pending))
                    (at start (put_butter_in_pan_done)))
    :effect (and (at start (not (turn_stove_on_pending)))
                 (at end (turn_stove_on_done)))
  )

  (:durative-action add_egg_to_pan
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (add_egg_to_pan_pending))
                    (at start (turn_stove_on_done)))
    :effect (and (at start (not (add_egg_to_pan_pending)))
                 (at end (add_egg_to_pan_done)))
  )

  (:durative-action cook_egg
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (cook_egg_pending))
                    (at start (add_egg_to_pan_done)))
    :effect (and (at start (not (cook_egg_pending)))
                 (at end (cook_egg_done)))
  )

  (:durative-action serve_and_enjoy
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (serve_and_enjoy_pending))
                    (at start (cook_egg_done)))
    :effect (and (at start (not (serve_and_enjoy_pending)))
                 (at end (serve_and_enjoy_done)))
  )
)
