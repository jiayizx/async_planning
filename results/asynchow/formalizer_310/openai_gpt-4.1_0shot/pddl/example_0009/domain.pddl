(define (domain vacation)
  (:requirements :durative-actions)
  (:predicates
    (look_at_hotel_prices_pending)
    (look_at_hotel_prices_done)
    (look_at_flights_pending)
    (look_at_flights_done)
    (buy_plane_tickets_pending)
    (buy_plane_tickets_done)
    (go_to_airport_pending)
    (go_to_airport_done)
    (board_plane_pending)
    (board_plane_done)
    (book_hotel_pending)
    (book_hotel_done)
  )

  (:durative-action look_at_hotel_prices
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (look_at_hotel_prices_pending))
    :effect (and (at start (not (look_at_hotel_prices_pending)))
                 (at end (look_at_hotel_prices_done)))
  )

  (:durative-action look_at_flights
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (look_at_flights_pending))
    :effect (and (at start (not (look_at_flights_pending)))
                 (at end (look_at_flights_done)))
  )

  (:durative-action buy_plane_tickets
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (buy_plane_tickets_pending))
                    (at start (look_at_flights_done)))
    :effect (and (at start (not (buy_plane_tickets_pending)))
                 (at end (buy_plane_tickets_done)))
  )

  (:durative-action go_to_airport
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (go_to_airport_pending))
                    (at start (buy_plane_tickets_done))
                    (at start (book_hotel_done)))
    :effect (and (at start (not (go_to_airport_pending)))
                 (at end (go_to_airport_done)))
  )

  (:durative-action board_plane
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (board_plane_pending))
                    (at start (go_to_airport_done)))
    :effect (and (at start (not (board_plane_pending)))
                 (at end (board_plane_done)))
  )

  (:durative-action book_hotel
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (book_hotel_pending))
                    (at start (look_at_hotel_prices_done)))
    :effect (and (at start (not (book_hotel_pending)))
                 (at end (book_hotel_done)))
  )
)
