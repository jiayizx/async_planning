(define (problem sim_card_replacement_problem)
  (:domain sim_card_replacement)
  (:init
    (get_sim_card_pending)
    (get_screw_driver_pending)
    (unscrew_back_pending)
    (remove_back_pending)
    (install_new_sim_pending)
    (screw_back_in_pending)
    (remove_old_sim_pending)
  )
  (:goal (and
    (get_sim_card_done)
    (get_screw_driver_done)
    (unscrew_back_done)
    (remove_back_done)
    (install_new_sim_done)
    (screw_back_in_done)
    (remove_old_sim_done)
  ))
)
