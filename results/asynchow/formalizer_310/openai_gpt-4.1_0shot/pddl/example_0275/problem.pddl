(define (problem shrink_rings-problem)
  (:domain shrink_rings)
  (:init
    (clean_ring_pending)
    (apply_silicone_pending)
    (smooth_silicone_pending)
    (dry_silicone_pending)
    (try_ring_pending)
  )
  (:goal (and
    (clean_ring_done)
    (apply_silicone_done)
    (smooth_silicone_done)
    (dry_silicone_done)
    (try_ring_done)
  ))
)
