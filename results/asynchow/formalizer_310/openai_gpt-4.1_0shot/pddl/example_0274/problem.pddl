(define (problem know_if_double_jointed)
  (:domain double_jointed)
  (:init
    (pinky_lift_pending)
    (thumb_push_pending)
    (elbow_open_pending)
    (knee_extend_pending)
    (palms_floor_pending)
    (total_points_pending)
  )
  (:goal (and
    (pinky_lift_done)
    (thumb_push_done)
    (elbow_open_done)
    (knee_extend_done)
    (palms_floor_done)
    (total_points_done)
  ))
)
