(define (domain camping)
  (:requirements :durative-actions)
  (:predicates
    (buy_camping_equipment_pending)
    (buy_camping_equipment_done)
    (pick_camping_site_pending)
    (pick_camping_site_done)
    (pack_camping_equipment_pending)
    (pack_camping_equipment_done)
    (drive_to_camping_site_pending)
    (drive_to_camping_site_done)
    (park_car_pending)
    (park_car_done)
    (enter_camping_site_pending)
    (enter_camping_site_done)
  )

  (:durative-action buy_camping_equipment
    :parameters ()
    :duration (= ?duration 7200)
    :condition (at start (buy_camping_equipment_pending))
    :effect (and (at start (not (buy_camping_equipment_pending)))
                 (at end (buy_camping_equipment_done)))
  )

  (:durative-action pick_camping_site
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (pick_camping_site_pending))
    :effect (and (at start (not (pick_camping_site_pending)))
                 (at end (pick_camping_site_done)))
  )

  (:durative-action pack_camping_equipment
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (pack_camping_equipment_pending))
                    (at start (buy_camping_equipment_done))
                    (at start (pick_camping_site_done)))
    :effect (and (at start (not (pack_camping_equipment_pending)))
                 (at end (pack_camping_equipment_done)))
  )

  (:durative-action drive_to_camping_site
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (drive_to_camping_site_pending))
                    (at start (pack_camping_equipment_done)))
    :effect (and (at start (not (drive_to_camping_site_pending)))
                 (at end (drive_to_camping_site_done)))
  )

  (:durative-action park_car
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (park_car_pending))
                    (at start (drive_to_camping_site_done)))
    :effect (and (at start (not (park_car_pending)))
                 (at end (park_car_done)))
  )

  (:durative-action enter_camping_site
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (enter_camping_site_pending))
                    (at start (park_car_done)))
    :effect (and (at start (not (enter_camping_site_pending)))
                 (at end (enter_camping_site_done)))
  )
)
