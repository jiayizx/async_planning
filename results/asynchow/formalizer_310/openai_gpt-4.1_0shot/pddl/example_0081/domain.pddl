(define (domain vacation)
  (:requirements :durative-actions)
  (:predicates
    (research_trip_pending)
    (research_trip_done)
    (plan_budget_pending)
    (plan_budget_done)
    (invite_others_pending)
    (invite_others_done)
    (split_cost_pending)
    (split_cost_done)
    (meet_at_airport_pending)
    (meet_at_airport_done)
  )

  (:durative-action research_trip
    :parameters ()
    :duration (= ?duration 14400)
    :condition (at start (research_trip_pending))
    :effect (and (at start (not (research_trip_pending)))
                 (at end (research_trip_done)))
  )

  (:durative-action plan_budget
    :parameters ()
    :duration (= ?duration 14400)
    :condition (and (at start (plan_budget_pending))
                    (at start (research_trip_done)))
    :effect (and (at start (not (plan_budget_pending)))
                 (at end (plan_budget_done)))
  )

  (:durative-action invite_others
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (invite_others_pending))
                    (at start (plan_budget_done)))
    :effect (and (at start (not (invite_others_pending)))
                 (at end (invite_others_done)))
  )

  (:durative-action split_cost
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (split_cost_pending))
                    (at start (plan_budget_done)))
    :effect (and (at start (not (split_cost_pending)))
                 (at end (split_cost_done)))
  )

  (:durative-action meet_at_airport
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (meet_at_airport_pending))
                    (at start (invite_others_done))
                    (at start (split_cost_done)))
    :effect (and (at start (not (meet_at_airport_pending)))
                 (at end (meet_at_airport_done)))
  )
)
