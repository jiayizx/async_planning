(define (domain italian_greyhound_den)
  (:requirements :durative-actions)
  (:predicates
    (find_materials_pending)
    (find_materials_done)
    (make_case_pending)
    (make_case_done)
    (cut_item_pending)
    (cut_item_done)
    (sew_together_pending)
    (sew_together_done)
    (get_pet_used_pending)
    (get_pet_used_done)
  )

  (:durative-action find_materials
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (find_materials_pending))
    :effect (and (at start (not (find_materials_pending)))
                 (at end (find_materials_done)))
  )

  (:durative-action make_case
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (make_case_pending))
                    (at start (find_materials_done)))
    :effect (and (at start (not (make_case_pending)))
                 (at end (make_case_done)))
  )

  (:durative-action cut_item
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (cut_item_pending))
                    (at start (find_materials_done)))
    :effect (and (at start (not (cut_item_pending)))
                 (at end (cut_item_done)))
  )

  (:durative-action sew_together
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (sew_together_pending))
                    (at start (make_case_done))
                    (at start (cut_item_done)))
    :effect (and (at start (not (sew_together_pending)))
                 (at end (sew_together_done)))
  )

  (:durative-action get_pet_used
    :parameters ()
    :duration (= ?duration 1209600)
    :condition (and (at start (get_pet_used_pending))
                    (at start (sew_together_done)))
    :effect (and (at start (not (get_pet_used_pending)))
                 (at end (get_pet_used_done)))
  )
)
