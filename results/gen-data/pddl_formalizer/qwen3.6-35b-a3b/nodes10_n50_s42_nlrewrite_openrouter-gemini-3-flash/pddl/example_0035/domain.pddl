(define (domain knitting_domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (pattern_calculated)
    (needles_purchased)
    (main_body_knit)
    (initial_row_cast_on)
    (loose_ends_woven)
    (yarn_bought)
    (yarn_balls_wound)
    (blocking_researched)
    (swatch_washed)
    (blanket_steam_blocked))
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 2700)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (pattern_calculated))))
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (needles_purchased))))
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 144000)
    :condition (and (at start (step_pending ?s))
                    (at start (initial_row_cast_on)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (main_body_knit))))
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending ?s))
                    (at start (yarn_bought))
                    (at start (needles_purchased)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (initial_row_cast_on))))
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s))
                    (at start (main_body_knit))
                    (at start (yarn_balls_wound)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (loose_ends_woven))))
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s))
                    (at start (pattern_calculated)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (yarn_bought))))
  (:durative-action do_step7
    :parameters (?s - step)
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s))
                    (at start (needles_purchased))
                    (at start (yarn_bought))
                    (at start (swatch_washed)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (yarn_balls_wound))))
  (:durative-action do_step8
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (blocking_researched))))
  (:durative-action do_step9
    :parameters (?s - step)
    :duration (= ?duration 86400)
    :condition (and (at start (step_pending ?s))
                    (at start (yarn_bought)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (swatch_washed))))
  (:durative-action do_step10
    :parameters (?s - step)
    :duration (= ?duration 21600)
    :condition (and (at start (step_pending ?s))
                    (at start (main_body_knit))
                    (at start (blocking_researched)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (blanket_steam_blocked))))
)