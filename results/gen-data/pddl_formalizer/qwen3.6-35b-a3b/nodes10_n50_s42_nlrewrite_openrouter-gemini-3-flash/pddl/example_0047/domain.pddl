(define (domain convert_kg_to_lbs)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (scale_located)
               (weight_recorded)
               (calc_app_open)
               (factor_typed)
               (weight_read)
               (formula_found)
               (calculation_done)
               (calibration_checked)
               (history_cleared)
               (pen_logbook_found))
  (:durative-action do_step1 (?s - step)
    :duration 120
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (scale_located))))
  (:durative-action do_step2 (?s - step)
    :duration 30
    :condition (and (at start (step_pending ?s))
                    (at start (calculation_done))
                    (at start (pen_logbook_found)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (weight_recorded))))
  (:durative-action do_step3 (?s - step)
    :duration 5
    :condition (and (at start (step_pending ?s))
                    (at start (formula_found)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (calc_app_open))))
  (:durative-action do_step4 (?s - step)
    :duration 10
    :condition (and (at start (step_pending ?s))
                    (at start (calc_app_open)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (factor_typed))))
  (:durative-action do_step5 (?s - step)
    :duration 15
    :condition (and (at start (step_pending ?s))
                    (at start (scale_located)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (weight_read))))
  (:durative-action do_step6 (?s - step)
    :duration 60
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (formula_found))))
  (:durative-action do_step7 (?s - step)
    :duration 20
    :condition (and (at start (step_pending ?s))
                    (at start (factor_typed))
                    (at start (weight_read))
                    (at start (formula_found)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (calculation_done))))
  (:durative-action do_step8 (?s - step)
    :duration 45
    :condition (and (at start (step_pending ?s))
                    (at start (weight_read)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (calibration_checked))))
  (:durative-action do_step9 (?s - step)
    :duration 5
    :condition (and (at start (step_pending ?s))
                    (at start (weight_read))
                    (at start (formula_found))
                    (at start (calculation_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (history_cleared))))
  (:durative-action do_step10 (?s - step)
    :duration 60
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (pen_logbook_found))))
)