(define (domain kwanzaa)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates 
    (step_pending_step1) (step_done_step1) (step1_done)
    (step_pending_step2) (step_done_step2) (step2_done)
    (step_pending_step3) (step_done_step3) (step3_done)
