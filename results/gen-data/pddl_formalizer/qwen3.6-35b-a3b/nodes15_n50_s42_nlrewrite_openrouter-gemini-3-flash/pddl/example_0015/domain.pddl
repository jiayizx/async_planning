(define (domain hoarse_voice)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (purchase_humidifier_done)
    (tea_steeped_done)
    (gargle_done)
    (broth_prepared_done)
    (water_boiled_done)
    (honey_taken_done)
    (vocal_rest_done)
    (voice_reassessed_done)
    (liquids_drunk_done)
    (exercises_researched_done)
    (saline_mixed_done)
    (humming_done)
    (compress_applied_done)
    (water_poured_done)
    (humidifier_setup_done))
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (purchase_humidifier_done))))
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (water_boiled_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (tea_steeped_done))))
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (saline_mixed_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (gargle_done))))
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (broth_prepared_done))))
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (water_poured_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (water_boiled_done))))
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (gargle_done)) (at start (humming_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (honey_taken_done))))
  (:durative-action do_step7
    :parameters (?s - step)
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending ?s)) (at start (tea_steeped_done)) (at start (honey_taken_done)) (at start (exercises_researched_done)) (at start (humidifier_setup_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (vocal_rest_done))))
  (:durative-action do_step8
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (vocal_rest_done)) (at start (exercises_researched_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (voice_reassessed_done))))
  (:durative-action do_step9
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (broth_prepared_done)) (at start (humidifier_setup_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (liquids_drunk_done))))
  (:durative-action do_step10
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (exercises_researched_done))))
  (:durative-action do_step11
    :parameters (?s - step)
    :duration (= ?duration 180)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (saline_mixed_done))))
  (:durative-action do_step12
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (exercises_researched_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (humming_done))))
  (:durative-action do_step13
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s)) (at start (saline_mixed_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (compress_applied_done))))
  (:durative-action do_step14
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (humidifier_setup_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (water_poured_done))))
  (:durative-action do_step15
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (purchase_humidifier_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (humidifier_setup_done))))
)