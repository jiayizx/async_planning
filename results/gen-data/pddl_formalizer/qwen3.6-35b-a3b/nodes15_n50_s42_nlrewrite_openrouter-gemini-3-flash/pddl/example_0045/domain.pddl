(define (domain cake_pancakes)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (dry_mixed)
    (flour_measured)
    (butter_melted)
    (butter_retrieved)
    (batter_poured)
    (sprinkles_folded)
    (wet_dry_stirred)
    (bowls_retrieved)
    (batter_resting)
    (eggs_cracked)
    (eggs_beaten)
    (cocoa_sifted)
    (butter_milk_combined)
    (eggs_milk_added)
    (counter_cleaned))
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step1)) (at start (flour_measured)) (at start (counter_cleaned)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (dry_mixed))))
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step2)) (at start (bowls_retrieved)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (flour_measured))))
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 45)
    :condition (and (at start (step_pending step3)) (at start (butter_retrieved)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (butter_melted))))
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 30)
    :condition (at start (step_pending step4))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (butter_retrieved))))
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step5)) (at start (batter_resting)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (batter_poured))))
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step6)) (at start (wet_dry_stirred)) (at start (butter_milk_combined)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (sprinkles_folded))))
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step7)) (at start (butter_milk_combined)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (wet_dry_stirred))))
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step8))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (bowls_retrieved))))
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step9)) (at start (eggs_milk_added)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (batter_resting))))
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step10)) (at start (counter_cleaned)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (eggs_cracked))))
  (:durative-action do_step11
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step11)) (at start (bowls_retrieved)) (at start (eggs_cracked)))
    :effect (and (at start (not (step_pending step11))) (at end (step_done step11)) (at end (eggs_beaten))))
  (:durative-action do_step12
    :parameters ()
    :duration (= ?duration 240)
    :condition (and (at start (step_pending step12)) (at start (dry_mixed)) (at start (counter_cleaned)))
    :effect (and (at start (not (step_pending step12))) (at end (step_done step12)) (at end (cocoa_sifted))))
  (:durative-action do_step13
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step13)) (at start (butter_melted)))
    :effect (and (at start (not (step_pending step13))) (at end (step_done step13)) (at end (butter_milk_combined))))
  (:durative-action do_step14
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step14)) (at start (eggs_cracked)) (at start (cocoa_sifted)))
    :effect (and (at start (not (step_pending step14))) (at end (step_done step14)) (at end (eggs_milk_added))))
  (:durative-action do_step15
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step_pending step15))
    :effect (and (at start (not (step_pending step15))) (at end (step_done step15)) (at end (counter_cleaned)))))