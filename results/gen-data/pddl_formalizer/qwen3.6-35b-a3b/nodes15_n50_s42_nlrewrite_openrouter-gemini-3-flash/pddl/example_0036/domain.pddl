(define (domain lox)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_done ?s - step) (step_pending ?s - step)
               (slice_done) (buy_salmon_done) (rub_mixture_done) (weigh_down_done)
               (remove_bones_done) (toast_bagels_done) (buy_bagels_done) (mix_seasoning_done)
               (clear_shelf_done) (line_dish_done) (rinse_salmon_done) (place_salmon_done)
               (cure_salmon_done) (prepare_garnish_done) (wrap_fish_done))
  (:durative-action do_step1
    (:parameters (?s - step))
    (:duration 600)
    (:condition (and (at start (step_pending ?s)) (at start (buy_salmon_done)) (at start (remove_bones_done)) (at start (cure_salmon_done))))
    (:effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (slice_done)))))
  (:durative-action do_step2
    (:parameters (?s - step))
    (:duration 1800)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (buy_salmon_done)))))
  (:durative-action do_step3
    (:parameters (?s - step))
    (:duration 900)
    (:condition (and (at start (step_pending ?s)) (at start (mix_seasoning_done))))
    (:effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (rub_mixture_done)))))
