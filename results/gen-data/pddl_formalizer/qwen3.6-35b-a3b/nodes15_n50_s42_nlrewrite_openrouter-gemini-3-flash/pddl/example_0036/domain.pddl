    (:duration 300)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (mix_seasoning_done)))))
  (:durative-action do_step9
    (:parameters (?s - step))
    (:duration 600)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (clear_shelf_done)))))
  (:durative-action do_step10
