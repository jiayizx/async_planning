    (step_done ?s - step)
    (footwear_purchased)
    (rulebook_reviewed)
    (field_rented)
    (leagues_researched)
    (orientation_attended)
    (waiver_signed)
    (goals_set)
    (ball_bought)
    (water_filled)
    (registered)
    (bag_packed)
