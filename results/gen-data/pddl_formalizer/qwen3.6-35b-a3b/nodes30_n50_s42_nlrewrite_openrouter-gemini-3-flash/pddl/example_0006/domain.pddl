  (:durative-action do_step1 (:parameters (?s - step))
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s)) (at start (leagues_researched)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (footwear_purchased))))

