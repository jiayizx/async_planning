(define (domain caring_for_boxers)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (water_bowls_filled)
    (dietary_requirements_researched)
    (arrived_at_dog_park)
    (vet_exam_scheduled)
    (raw_meal_prepared)
    (heavy_duty_bowls_purchased)
    (feeding_area_cleaned)
    (medical_clearance_received)
    (fetch_engaged)
    (premium_kibble_purchased)
    (water_dispenser_sanitized)
    (vet_appointment_attended)
    (flea_tick_preventative_applied)
    (feeding_station_set_up)
    (dog_brushed)
    (dog_weight_measured)
    (dog_monitored_eating)
    (bag_packed)
    (nutritionist_consulted)
    (grooming_medical_kit_ordered)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step1)) (at start (heavy_duty_bowls_purchased)) (at start (water_dispenser_sanitized)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (water_bowls_filled)))
  )
