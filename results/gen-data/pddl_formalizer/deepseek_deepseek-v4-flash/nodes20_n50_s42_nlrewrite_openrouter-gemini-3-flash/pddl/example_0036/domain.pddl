(define (domain dog_birthday_party)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (invitations_sent)
    (bakeries_researched)
    (backyard_setup)
    (dog_bathed)
    (bandana_hat_purchased)
    (guest_list_created)
    (headcount_confirmed)
    (toys_shopped)
    (neighbors_messaged)
    (theme_decided)
    (banner_ordered)
    (pupcake_ordered)
    (games_drafted)
    (contest_printed)
    (hat_on_dog)
    (shampoo_bought)
    (banner_arrived)
    (weather_checked)
    (date_venue_finalized)
    (backyard_cleared)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step1)) (at start (guest_list_created)) (at start (date_venue_finalized)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (invitations_sent)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step2)) (at start (theme_decided)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (bakeries_researched)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 10800)
    :condition (and (at start (step_pending step3)) (at start (backyard_cleared)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (backyard_setup)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending step4)) (at start (shampoo_bought)) (at start (weather_checked)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (dog_bathed)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (step_pending step5))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (bandana_hat_purchased)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (step_pending step6))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (guest_list_created)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 172800)
    :condition (and (at start (step_pending step7)) (at start (invitations_sent)) (at start (guest_list_created)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (headcount_confirmed)))
  )
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step8)) (at start (theme_decided)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (toys_shopped)))
  )
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 900)
