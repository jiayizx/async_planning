  )
  (:durative-action do_step11
    :parameters ()
    :duration (= ?duration 432000)
    :condition (and (at start (step_pending step11)) (at start (theme_decided)))
    :effect (and (at start (not (step_pending step11))) (at end (step_done step11)) (at end (banner_ordered)))
  )
  (:durative-action do_step12
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step12)) (at start (bakeries_researched)) (at start (banner_arrived)) (at start (weather_checked)))
