    :condition (and (at start (step_pending step15)) (at start (dog_bathed)) (at start (bandana_hat_purchased)) (at start (backyard_cleared)))
    :effect (and (at start (not (step_pending step15))) (at end (step_done step15)) (at end (hat_on_dog)))
