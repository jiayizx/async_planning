    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step18))
    :effect (and (at start (not (step_pending step18))) (at end (step_done step18)) (at end (weather_checked)))
  )
  (:durative-action do_step19
    :parameters ()
    :duration (= ?duration 86400)
    :condition (and (at start (step_pending step19)) (at start (bakeries_researched)) (at start (neighbors_messaged)))
    :effect (and (at start (not (step_pending step19))) (at end (step_done step19)) (at end (date_venue_finalized)))
  )
  (:durative-action do_step20
    :parameters ()
    :duration (= ?duration 7200)
