(define (domain breakfast)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (plate_meal_done)
    (sit_eat_done)
    (retrieve_ingredients_done)
    (garnish_herbs_done)
    (boil_water_done)
    (slice_bread_done)
    (wash_spinach_done)
    (saute_spinach_done)
    (measure_oats_done)
    (bring_milk_simmer_done)
    (steep_tea_done)
    (grind_coffee_done)
    (drop_eggs_done)
    (mix_honey_oats_done)
    (drain_eggs_done)
    (slice_avocado_done)
    (mash_avocado_done)
    (select_avocado_done)
    (peel_banana_done)
    (season_eggs_done)
    (place_eggs_on_toast_done)
    (pour_oj_done)
    (sprinkle_pepper_flakes_done)
    (slice_banana_done)
    (dry_spinach_done)
    (toast_bread_done)
    (brew_coffee_done)
    (set_table_done)
    (heat_teapot_done)
    (pour_tea_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step1)) (at start (slice_bread_done)) (at start (toast_bread_done)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (plate_meal_done)))
  )
