(define (domain educational_word_slider)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step1_pending)
    (step1_done)
    (design_done)
    (step2_pending)
    (step2_done)
    (print_done)
    (step3_pending)
    (step3_done)
    (assemble_done)
    (step4_pending)
    (step4_done)
    (slit_cut_done)
    (step5_pending)
    (step5_done)
    (laminate_done)
    (step6_pending)
    (step6_done)
    (measure_done)
    (step7_pending)
    (step7_done)
    (strips_cut_done)
    (step8_pending)
    (step8_done)
    (select_done)
    (step9_pending)
    (step9_done)
    (write_done)
    (step10_pending)
    (step10_done)
    (thread_done)
  )
  (:durative-action do_step1
    :duration ( = ?duration 1200 )
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending)))
                 (at end (step1_done))
                 (at end (design_done)))
  )
  (:durative-action do_step2
    :duration ( = ?duration 300 )
    :condition (and (at start (step2_pending))
                    (at start (write_done)))
    :effect (and (at start (not (step2_pending)))
                 (at end (step2_done))
                 (at end (print_done)))
  )
  (:durative-action do_step3
    :duration ( = ?duration 900 )
    :condition (and (at start (step3_pending))
                    (at start (design_done))
                    (at start (slit_cut_done))
                    (at start (strips_cut_done)))
    :effect (and (at start (not (step3_pending)))
                 (at end (step3_done))
                 (at end (assemble_done)))
  )
  (:durative-action do_step4
    :duration ( = ?duration 600 )
    :condition (and (at start (step4_pending))
                    (at start (measure_done)))
    :effect (and (at start (not (step4_pending)))
                 (at end (step4_done))
                 (at end (slit_cut_done)))
  )
  (:durative-action do_step5
    :duration ( = ?duration 600 )
    :condition (and (at start (step5_pending))
                    (at start (thread_done)))
    :effect (and (at start (not (step5_pending)))
                 (at end (step5_done))
                 (at end (laminate_done)))
  )
  (:durative-action do_step6
    :duration ( = ?duration 300 )
    :condition (and (at start (step6_pending))
                    (at start (design_done)))
    :effect (and (at start (not (step6_pending)))
                 (at end (step6_done))
                 (at end (measure_done)))
  )
  (:durative-action do_step7
    :duration ( = ?duration 480 )
    :condition (and (at start (step7_pending))
                    (at start (select_done)))
    :effect (and (at start (not (step7_pending)))
                 (at end (step7_done))
                 (at end (strips_cut_done)))
  )
  (:durative-action do_step8
    :duration ( = ?duration 1800 )
    :condition (at start (step8_pending))
    :effect (and (at start (not (step8_pending)))
                 (at end (step8_done))
                 (at end (select_done)))
  )
  (:durative-action do_step9
    :duration ( = ?duration 720 )
    :condition (and (at start (step9_pending))
                    (at start (strips_cut_done)))
    :effect (and (at start (not (step9_pending)))
                 (at end (step9_done))
                 (at end (write_done)))
  )
  (:durative-action do_step10
    :duration ( = ?duration 240 )
    :condition (and (at start (step10_pending))
                    (at start (print_done))
                    (at start (assemble_done)))
    :effect (and (at start (not (step10_pending)))
                 (at end (step10_done))
                 (at end (thread_done)))
  )
)