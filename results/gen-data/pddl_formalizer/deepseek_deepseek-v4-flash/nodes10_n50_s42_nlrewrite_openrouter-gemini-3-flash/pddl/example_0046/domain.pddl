(define (domain marathon)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (shoes_purchased)
    (base_training_completed)
    (long_run_completed)
    (rested)
    (carbo_loaded)
    (health_clearance_obtained)
    (registered_online)
    (research_done)
    (bib_picked_up)
    (marathon_run)
  )
  (:durative-action do_step1 ()
    :duration (= ?duration 2700)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (shoes_purchased)))
  )
  (:durative-action do_step2 ()
    :duration (= ?duration 6048000)
    :condition (and (at start (step_pending step2)) (at start (health_clearance_obtained)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (base_training_completed)))
  )
  (:durative-action do_step3 ()
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending step3)) (at start (base_training_completed)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (long_run_completed)))
  )
  (:durative-action do_step4 ()
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending step4)) (at start (carbo_loaded)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (rested)))
  )
  (:durative-action do_step5 ()
    :duration (= ?duration 172800)
    :condition (and (at start (step_pending step5)) (at start (long_run_completed)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (carbo_loaded)))
  )
  (:durative-action do_step6 ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step6)) (at start (research_done)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (health_clearance_obtained)))
  )
  (:durative-action do_step7 ()
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending step7)) (at start (research_done)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (registered_online)))
  )
  (:durative-action do_step8 ()
    :duration (= ?duration 7200)
    :condition (at start (step_pending step8))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (research_done)))
  )
  (:durative-action do_step9 ()
    :duration (= ?duration 5400)
    :condition (and (at start (step_pending step9)) (at start (shoes_purchased)) (at start (registered_online)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (bib_picked_up)))
  )
  (:durative-action do_step10 ()
    :duration (= ?duration 18000)
    :condition (and (at start (step_pending step10)) (at start (rested)) (at start (bib_picked_up)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (marathon_run)))
  )
)