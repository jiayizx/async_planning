(define (domain kwanzaa)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (finished ?s - step)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step1)) (at start (finished step9)))
    :effect (and (at start (not (step_pending step1))) (at end (finished step1)))
  )
  (:durative-action do_step2
