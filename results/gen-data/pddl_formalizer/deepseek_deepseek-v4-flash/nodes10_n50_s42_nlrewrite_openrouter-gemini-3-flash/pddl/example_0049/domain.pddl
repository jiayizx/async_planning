(define (domain herbarium)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (p_done ?s - step)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending step1)) (at start (p_done step3)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (p_done step1)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (p_done step2)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 7200)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (p_done step3)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step4)) (at start (p_done step2)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (p_done step4)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step5)) (at start (p_done step1)) (at start (p_done step3)) (at start (p_done step6)) (at start (p_done step9)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (p_done step5)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending step6)) (at start (p_done step1)) (at start (p_done step3)) (at start (p_done step9)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (p_done step6)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending step7)) (at start (p_done step1)) (at start (p_done step2)) (at start (p_done step3)) (at start (p_done step8)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (p_done step7)))
  )
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending step8)) (at start (p_done step2)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (p_done step8)))
  )
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step9)) (at start (p_done step1)) (at start (p_done step3)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (p_done step9)))
  )
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step10)) (at start (p_done step2)) (at start (p_done step4)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (p_done step10)))
  )
)