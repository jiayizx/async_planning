(define (domain posture_improvement)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (seated_cable_rows_done)
    (scapular_retraction_done)
    (resistance_bands_purchased)
    (doorway_chest_stretch_done)
    (physical_therapist_consult_done)
    (instructional_video_watched)
    (workout_video_recorded)
    (rowing_motion_practice_done)
    (face_pulls_warmup_done)
    (equipment_adjusted_done)
  )
  (:durative-action do_step5
    :duration (= ?duration 3600)
    :condition (at start (step_pending step5))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (physical_therapist_consult_done)))
  )
  (:durative-action do_step6
    :duration (= ?duration 600)
    :condition (at start (step_pending step6))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (instructional_video_watched)))
  )
  (:durative-action do_step3
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step3)) (at start (physical_therapist_consult_done)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (resistance_bands_purchased)))
  )
  (:durative-action do_step2
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending step2)) (at start (resistance_bands_purchased)) (at start (physical_therapist_consult_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (scapular_retraction_done)))
  )
  (:durative-action do_step8
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step8)) (at start (scapular_retraction_done)) (at start (resistance_bands_purchased)) (at start (physical_therapist_consult_done)) (at start (instructional_video_watched)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (rowing_motion_practice_done)))
  )
  (:durative-action do_step9
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step9)) (at start (scapular_retraction_done)) (at start (resistance_bands_purchased)) (at start (physical_therapist_consult_done)) (at start (instructional_video_watched)) (at start (rowing_motion_practice_done)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (face_pulls_warmup_done)))
  )
  (:durative-action do_step10
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step10)) (at start (scapular_retraction_done)) (at start (resistance_bands_purchased)) (at start (physical_therapist_consult_done)) (at start (instructional_video_watched)) (at start (rowing_motion_practice_done)) (at start (face_pulls_warmup_done)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (equipment_adjusted_done)))
  )
  (:durative-action do_step1
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step1)) (at start (scapular_retraction_done)) (at start (resistance_bands_purchased)) (at start (physical_therapist_consult_done)) (at start (instructional_video_watched)) (at start (rowing_motion_practice_done)) (at start (face_pulls_warmup_done)) (at start (equipment_adjusted_done)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (seated_cable_rows_done)))
  )
  (:durative-action do_step4
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step4)) (at start (seated_cable_rows_done)) (at start (scapular_retraction_done)) (at start (resistance_bands_purchased)) (at start (physical_therapist_consult_done)) (at start (instructional_video_watched)) (at start (rowing_motion_practice_done)) (at start (face_pulls_warmup_done)) (at start (equipment_adjusted_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (doorway_chest_stretch_done)))
  )
  (:durative-action do_step7
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step7)) (at start (seated_cable_rows_done)) (at start (scapular_retraction_done)) (at start (resistance_bands_purchased)) (at start (doorway_chest_stretch_done)) (at start (physical_therapist_consult_done)) (at start (instructional_video_watched)) (at start (rowing_motion_practice_done)) (at start (face_pulls_warmup_done)) (at start (equipment_adjusted_done)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (workout_video_recorded)))
  )
)