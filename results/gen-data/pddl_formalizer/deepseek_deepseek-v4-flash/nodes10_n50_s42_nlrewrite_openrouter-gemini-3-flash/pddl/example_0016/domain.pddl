(define (domain guppy)
  (:requirements :durative-actions :typing)
  (:types step - object)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (treated_water)
    (acclimated_guppies)
    (purchased_aquarium)
    (observed_fish)
    (cycled_tank)
    (tested_water)
    (introduced_guppies)
    (performed_water_change)
    (set_up_tank)
    (researched_breed)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 900)
    :condition (and
      (at start (step_pending step1))
      (at start (acclimated_guppies))
      (at start (purchased_aquarium))
      (at start (cycled_tank))
      (at start (tested_water))
      (at start (introduced_guppies))
      (at start (set_up_tank))
    )
    :effect (and
      (at start (not (step_pending step1)))
      (at end (step_done step1))
      (at end (treated_water))
    )
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and
      (at start (step_pending step2))
      (at start (purchased_aquarium))
      (at start (cycled_tank))
      (at start (tested_water))
      (at start (set_up_tank))
    )
    :effect (and
      (at start (not (step_pending step2)))
      (at end (step_done step2))
      (at end (acclimated_guppies))
    )
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 7200)
    :condition (at start (step_pending step3))
    :effect (and
      (at start (not (step_pending step3)))
      (at end (step_done step3))
      (at end (purchased_aquarium))
    )
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 259200)
    :condition (and
      (at start (step_pending step4))
      (at start (researched_breed))
    )
    :effect (and
      (at start (not (step_pending step4)))
      (at end (step_done step4))
      (at end (observed_fish))
    )
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 1209600)
    :condition (and
      (at start (step_pending step5))
      (at start (purchased_aquarium))
      (at start (set_up_tank))
    )
    :effect (and
      (at start (not (step_pending step5)))
      (at end (step_done step5))
      (at end (cycled_tank))
    )
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 600)
    :condition (and
      (at start (step_pending step6))
      (at start (purchased_aquarium))
      (at start (cycled_tank))
      (at start (set_up_tank))
    )
    :effect (and
      (at start (not (step_pending step6)))
      (at end (step_done step6))
      (at end (tested_water))
    )
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 300)
    :condition (and
      (at start (step_pending step7))
      (at start (acclimated_guppies))
      (at start (purchased_aquarium))
      (at start (cycled_tank))
      (at start (tested_water))
      (at start (set_up_tank))
    )
    :effect (and
      (at start (not (step_pending step7)))
      (at end (step_done step7))
      (at end (introduced_guppies))
    )
  )
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and
      (at start (step_pending step8))
      (at start (treated_water))
      (at start (acclimated_guppies))
      (at start (purchased_aquarium))
      (at start (cycled_tank))
      (at start (tested_water))
      (at start (introduced_guppies))
      (at start (set_up_tank))
    )
    :effect (and
      (at start (not (step_pending step8)))
      (at end (step_done step8))
      (at end (performed_water_change))
    )
  )
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and
      (at start (step_pending step9))
      (at start (purchased_aquarium))
    )
    :effect (and
      (at start (not (step_pending step9)))
      (at end (step_done step9))
      (at end (set_up_tank))
    )
  )
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 14400)
    :condition (at start (step_pending step10))
    :effect (and
      (at start (not (step_pending step10)))
      (at end (step_done step10))
      (at end (researched_breed))
    )
  )
)