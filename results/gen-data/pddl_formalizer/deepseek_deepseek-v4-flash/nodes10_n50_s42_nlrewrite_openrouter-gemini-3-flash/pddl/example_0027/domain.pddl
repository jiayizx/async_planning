(define (domain ceviche)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (sharpened_knife)
    (garnished_plate)
    (tossed_fish)
    (cured_fish)
    (washed_cilantro_and_chilies)
    (minced_aromatics)
    (sourced_fish)
    (sliced_onions)
    (plated_ceviche)
    (cleaned_and_diced_fish)
  )
  (:durative-action do-step1
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (sharpened_knife)))
  )
  (:durative-action do-step2
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step2)) (at start (sharpened_knife)) (at start (sourced_fish)) (at start (plated_ceviche)) (at start (cleaned_and_diced_fish)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (garnished_plate)))
  )
  (:durative-action do-step3
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step3)) (at start (washed_cilantro_and_chilies)) (at start (minced_aromatics)) (at start (sliced_onions)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (tossed_fish)))
  )
  (:durative-action do-step4
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step4)) (at start (tossed_fish)) (at start (washed_cilantro_and_chilies)) (at start (minced_aromatics)) (at start (sliced_onions)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (cured_fish)))
  )
  (:durative-action do-step5
    :parameters ()
    :duration (= ?duration 180)
    :condition (at start (step_pending step5))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (washed_cilantro_and_chilies)))
  )
  (:durative-action do-step6
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step6)) (at start (washed_cilantro_and_chilies)) (at start (sliced_onions)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (minced_aromatics)))
  )
  (:durative-action do-step7
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (step_pending step7))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (sourced_fish)))
  )
  (:durative-action do-step8
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step8)) (at start (washed_cilantro_and_chilies)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (sliced_onions)))
  )
  (:durative-action do-step9
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step9)) (at start (sharpened_knife)) (at start (sourced_fish)) (at start (cleaned_and_diced_fish)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (plated_ceviche)))
  )
  (:durative-action do-step10
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending step10)) (at start (sharpened_knife)) (at start (sourced_fish)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (cleaned_and_diced_fish)))
  )
)