(define (domain gloves)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 step4 step5 step6 step7 step8 step9 step10 - step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (pred ?s - step)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (and (step_pending step1) (pred step10)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (pred step1)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (pred step2)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (and (step_pending step3) (pred step2) (pred step7)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (pred step3)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 180)
    :condition (at start (step_pending step4))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (pred step4)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 30)
    :condition (at start (and (step_pending step5) (pred step9)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (pred step5)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (and (step_pending step6) (pred step4)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (pred step6)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 240)
    :condition (at start (step_pending step7))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (pred step7)))
  )
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 45)
    :condition (at start (and (step_pending step8) (pred step1) (pred step3)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (pred step8)))
  )
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 15)
    :condition (at start (step_pending step9))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (pred step9)))
  )
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 10)
    :condition (at start (and (step_pending step10) (pred step2)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (pred step10)))
  )
)