(define (domain deductive_reasoning)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
  )
  
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending s1))
                    (at start (step_done s2))
                    (at start (step_done s3))
                    (at start (step_done s4))
                    (at start (step_done s5))
                    (at start (step_done s6))
                    (at start (step_done s7))
                    (at start (step_done s8))
                    (at start (step_done s9))
                    (at start (step_done s10)))
    :effect (and (at start (not (step_pending s1)))
                 (at end (step_done s1)))
  )
  
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending s2))
                    (at start (step_done s3))
                    (at start (step_done s4))
                    (at start (step_done s5))
                    (at start (step_done s6))
                    (at start (step_done s7))
                    (at start (step_done s8))
                    (at start (step_done s9))
                    (at start (step_done s10)))
    :effect (and (at start (not (step_pending s2)))
                 (at end (step_done s2)))
  )
  
  (:durative-action do_step3
    :parameters ()
