    :condition (and (at start (step_pending s3))
                    (at start (step_done s5))
                    (at start (step_done s10)))
    :effect (and (at start (not (step_pending s3)))
                 (at end (step_done s3)))
  )
  
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 7200)
    :condition (at start (step_pending s4))
    :effect (and (at start (not (step_pending s4)))
                 (at end (step_done s4)))
  )
  
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (step_pending s5))
    :effect (and (at start (not (step_pending s5)))
                 (at end (step_done s5)))
  )
  
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending s6))
                    (at start (step_done s3))
                    (at start (step_done s5))
                    (at start (step_done s7))
                    (at start (step_done s9))
                    (at start (step_done s10)))
    :effect (and (at start (not (step_pending s6)))
                 (at end (step_done s6)))
  )
  
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending s7))
                    (at start (step_done s3))
                    (at start (step_done s5))
                    (at start (step_done s10)))
    :effect (and (at start (not (step_pending s7)))
                 (at end (step_done s7)))
  )
  
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending s8))
                    (at start (step_done s4)))
    :effect (and (at start (not (step_pending s8)))
                 (at end (step_done s8)))
  )
  
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 86400)
    :condition (and (at start (step_pending s9))
                    (at start (step_done s3))
                    (at start (step_done s5))
                    (at start (step_done s7))
                    (at start (step_done s10)))
    :effect (and (at start (not (step_pending s9)))
                 (at end (step_done s9)))
  )
  
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending s10))
                    (at start (step_done s5)))
    :effect (and (at start (not (step_pending s10)))
                 (at end (step_done s10)))
  )
)