(define (domain dress_baptism)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (gown_located)
    (iron_warmed)
    (gown_ironed)
    (suit_laid_out)
    (bath_run)
    (collar_washed)
    (booties_fastened)
    (shoes_coat_on)
    (baby_dressed_in_gown)
    (ribbon_steamed)
    (jewelry_polished)
    (baby_bathed)
    (formal_attire_on)
    (cross_gathered)
    (diaper_bag_packed)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (gown_located)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 180)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (iron_warmed)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step3))
                    (at start (iron_warmed))
                    (at start (bath_run))
                    (at start (collar_washed))
                    (at start (baby_bathed)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (gown_ironed)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step_pending step4))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (suit_laid_out)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step_pending step5))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (bath_run)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step6))
    :effect (and (at start (not (step_pending step6)))
                 (at end (step_done step6))
                 (at end (collar_washed)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step7))
                    (at start (bath_run))
                    (at start (baby_dressed_in_gown))
                    (at start (baby_bathed)))
    :effect (and (at start (not (step_pending step7)))
                 (at end (step_done step7))
                 (at end (booties_fastened)))
  )
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step8))
                    (at start (gown_located))
                    (at start (suit_laid_out))
                    (at start (ribbon_steamed))
                    (at start (formal_attire_on)))
    :effect (and (at start (not (step_pending step8)))
                 (at end (step_done step8))
                 (at end (shoes_coat_on)))
  )
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 480)
    :condition (and (at start (step_pending step9))
                    (at start (bath_run))
                    (at start (baby_bathed)))
    :effect (and (at start (not (step_pending step9)))
                 (at end (step_done step9))
                 (at end (baby_dressed_in_gown)))
  )
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 360)
    :condition (and (at start (step_pending step10))
                    (at start (gown_located)))
    :effect (and (at start (not (step_pending step10)))
                 (at end (step_done step10))
                 (at end (ribbon_steamed)))
  )
  (:durative-action do_step11
    :parameters ()
    :duration (= ?duration 720)
    :condition (and (at start (step_pending step11))
                    (at start (cross_gathered)))
    :effect (and (at start (not (step_pending step11)))
                 (at end (step_done step11))
                 (at end (jewelry_polished)))
  )
  (:durative-action do_step12
    :parameters ()
    :duration (= ?duration 1500)
    :condition (and (at start (step_pending step12))
                    (at start (bath_run)))
    :effect (and (at start (not (step_pending step12)))
                 (at end (step_done step12))
                 (at end (baby_bathed)))
  )
  (:durative-action do_step13
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step13))
                    (at start (suit_laid_out)))
    :effect (and (at start (not (step_pending step13)))
                 (at end (step_done step13))
                 (at end (formal_attire_on)))
  )
  (:durative-action do_step14
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step14))
    :effect (and (at start (not (step_pending step14)))
                 (at end (step_done step14))
                 (at end (cross_gathered)))
  )
  (:durative-action do_step15
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step15))
                    (at start (gown_located)))
    :effect (and (at start (not (step_pending step15)))
                 (at end (step_done step15))
                 (at end (diaper_bag_packed)))
  )
)