(define (domain adopt_pet)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (finalize_contract_done)
    (schedule_home_visit_done)
    (research_breeds_done)
    (purchase_food_done)
    (submit_application_done)
    (visit_shelter_done)
    (buy_carrier_done)
    (read_books_done)
    (purchase_bed_done)
    (call_vet_done)
    (clear_space_done)
    (host_inspection_done)
    (pick_up_pet_done)
    (wait_background_done)
    (prepare_budget_done)
  )
  
  (:durative-action do_finalize_contract
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s))
                    (at start (visit_shelter_done))
                    (at start (research_breeds_done))
                    (at start (prepare_budget_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (finalize_contract_done)))
  )
  
  (:durative-action do_schedule_home_visit
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending ?s))
                    (at start (submit_application_done))
                    (at start (buy_carrier_done))
                    (at start (wait_background_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (schedule_home_visit_done)))
  )
  
  (:durative-action do_research_breeds
    :parameters (?s - step)
    :duration (= ?duration 10800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (research_breeds_done)))
  )
  
  (:durative-action do_purchase_food
    :parameters (?s - step)
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending ?s))
                    (at start (clear_space_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (purchase_food_done)))
  )
  
  (:durative-action do_submit_application
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (submit_application_done)))
  )
  
  (:durative-action do_visit_shelter
    :parameters (?s - step)
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s))
                    (at start (research_breeds_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (visit_shelter_done)))
  )
  
  (:durative-action do_buy_carrier
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (buy_carrier_done)))
  )
  
  (:durative-action do_read_books
    :parameters (?s - step)
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending ?s))
                    (at start (research_breeds_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (read_books_done)))
  )
  
  (:durative-action do_purchase_bed
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s))
                    (at start (prepare_budget_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (purchase_bed_done)))
  )
  
  (:durative-action do_call_vet
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (call_vet_done)))
  )
  
  (:durative-action do_clear_space
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (clear_space_done)))
  )
  
  (:durative-action do_host_inspection
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s))
                    (at start (schedule_home_visit_done))
                    (at start (submit_application_done))
                    (at start (buy_carrier_done))
                    (at start (wait_background_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (host_inspection_done)))
  )
  
  (:durative-action do_pick_up_pet
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s))
                    (at start (schedule_home_visit_done))
                    (at start (submit_application_done))
                    (at start (buy_carrier_done))
                    (at start (call_vet_done))
                    (at start (host_inspection_done))
                    (at start (wait_background_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (pick_up_pet_done)))
  )
  
  (:durative-action do_wait_background
    :parameters (?s - step)
    :duration (= ?duration 259200)
    :condition (and (at start (step_pending ?s))
                    (at start (submit_application_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (wait_background_done)))
  )
  
  (:durative-action do_prepare_budget
    :parameters (?s - step)
    :duration (= ?duration 7200)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (prepare_budget_done)))
  )
)