    :condition (and (at start (step_pending ?s)) (at start (is_step9 ?s)) (at start (pinterest_board_created)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (budget_secured)))
  )
  (:durative-action do_step10
    :parameters (?s - step)
    :duration (= ?duration 18000)
    :condition (and (at start (step_pending ?s)) (at start (is_step10 ?s)) (at start (theme_chosen)))
