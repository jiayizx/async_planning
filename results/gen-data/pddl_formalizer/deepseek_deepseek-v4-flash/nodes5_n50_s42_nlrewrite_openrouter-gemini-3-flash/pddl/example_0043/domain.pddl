(define (domain warning_signs)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (seminar_done)
    (cases_done)
    (guidelines_done)
    (checklist_done)
    (crossref_done))
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending step1)) (at start (guidelines_done)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (seminar_done))))
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step2)) (at start (seminar_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (cases_done))))
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 2700)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (guidelines_done))))
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step4)) (at start (guidelines_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (checklist_done))))
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step5)) (at start (checklist_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (crossref_done)))))
