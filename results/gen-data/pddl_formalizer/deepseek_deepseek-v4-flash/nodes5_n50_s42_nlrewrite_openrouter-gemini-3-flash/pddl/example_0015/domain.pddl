(define (domain lemon_bars)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step1_pending)
    (step2_pending)
    (step3_pending)
    (step4_pending)
    (step5_pending)
    (step1_done)
    (step2_done)
    (step3_done)
    (step4_done)
    (step5_done)
    (preheat_done)
    (whisk_done)
    (zest_done)
    (prepare_done)
    (bake_done)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (preheat_done)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step2_pending)) (at start (zest_done)))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (whisk_done)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step3_pending))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (zest_done)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 720)
    :condition (and (at start (step4_pending)) (at start (zest_done)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (prepare_done)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 1500)
    :condition (and (at start (step5_pending)) (at start (preheat_done)) (at start (whisk_done)) (at start (prepare_done)))
    :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (bake_done)))
  )
)