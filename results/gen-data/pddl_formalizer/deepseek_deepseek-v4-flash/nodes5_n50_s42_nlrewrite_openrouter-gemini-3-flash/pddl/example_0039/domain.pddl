(define (domain body_measurements) (:requirements :durative-actions :typing) (:types step) (:predicates (step_pending ?s - step) (step_done ?s - step) (tape_located) (tutorial_watched) (clothing_removed) (dimensions_recorded) (measurements_taken)) (:durative-action locate_tape :duration (= ?duration 120) :condition (at start (step_pending step1)) :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (tape_located)))) (:durative-action watch_tutorial :duration (= ?duration 600) :condition (at start (step_pending step3)) :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (tutorial_watched)))) (:durative-action remove_clothing :duration (= ?duration 60) :condition (at start (step_pending step5)) :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (clothing_removed)))) (:durative-action record_dimensions :duration (= ?duration 300) :condition (and (at start (step_pending step2)) (at start (tape_located)) (at start (tutorial_watched))) :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (dimensions_recorded)))) (:durative-action measure_body :duration (= ?duration 180) :condition (and (at start (step_pending step4)) (at start (clothing_removed))) :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (measurements_taken)))))