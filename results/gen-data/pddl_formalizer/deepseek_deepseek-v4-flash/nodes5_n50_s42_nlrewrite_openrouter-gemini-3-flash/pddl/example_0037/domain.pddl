(define (domain choose_flowers)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending) (step1_done)
    (step2_pending) (step2_done)
    (step3_pending) (step3_done)
    (step4_pending) (step4_done)
    (step5_pending) (step5_done)
    (sterilize_garden_shears_done)
    (strip_petals_done)
    (harvest_blooming_rosebuds_done)
    (arrange_petals_done)
    (select_cut_lavender_sprigs_done)
  )
  (:durative-action do_step1
    :duration (= ?duration 300)
    :condition (at start (step1_pending))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (sterilize_garden_shears_done)))
  )
  (:durative-action do_step2
    :duration (= ?duration 900)
    :condition (and (at start (step2_pending)) (at start (harvest_blooming_rosebuds_done)))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (strip_petals_done)))
  )
  (:durative-action do_step3
    :duration (= ?duration 1200)
    :condition (at start (step3_pending))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (harvest_blooming_rosebuds_done)))
  )
  (:durative-action do_step4
    :duration (= ?duration 600)
    :condition (and (at start (step4_pending)) (at start (sterilize_garden_shears_done)) (at start (strip_petals_done)) (at start (select_cut_lavender_sprigs_done)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (arrange_petals_done)))
  )
  (:durative-action do_step5
    :duration (= ?duration 600)
    :condition (and (at start (step5_pending)) (at start (sterilize_garden_shears_done)))
    :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (select_cut_lavender_sprigs_done)))
  )
)