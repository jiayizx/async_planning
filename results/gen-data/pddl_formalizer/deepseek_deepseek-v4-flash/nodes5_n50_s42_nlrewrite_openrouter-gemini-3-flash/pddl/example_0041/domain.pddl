(define (domain sippy-cup)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_done ?s - step)
    (cup_retrieved)
    (cup_filled)
    (lid_screwed)
    (cap_removed)
    (drink_taken)
  )
  (:durative-action retrieve_cup
    :duration (= ?duration 20)
    :condition ()
    :effect (and (at end (step_done step1))
                 (at end (cup_retrieved)))
  )
  (:durative-action remove_cap
    :duration (= ?duration 5)
    :condition ()
    :effect (and (at end (step_done step5))
                 (at end (cap_removed)))
  )
  (:durative-action fill_cup
    :duration (= ?duration 15)
    :condition (at start (cup_retrieved))
    :effect (and (at end (step_done step3))
                 (at end (cup_filled)))
  )
  (:durative-action screw_lid
    :duration (= ?duration 10)
    :condition (at start (cup_filled))
    :effect (and (at end (step_done step2))
                 (at end (lid_screwed)))
  )
  (:durative-action drink
    :duration (= ?duration 30)
    :condition (at start (cap_removed))
    :effect (and (at end (step_done step4))
                 (at end (drink_taken)))
  )
)