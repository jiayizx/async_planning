(define (problem buy-bus-pass)
  (:domain bus-pass)
  (:objects step1 step2 step3 step4 step5 - step)
  (:init
    (step_pending step1)
    (step_pending step2)
    (step_pending step3)
    (step_pending step4)
    (step_pending step5)
    (purchase_step step1)
    (download_step step2)
    (profile_step step3)
    (withdraw_step step4)
    (find_bank_step step5)
  )
  (:goal (and
    (step_done step1)
    (step_done step2)
    (step_done step3)
    (step_done step4)
    (step_done step5)
    (pass_purchased)
  ))
  (:metric minimize (total-time))
)