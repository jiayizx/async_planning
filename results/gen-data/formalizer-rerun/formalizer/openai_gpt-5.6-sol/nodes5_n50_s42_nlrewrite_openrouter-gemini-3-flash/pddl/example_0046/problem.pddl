(define (problem celebrate-may-day)
  (:domain may-day)
  (:objects
    step1 step2 step3 step4 step5 - step
  )
  (:init
    (step_pending step1)
    (step_pending step2)
    (step_pending step3)
    (step_pending step4)
    (step_pending step5)
    (dance_pending)
    (gather_pending)
    (weave_pending)
    (deliver_pending)
    (buy_pending)
    (is_step1 step1)
    (is_step2 step2)
    (is_step3 step3)
    (is_step4 step4)
    (is_step5 step5)
  )
  (:goal (and
    (step_done step1)
    (step_done step2)
    (step_done step3)
    (step_done step4)
    (step_done step5)
    (flower_baskets_delivered)
  ))
  (:metric minimize (total-time))
)