(define (problem write-freeform-poetry)
  (:domain freeform-poetry)
  (:objects
    step1 step2 step3 step4 step5 - step
  )
  (:init
    (step_pending step1)
    (step_pending step2)
    (step_pending step3)
    (step_pending step4)
    (step_pending step5)
    (reflection_step step1)
    (opening_stanza_step step2)
    (rhythm_check_step step3)
    (theme_selection_step step4)
    (metaphor_expansion_step step5)
  )
  (:goal (and
    (step_done step1)
    (step_done step2)
    (step_done step3)
    (step_done step4)
    (step_done step5)
    (rhythm_checked)
  ))
  (:metric minimize (total-time))
)