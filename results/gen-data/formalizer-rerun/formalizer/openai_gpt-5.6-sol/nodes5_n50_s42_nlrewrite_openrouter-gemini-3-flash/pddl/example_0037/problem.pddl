(define (problem choose-potpourri-flowers)
  (:domain potpourri-flowers)
  (:objects step1 step2 step3 step4 step5 - step)
  (:init
    (sterilize_pending step1)
    (strip_pending step2)
    (harvest_pending step3)
    (arrange_pending step4)
    (lavender_pending step5)
  )
  (:goal (and
    (step_done step1)
    (step_done step2)
    (step_done step3)
    (step_done step4)
    (step_done step5)
    (petals_arranged)
  ))
)