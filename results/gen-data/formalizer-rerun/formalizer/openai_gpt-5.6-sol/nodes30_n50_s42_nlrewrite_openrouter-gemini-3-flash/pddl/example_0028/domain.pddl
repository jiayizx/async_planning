(define (domain pug-grooming)
  (:requirements :typing :durative-actions)
  (:types
    step - object
    step1_type step2_type step3_type step4_type step5_type
    step6_type step7_type step8_type step9_type step10_type
    step11_type step12_type step13_type step14_type step15_type
    step16_type step17_type step18_type step19_type step20_type
    step21_type step22_type step23_type step24_type step25_type
    step26_type step27_type step28_type step29_type step30_type - step
  )
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (paw_balm_applied)
    (shedding_blades_gathered)
    (shampoo_diluted)
    (dryer_prepared)
    (grooming_table_prepared)
    (coat_scrubbed)
    (fur_wet)
    (conditioner_applied)
    (antiseptic_wipes_retrieved)
    (flea_comb_sanitized)
    (towels_laid_out)
    (excess_water_absorbed)
    (soap_suds_rinsed)
    (damp_fur_combed)
    (basin_filled)
    (fur_blow_dried)
    (ears_cleaned)
    (undercoat_brushed)
    (drying_air_checked)
    (tear_stains_treated)
    (chest_lathered)
    (pug_secured)
    (dryer_tested)
    (pug_in_basin)
    (nose_wrinkles_cleaned)
    (grooming_complete)
    (basin_drained)
    (paws_scrubbed)
    (final_rinse_completed)
    (tail_and_ears_squeezed)
  )

  (:durative-action apply_paw_balm
    :parameters (?s - step1_type)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (towels_laid_out)) (at start (excess_water_absorbed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (paw_balm_applied)))
  )
  (:durative-action gather_shedding_blades
    :parameters (?s - step2_type)
    :duration (= ?duration 600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (shedding_blades_gathered)))
  )
  (:durative-action dilute_shampoo
    :parameters (?s - step3_type)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (basin_filled)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (shampoo_diluted)))
  )
  (:durative-action prepare_dryer
    :parameters (?s - step4_type)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (dryer_tested)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (dryer_prepared)))
  )
  (:durative-action prepare_grooming_table
    :parameters (?s - step5_type)
    :duration (= ?duration 900)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (grooming_table_prepared)))
  )
  (:durative-action scrub_coat
    :parameters (?s - step6_type)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s)) (at start (fur_wet)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (coat_scrubbed)))
  )
  (:durative-action wet_fur
    :parameters (?s - step7_type)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (undercoat_brushed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (fur_wet)))
  )
  (:durative-action apply_conditioner
    :parameters (?s - step8_type)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (basin_drained)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (conditioner_applied)))
  )
  (:durative-action retrieve_antiseptic_wipes
    :parameters (?s - step9_type)
    :duration (= ?duration 300)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (antiseptic_wipes_retrieved)))
  )
  (:durative-action sanitize_flea_comb
    :parameters (?s - step10_type)
    :duration (= ?duration 600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (flea_comb_sanitized)))
  )
  (:durative-action lay_out_towels
    :parameters (?s - step11_type)
    :duration (= ?duration 120)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (towels_laid_out)))
  )
  (:durative-action absorb_excess_water
    :parameters (?s - step12_type)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (basin_drained)) (at start (tail_and_ears_squeezed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (excess_water_absorbed)))
  )
  (:durative-action rinse_soap_suds
    :parameters (?s - step13_type)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (coat_scrubbed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (soap_suds_rinsed)))
  )
  (:durative-action comb_damp_fur
    :parameters (?s - step14_type)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s)) (at start (flea_comb_sanitized)) (at start (towels_laid_out)) (at start (undercoat_brushed)) (at start (pug_in_basin)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (damp_fur_combed)))
  )
  (:durative-action fill_basin
    :parameters (?s - step15_type)
    :duration (= ?duration 480)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (basin_filled)))
  )
  (:durative-action blow_dry_fur
    :parameters (?s - step16_type)
    :duration (= ?duration 1500)
    :condition (and (at start (step_pending ?s)) (at start (excess_water_absorbed)) (at start (damp_fur_combed)) (at start (drying_air_checked)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (fur_blow_dried)))
  )
  (:durative-action clean_ears
    :parameters (?s - step17_type)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (basin_drained)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (ears_cleaned)))
  )
  (:durative-action brush_undercoat
    :parameters (?s - step18_type)
    :duration (= ?duration 1200)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (undercoat_brushed)))
  )
  (:durative-action check_drying_air
    :parameters (?s - step19_type)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (dryer_prepared)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (drying_air_checked)))
  )
  (:durative-action apply_tear_stain_remover
    :parameters (?s - step20_type)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (coat_scrubbed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (tear_stains_treated)))
  )
  (:durative-action lather_chest
    :parameters (?s - step21_type)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (shampoo_diluted)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (chest_lathered)))
  )
  (:durative-action secure_pug
    :parameters (?s - step22_type)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (grooming_table_prepared)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (pug_secured)))
  )
  (:durative-action test_dryer
    :parameters (?s - step23_type)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (pug_in_basin)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (dryer_tested)))
  )
  (:durative-action place_pug_in_basin
    :parameters (?s - step24_type)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (basin_filled)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (pug_in_basin)))
  )
  (:durative-action clean_nose_wrinkles
    :parameters (?s - step25_type)
    :duration (= ?duration 480)
    :condition (and (at start (step_pending ?s)) (at start (shedding_blades_gathered)) (at start (antiseptic_wipes_retrieved)) (at start (undercoat_brushed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (nose_wrinkles_cleaned)))
  )
  (:durative-action give_treat
    :parameters (?s - step26_type)
    :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s)) (at start (shampoo_diluted)) (at start (ears_cleaned)) (at start (final_rinse_completed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (grooming_complete)))
  )
  (:durative-action drain_basin
    :parameters (?s - step27_type)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (towels_laid_out)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (basin_drained)))
  )
  (:durative-action scrub_paws
    :parameters (?s - step28_type)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s)) (at start (basin_filled)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (paws_scrubbed)))
  )
  (:durative-action final_rinse
    :parameters (?s - step29_type)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (soap_suds_rinsed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (final_rinse_completed)))
  )
  (:durative-action squeeze_tail_and_ears
    :parameters (?s - step30_type)
    :duration (= ?duration 180)
    :condition (and (at start (step_pending ?s)) (at start (flea_comb_sanitized)) (at start (basin_drained)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (tail_and_ears_squeezed)))
  )
)