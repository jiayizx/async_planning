(define (domain tie-dye-nails)
  (:requirements :typing :durative-actions)
  (:types
    step - object
    step1-type step2-type step3-type step4-type step5-type
    step6-type step7-type step8-type step9-type step10-type
    step11-type step12-type step13-type step14-type step15-type
    step16-type step17-type step18-type step19-type step20-type
    step21-type step22-type step23-type step24-type step25-type
    step26-type step27-type step28-type step29-type step30-type - step
  )
  (:predicates
    (step-pending ?s - step)
    (step-done ?s - step)
    (s1-cleaned)
    (s2-dehydrator-applied)
    (s3-colors-organized)
    (s4-top-coat-applied)
    (s5-skin-cleaned)
    (s6-cuticle-oil-applied)
    (s7-white-base-applied)
    (s8-cuticles-pushed-back)
    (s9-yellow-polish-dropped)
    (s10-nails-filed)
    (s11-blue-polish-dropped)
    (s12-cup-filled)
    (s13-brush-selected)
    (s14-towels-prepared)
    (s15-nails-buffed)
    (s16-liquid-latex-applied)
    (s17-nail-dipped)
    (s18-white-base-dried)
    (s19-bowl-positioned)
    (s20-water-checked)
    (s21-oil-massaged)
    (s22-colors-marbled)
    (s23-latex-peeled)
    (s24-polish-shaken)
    (s25-clear-polish-added)
    (s26-dust-wiped)
    (s27-primer-applied)
    (s28-tools-laid-out)
    (s29-film-set)
    (s30-design-air-dried)
  )

  (:durative-action clean-nail-surface
    :parameters (?s - step1-type)
    :duration (= ?duration 120)
    :condition (at start (step-pending ?s))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s1-cleaned)))
  )
  (:durative-action apply-dehydrator
    :parameters (?s - step2-type)
    :duration (= ?duration 60)
    :condition (and (at start (step-pending ?s)) (at start (s10-nails-filed)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s2-dehydrator-applied)))
  )
  (:durative-action organize-polish-colors
    :parameters (?s - step3-type)
    :duration (= ?duration 300)
    :condition (at start (step-pending ?s))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s3-colors-organized)))
  )
  (:durative-action apply-top-coat
    :parameters (?s - step4-type)
    :duration (= ?duration 180)
    :condition (and (at start (step-pending ?s)) (at start (s5-skin-cleaned)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s4-top-coat-applied)))
  )
  (:durative-action clean-polish-from-skin
    :parameters (?s - step5-type)
    :duration (= ?duration 360)
    :condition (and (at start (step-pending ?s)) (at start (s6-cuticle-oil-applied)) (at start (s23-latex-peeled)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s5-skin-cleaned)))
  )
  (:durative-action apply-cuticle-oil
    :parameters (?s - step6-type)
    :duration (= ?duration 120)
    :condition (at start (step-pending ?s))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s6-cuticle-oil-applied)))
  )
  (:durative-action apply-white-base-coat
    :parameters (?s - step7-type)
    :duration (= ?duration 600)
    :condition (and (at start (step-pending ?s)) (at start (s8-cuticles-pushed-back)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s7-white-base-applied)))
  )
  (:durative-action push-back-cuticles
    :parameters (?s - step8-type)
    :duration (= ?duration 240)
    :condition (and (at start (step-pending ?s)) (at start (s1-cleaned)) (at start (s24-polish-shaken)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s8-cuticles-pushed-back)))
  )
  (:durative-action drop-yellow-polish
    :parameters (?s - step9-type)
    :duration (= ?duration 30)
    :condition (and (at start (step-pending ?s)) (at start (s12-cup-filled)) (at start (s25-clear-polish-added)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s9-yellow-polish-dropped)))
  )
  (:durative-action file-nails
    :parameters (?s - step10-type)
    :duration (= ?duration 480)
    :condition (at start (step-pending ?s))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s10-nails-filed)))
  )
  (:durative-action drop-blue-polish
    :parameters (?s - step11-type)
    :duration (= ?duration 30)
    :condition (and (at start (step-pending ?s)) (at start (s9-yellow-polish-dropped)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s11-blue-polish-dropped)))
  )
  (:durative-action fill-water-cup
    :parameters (?s - step12-type)
    :duration (= ?duration 60)
    :condition (and (at start (step-pending ?s)) (at start (s19-bowl-positioned)) (at start (s20-water-checked)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s12-cup-filled)))
  )
  (:durative-action select-detailing-brush
    :parameters (?s - step13-type)
    :duration (= ?duration 120)
    :condition (and (at start (step-pending ?s)) (at start (s3-colors-organized)) (at start (s16-liquid-latex-applied)) (at start (s24-polish-shaken)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s13-brush-selected)))
  )
  (:durative-action prepare-paper-towels
    :parameters (?s - step14-type)
    :duration (= ?duration 60)
    :condition (at start (step-pending ?s))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s14-towels-prepared)))
  )
  (:durative-action buff-nail-plate
    :parameters (?s - step15-type)
    :duration (= ?duration 180)
    :condition (and (at start (step-pending ?s)) (at start (s26-dust-wiped)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s15-nails-buffed)))
  )
  (:durative-action apply-liquid-latex
    :parameters (?s - step16-type)
    :duration (= ?duration 300)
    :condition (and (at start (step-pending ?s)) (at start (s8-cuticles-pushed-back)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s16-liquid-latex-applied)))
  )
  (:durative-action dip-nail
    :parameters (?s - step17-type)
    :duration (= ?duration 10)
    :condition (and (at start (step-pending ?s)) (at start (s11-blue-polish-dropped)) (at start (s14-towels-prepared)) (at start (s22-colors-marbled)) (at start (s28-tools-laid-out)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s17-nail-dipped)))
  )
  (:durative-action dry-white-base-coat
    :parameters (?s - step18-type)
    :duration (= ?duration 900)
    :condition (and (at start (step-pending ?s)) (at start (s7-white-base-applied)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s18-white-base-dried)))
  )
  (:durative-action position-water-bowl
    :parameters (?s - step19-type)
    :duration (= ?duration 30)
    :condition (and (at start (step-pending ?s)) (at start (s27-primer-applied)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s19-bowl-positioned)))
  )
  (:durative-action check-water-temperature
    :parameters (?s - step20-type)
    :duration (= ?duration 120)
    :condition (at start (step-pending ?s))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s20-water-checked)))
  )
  (:durative-action massage-cuticle-oil
    :parameters (?s - step21-type)
    :duration (= ?duration 180)
    :condition (and (at start (step-pending ?s)) (at start (s6-cuticle-oil-applied)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s21-oil-massaged)))
  )
  (:durative-action marble-polish-colors
    :parameters (?s - step22-type)
    :duration (= ?duration 45)
    :condition (and (at start (step-pending ?s)) (at start (s16-liquid-latex-applied)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s22-colors-marbled)))
  )
  (:durative-action peel-liquid-latex
    :parameters (?s - step23-type)
    :duration (= ?duration 120)
    :condition (and (at start (step-pending ?s)) (at start (s17-nail-dipped)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s23-latex-peeled)))
  )
  (:durative-action shake-polish-bottles
    :parameters (?s - step24-type)
    :duration (= ?duration 60)
    :condition (and (at start (step-pending ?s)) (at start (s3-colors-organized)) (at start (s26-dust-wiped)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s24-polish-shaken)))
  )
  (:durative-action add-clear-polish
    :parameters (?s - step25-type)
    :duration (= ?duration 30)
    :condition (and (at start (step-pending ?s)) (at start (s12-cup-filled)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s25-clear-polish-added)))
  )
  (:durative-action wipe-filing-dust
    :parameters (?s - step26-type)
    :duration (= ?duration 120)
    :condition (and (at start (step-pending ?s)) (at start (s2-dehydrator-applied)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s26-dust-wiped)))
  )
  (:durative-action apply-primer
    :parameters (?s - step27-type)
    :duration (= ?duration 120)
    :condition (and (at start (step-pending ?s)) (at start (s18-white-base-dried)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s27-primer-applied)))
  )
  (:durative-action lay-out-dipping-tools
    :parameters (?s - step28-type)
    :duration (= ?duration 240)
    :condition (and (at start (step-pending ?s)) (at start (s26-dust-wiped)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s28-tools-laid-out)))
  )
  (:durative-action set-polish-film
    :parameters (?s - step29-type)
    :duration (= ?duration 20)
    :condition (and (at start (step-pending ?s)) (at start (s22-colors-marbled)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s29-film-set)))
  )
  (:durative-action air-dry-final-design
    :parameters (?s - step30-type)
    :duration (= ?duration 1200)
    :condition (and (at start (step-pending ?s)) (at start (s4-top-coat-applied)) (at start (s5-skin-cleaned)))
    :effect (and (at start (not (step-pending ?s))) (at end (step-done ?s)) (at end (s30-design-air-dried)))
  )
)