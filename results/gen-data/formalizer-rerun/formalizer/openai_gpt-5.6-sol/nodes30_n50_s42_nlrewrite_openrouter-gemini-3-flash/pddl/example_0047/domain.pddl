(define (domain conservation-officer)
  (:requirements :typing :durative-actions)
  (:types
    step
    step1type step2type step3type step4type step5type step6type step7type step8type step9type step10type
    step11type step12type step13type step14type step15type step16type step17type step18type step19type step20type
    step21type step22type step23type step24type step25type step26type step27type step28type step29type step30type - step
  )
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (first_aid_certified)
    (seminar_attended)
    (degree_enrolled)
    (license_applied)
    (internship_application_submitted)
    (uniform_purchased)
    (practicum_completed)
    (exam_registered)
    (internship_completed)
    (knowledge_exam_passed)
    (graduation_attended)
    (psychological_evaluation_passed)
    (high_school_completed)
    (boat_license_obtained)
    (boater_course_completed)
    (questionnaire_completed)
    (records_search_completed)
    (fitness_test_passed)
    (commercial_license_earned)
    (academy_application_submitted)
    (conditional_offer_received)
    (medical_screening_cleared)
    (basic_training_completed)
    (ride_along_completed)
    (aptitude_test_passed)
    (wildlife_code_training_completed)
    (final_interview_completed)
    (requirements_researched)
    (reference_interviews_completed)
    (oath_sworn)
  )

  (:durative-action complete-first-aid
    :parameters (?s - step1type)
    :duration (= ?duration 259200)
    :condition (and (at start (step_pending ?s)) (at start (degree_enrolled)) (at start (fitness_test_passed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (first_aid_certified)))
  )
  (:durative-action attend-career-seminar
    :parameters (?s - step2type)
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s)) (at start (requirements_researched)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (seminar_attended)))
  )
  (:durative-action enroll-degree-program
    :parameters (?s - step3type)
    :duration (= ?duration 126144000)
    :condition (and (at start (step_pending ?s)) (at start (high_school_completed)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (degree_enrolled)))
  )
  (:durative-action apply-hunting-fishing-license
