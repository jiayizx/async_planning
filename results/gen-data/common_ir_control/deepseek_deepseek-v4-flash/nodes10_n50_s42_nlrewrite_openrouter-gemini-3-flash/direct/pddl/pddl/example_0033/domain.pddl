(define (domain honeymoon_planning)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (research_romantic_done)
    (choose_flights_done)
    (finalize_hotel_done)
    (pack_suitcases_done)
    (long_haul_flight_done)
    (passports_received_done)
    (time_off_requested_done)
    (check_into_suite_done)
    (travel_to_resort_done)
    (sunset_dinner_enjoyed)
  )
  (:durative-action research_romantic
    :parameters (?s - step)
    :duration (= ?duration 172800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (research_romantic_done)))
  )
  (:durative-action choose_flights
    :parameters (?s - step)
    :duration (= ?duration 10800)
    :condition (and (at start (step_pending ?s))
                    (at start (research_romantic_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (choose_flights_done)))
  )
  (:durative-action request_time_off
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s))
                    (at start (passports_received_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (time_off_requested_done)))
  )
  (:durative-action finalize_hotel
    :parameters (?s - step)
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending ?s))
                    (at start (choose_flights_done))
                    (at start (time_off_requested_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (finalize_hotel_done)))
  )
  (:durative-action pack_suitcases
    :parameters (?s - step)
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s))
                    (at start (finalize_hotel_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (pack_suitcases_done)))
  )
  (:durative-action long_haul_flight
    :parameters (?s - step)
    :duration (= ?duration 43200)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (long_haul_flight_done)))
  )
  (:durative-action apply_passports
    :parameters (?s - step)
    :duration (= ?duration (* 6 7 24 3600))
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (passports_received_done)))
  )
  (:durative-action check_into_suite
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s))
                    (at start (long_haul_flight_done))
                    (at start (passports_received_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (check_into_suite_done)))
  )
  (:durative-action travel_to_resort
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s))
                    (at start (pack_suitcases_done))
                    (at start (passports_received_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (travel_to_resort_done)))
  )
  (:durative-action sunset_dinner
    :parameters (?s - step)
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s))
                    (at start (check_into_suite_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (sunset_dinner_enjoyed)))
  )
)