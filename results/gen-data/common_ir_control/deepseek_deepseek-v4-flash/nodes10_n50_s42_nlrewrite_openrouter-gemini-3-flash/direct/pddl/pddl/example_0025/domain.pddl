(define (domain tea_preparation)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (steep_tea_done)
    (compost_leaves_done)
    (research_tea_done)
    (order_kettle_done)
    (pour_tea_done)
    (select_mug_done)
    (visit_shop_done)
    (wait_delivery_done)
    (boil_water_done)
    (sip_tea_done)
  )
  (:durative-action do_steep_tea
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step1)) (at start (boil_water_done)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (steep_tea_done)))
  )
  (:durative-action do_compost_leaves
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step2)) (at start (wait_delivery_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (compost_leaves_done)))
  )
  (:durative-action do_research_tea
    :duration (= ?duration 1800)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (research_tea_done)))
  )
  (:durative-action do_order_kettle
    :duration (= ?duration 600)
    :condition (at start (step_pending step4))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (order_kettle_done)))
  )
  (:durative-action do_pour_tea
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step5)) (at start (steep_tea_done)) (at start (research_tea_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (pour_tea_done)))
  )
  (:durative-action do_select_mug
    :duration (= ?duration 60)
    :condition (at start (step_pending step6))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (select_mug_done)))
  )
  (:durative-action do_visit_shop
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step7)) (at start (research_tea_done)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (visit_shop_done)))
  )
  (:durative-action do_wait_delivery
    :duration (= ?duration 259200)
    :condition (and (at start (step_pending step8)) (at start (order_kettle_done)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (wait_delivery_done)))
  )
  (:durative-action do_boil_water
    :duration (= ?duration 240)
    :condition (and (at start (step_pending step9)) (at start (research_tea_done)) (at start (visit_shop_done)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (boil_water_done)))
  )
  (:durative-action do_sip_tea
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step10)) (at start (research_tea_done)) (at start (select_mug_done)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (sip_tea_done)))
  )
)