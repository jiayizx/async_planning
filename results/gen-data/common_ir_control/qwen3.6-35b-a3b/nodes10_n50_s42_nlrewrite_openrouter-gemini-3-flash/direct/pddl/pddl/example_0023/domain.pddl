(define (domain word_slider)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step-pending ?s - step)
               (step-done ?s - step)
               (step1_done) (step2_done) (step3_done) (step4_done)
               (step5_done) (step6_done) (step7_done) (step8_done)
               (step9_done) (step10_done))
  (:durative-action do_step1
    :duration (= ?duration 1200)
    :condition (at start (step-pending step1))
    :effect (and (at start (not (step-pending step1)))
                 (at end (step-done step1))
                 (at end (step1_done))))
  (:durative-action do_step2
    :duration (= ?duration 300)
    :condition (and (at start (step-pending step2)) (at start (step9_done)))
    :effect (and (at start (not (step-pending step2)))
                 (at end (step-done step2))
                 (at end (step2_done))))
  (:durative-action do_step3
    :duration (= ?duration 900)
    :condition (and (at start (step-pending step3))
                    (at start (step1_done))
                    (at start (step4_done))
                    (at start (step7_done)))
    :effect (and (at start (not (step-pending step3)))
                 (at end (step-done step3))
                 (at end (step3_done))))
  (:durative-action do_step4
    :duration (= ?duration 600)
    :condition (and (at start (step-pending step4)) (at start (step6_done)))
    :effect (and (at start (not (step-pending step4)))
                 (at end (step-done step4))
                 (at end (step4_done))))
  (:durative-action do_step5
    :duration (= ?duration 600)
    :condition (and (at start (step-pending step5)) (at start (step10_done)))
    :effect (and (at start (not (step-pending step5)))
                 (at end (step-done step5))
                 (at end (step5_done))))
  (:durative-action do_step6
    :duration (= ?duration 300)
    :condition (and (at start (step-pending step6)) (at start (step1_done)))
    :effect (and (at start (not (step-pending step6)))
                 (at end (step-done step6))
                 (at end (step6_done))))
  (:durative-action do_step7
    :duration (= ?duration 480)
    :condition (and (at start (step-pending step7)) (at start (step8_done)))
    :effect (and (at start (not (step-pending step7)))
                 (at end (step-done step7))
                 (at end (step7_done))))
  (:durative-action do_step8
    :duration (= ?duration 1800)
    :condition (at start (step-pending step8))
    :effect (and (at start (not (step-pending step8)))
                 (at end (step-done step8))
                 (at end (step8_done))))
  (:durative-action do_step9
    :duration (= ?duration 720)
    :condition (and (at start (step-pending step9)) (at start (step7_done)))
    :effect (and (at start (not (step-pending step9)))
                 (at end (step-done step9))
                 (at end (step9_done))))
  (:durative-action do_step10
    :duration (= ?duration 240)
    :condition (and (at start (step-pending step10)) (at start (step2_done)))
    :effect (and (at start (not (step-pending step10)))
                 (at end (step-done step10))
                 (at end (step10_done))))
)