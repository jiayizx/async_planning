(:domain rhubarb_prep
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (leaves_trimmed)
    (simmering_done)
    (stalks_dried)
    (harvested)
    (pan_located)
    (rinsed)
    (garnished)
    (knife_sharpened)
    (placed_on_board)
    (sugar_measured)
    (combined)
    (sliced)
    (cream_whipped)
    (board_set)
    (cooled)
  )
  (:durative-action do_step1 :duration 120 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start harvested))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end leaves_trimmed)))
  (:durative-action do_step2 :duration 900 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start combined) (at start sugar_measured) (at start sliced) (at start pan_located) (at start placed_on_board) (at start board_set) (at start knife_sharpened))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end simmering_done)))
  (:durative-action do_step3 :duration 60 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start leaves_trimmed) (at start rinsed) (at start placed_on_board) (at start board_set) (at start knife_sharpened) (at start harvested))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end stalks_dried)))
  (:durative-action do_step4 :duration 300 :parameters (?s - step)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end harvested)))
  (:durative-action do_step5 :duration 30 :parameters (?s - step)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end pan_located)))
  (:durative-action do_step6 :duration 45 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start placed_on_board) (at start board_set) (at start knife_sharpened))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end rinsed)))
  (:durative-action do_step7 :duration 10 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start cream_whipped) (at start cooled) (at start simmering_done) (at start combined) (at start sugar_measured) (at start sliced) (at start pan_located) (at start placed_on_board) (at start board_set) (at start knife_sharpened))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end garnished)))
  (:durative-action do_step8 :duration 180 :parameters (?s - step)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end knife_sharpened)))
  (:durative-action do_step9 :duration 20 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start board_set) (at start knife_sharpened))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end placed_on_board)))
  (:durative-action do_step10 :duration 60 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start sliced) (at start pan_located) (at start placed_on_board) (at start board_set) (at start knife_sharpened))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end sugar_measured)))
  (:durative-action do_step11 :duration 120 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start sugar_measured) (at start sliced) (at start pan_located) (at start placed_on_board) (at start board_set) (at start knife_sharpened))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end combined)))
  (:durative-action do_step12 :duration 240 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start pan_located) (at start placed_on_board) (at start board_set) (at start knife_sharpened))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end sliced)))
  (:durative-action do_step13 :duration 300 :parameters (?s - step)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end cream_whipped)))
  (:durative-action do_step14 :duration 15 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start knife_sharpened))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end board_set)))
  (:durative-action do_step15 :duration 3600 :parameters (?s - step)
    :condition (and (at start (step_pending ?s)) (at start simmering_done) (at start combined) (at start sugar_measured) (at start sliced) (at start pan_located) (at start placed_on_board) (at start board_set) (at start knife_sharpened))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end cooled)))
)
