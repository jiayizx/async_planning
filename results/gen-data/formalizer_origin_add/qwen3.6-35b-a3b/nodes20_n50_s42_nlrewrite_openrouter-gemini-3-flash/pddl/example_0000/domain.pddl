    :effect (and (at start (not (step_pending step14))) (at end (step_done step14)) (at end (cpu_fan_spinning))))
  (:durative-action do_step15
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step15)) (at start (splash_screen)) (at start (motherboard_leds_lit)))
    :effect (and (at start (not (step_pending step15))) (at end (step_done step15)) (at end (password_entered))))
  (:durative-action do_step16
    :parameters ()
    :duration (= ?duration 15)
    :condition (and (at start (step_pending step16)) (at start (cmos_battery_inserted)))
    :effect (and (at start (not (step_pending step16))) (at end (step_done step16)) (at end (tower_power_connected))))
