(define (domain turn_on_computer)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (plug_power)
    (hdmi_connected)
    (psu_switch_toggled)
    (peripherals_retrieved)
    (cmos_battery_inserted)
    (chassis_power_pressed)
    (os_login_screen)
    (surge_protector_on)
    (post_complete)
    (splash_screen)
    (kb_power_on)
    (monitor_power_on)
    (ups_active)
    (cpu_fan_spinning)
    (password_entered)
    (tower_power_connected)
    (wall_socket_verified)
    (system_ready_beep)
    (motherboard_leds_lit)
    (mouse_power_on))
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step1)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (plug_power))))
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step2)) (at start (psu_switch_toggled)) (at start (tower_power_connected)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (hdmi_connected))))
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step_pending step3)) (at start (surge_protector_on)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (psu_switch_toggled))))
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 45)
    :condition (and (at start (step_pending step4)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (peripherals_retrieved))))
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step5)) (at start (wall_socket_verified)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (cmos_battery_inserted))))
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step6)) (at start (plug_power)) (at start (psu_switch_toggled)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (chassis_power_pressed))))
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 45)
    :condition (and (at start (step_pending step7)) (at start (post_complete)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (os_login_screen))))
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step_pending step8)) (at start (tower_power_connected)) (at start (mouse_power_on)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (surge_protector_on))))
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 15)
    :condition (and (at start (step_pending step9)) (at start (system_ready_beep)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (post_complete))))
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 10)
    :condition (and (at start (step_pending step10)) (at start (chassis_power_pressed)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (splash_screen))))
  (:durative-action do_step11
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step_pending step11)) (at start (peripherals_retrieved)))
    :effect (and (at start (not (step_pending step11))) (at end (step_done step11)) (at end (kb_power_on))))
  (:durative-action do_step12
    :parameters ()
    :duration (= ?duration 3)
    :condition (and (at start (step_pending step12)) (at start (hdmi_connected)))
    :effect (and (at start (not (step_pending step12))) (at end (step_done step12)) (at end (monitor_power_on))))
  (:durative-action do_step13
