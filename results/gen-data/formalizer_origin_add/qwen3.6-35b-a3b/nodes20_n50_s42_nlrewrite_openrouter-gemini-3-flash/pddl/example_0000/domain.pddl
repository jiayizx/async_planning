    :effect (and (at start (not (step_pending step17))) (at end (step_done step17)) (at end (wall_socket_verified))))
  (:durative-action do_step18
    :parameters ()
    :duration (= ?duration 2)
    :condition (and (at start (step_pending step18)) (at start (surge_protector_on)))
    :effect (and (at start (not (step_pending step18))) (at end (step_done step18)) (at end (system_ready_beep))))
  (:durative-action do_step19
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step_pending step19)) (at start (ups_active)))
    :effect (and (at start (not (step_pending step19))) (at end (step_done step19)) (at end (motherboard_leds_lit))))
  (:durative-action do_step20
    :parameters ()
    :duration (= ?duration 5)
    :condition (and (at start (step_pending step20)) (at start (peripherals_retrieved)))
    :effect (and (at start (not (step_pending step20))) (at end (step_done step20)) (at end (mouse_power_on)))))