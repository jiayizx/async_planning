(define (domain roast_vegetables)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (tossed_done)
               (purchased_done)
               (spread_done)
               (roasted_done)
               (preheated_done)
               (washed_done)
               (chopped_done)
               (lined_done)
               (placed_done)
               (deglazed_done))
  (:durative-action do_step1 :parameters (?s - step) :duration (= ?duration 180)
    :condition (and (at start (step_pending ?s)) (at start (chopped_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (tossed_done))))
  (:durative-action do_step2 :parameters (?s - step) :duration (= ?duration 2700)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (purchased_done))))
  (:durative-action do_step3 :parameters (?s - step) :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s))
                    (at start (tossed_done))
                    (at start (washed_done))
                    (at start (lined_done))
                    (at start (deglazed_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (spread_done))))
  (:durative-action do_step4 :parameters (?s - step) :duration (= ?duration 2400)
    :condition (and (at start (step_pending ?s))
                    (at start (spread_done))
                    (at start (washed_done))
                    (at start (placed_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (roasted_done))))
  (:durative-action do_step5 :parameters (?s - step) :duration (= ?duration 900)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (preheated_done))))
  (:durative-action do_step6 :parameters (?s - step) :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s))
                    (at start (preheated_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (washed_done))))
  (:durative-action do_step7 :parameters (?s - step) :duration (= ?duration 1200)
    :condition (and (at start (step_pending ?s))
                    (at start (purchased_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (chopped_done))))
  (:durative-action do_step8 :parameters (?s - step) :duration (= ?duration 60)
    :condition (and (at start (step_pending ?s))
                    (at start (tossed_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (lined_done))))
  (:durative-action do_step9 :parameters (?s - step) :duration (= ?duration 30)
    :condition (and (at start (step_pending ?s))
                    (at start (tossed_done))
                    (at start (spread_done))
                    (at start (lined_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (placed_done))))
  (:durative-action do_step10 :parameters (?s - step) :duration (= ?duration 300)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (deglazed_done))))
)