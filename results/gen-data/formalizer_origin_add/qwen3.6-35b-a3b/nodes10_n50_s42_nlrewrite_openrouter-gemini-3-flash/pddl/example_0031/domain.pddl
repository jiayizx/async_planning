(define (domain photograph_rugs)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (vacuum_done)
    (camera_setup_done)
    (lighting_selected_done)
    (transport_done)
    (light_test_done)
    (position_done)
    (steam_done)
    (tag_done)
    (photo_taken_done)
    (clear_done))
  
  (:durative-action step1_vacuum
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s))
                    (at start (transport_done))
                    (at start (tag_done))
                    (at start (clear_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (vacuum_done))))

  (:durative-action step2_camera_setup
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (and (at start (step_pending ?s))
                    (at start (vacuum_done))
                    (at start (transport_done))
                    (at start (position_done))
                    (at start (steam_done))
                    (at start (tag_done))
                    (at start (clear_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (camera_setup_done))))

  (:durative-action step3_lighting_select
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (lighting_selected_done))))

  (:durative-action step4_transport
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s))
                    (at start (clear_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (transport_done))))

  (:durative-action step5_light_test
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s))
                    (at start (lighting_selected_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (light_test_done))))

  (:durative-action step6_position
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (and (at start (step_pending ?s))
                    (at start (vacuum_done))
                    (at start (transport_done))
                    (at start (steam_done))
                    (at start (tag_done))
                    (at start (clear_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (position_done))))

  (:durative-action step7_steam
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s))
                    (at start (vacuum_done))
                    (at start (transport_done))
                    (at start (tag_done))
                    (at start (clear_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (steam_done))))

  (:durative-action step8_tag
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending ?s))
                    (at start (transport_done))
                    (at start (clear_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (tag_done))))

  (:durative-action step9_photo
    :parameters (?s - step)
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s))
                    (at start (vacuum_done))
                    (at start (camera_setup_done))
                    (at start (transport_done))
                    (at start (position_done))
                    (at start (steam_done))
                    (at start (tag_done))
                    (at start (clear_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (photo_taken_done))))

  (:durative-action step10_clear
    :parameters (?s - step)
    :duration (= ?duration 2700)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (clear_done))))
)