(define (domain herbarium_domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_done ?s - step)
    (step_pending ?s - step)
    (specimens_collected)
    (paper_purchased)
    (flora_researched)
    (adhesive_prepared)
    (sheets_stored)
    (plants_dried)
    (specimens_labeled)
    (layout_arranged)
    (specimens_trimmed)
    (plants_secured))
  (:durative-action collect_specimens
    (:duration 14400)
    (:condition (and (at start (step_pending ?s)) (at start (flora_researched))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (specimens_collected)))))
  (:durative-action purchase_paper
    (:duration 3600)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (paper_purchased)))))
  (:durative-action research_flora
    (:duration 7200)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (flora_researched)))))
  (:durative-action prepare_adhesive
    (:duration 900)
    (:condition (and (at start (step_pending ?s)) (at start (paper_purchased))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (adhesive_prepared)))))
  (:durative-action store_sheets
    (:duration 1800)
    (:condition (and (at start (step_pending ?s)) (at start (plants_dried))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (sheets_stored)))))
  (:durative-action press_dry_plants
    (:duration 604800)
    (:condition (and (at start (step_pending ?s)) 
                     (at start (specimens_collected)) 
                     (at start (flora_researched)) 
                     (at start (specimens_trimmed))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (plants_dried)))))
  (:durative-action label_specimens
    (:duration 1200)
    (:condition (and (at start (step_pending ?s)) 
                     (at start (specimens_collected)) 
                     (at start (layout_arranged))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (specimens_labeled)))))
  (:durative-action arrange_layout
    (:duration 2700)
    (:condition (and (at start (step_pending ?s)) 
                     (at start (paper_purchased)) 
                     (at start (plants_dried))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (layout_arranged)))))
  (:durative-action trim_specimens
    (:duration 1800)
    (:condition (and (at start (step_pending ?s)) (at start (specimens_collected))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (specimens_trimmed)))))
  (:durative-action secure_plants
    (:duration 7200)
    (:condition (and (at start (step_pending ?s)) 
                     (at start (adhesive_prepared)) 
                     (at start (layout_arranged))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (plants_secured)))))
)