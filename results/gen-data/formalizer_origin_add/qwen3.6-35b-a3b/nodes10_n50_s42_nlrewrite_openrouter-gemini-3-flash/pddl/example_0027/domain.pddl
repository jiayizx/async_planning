(define (domain ceviche_domain)
  (:requirements :typing :durative-actions)
  (:types step)
  (:predicates 
    (step-pending ?s - step)
    (step-done ?s - step)
    (sharpen_knife_done)
    (garnish_plate_done)
    (toss_fish_done)
    (cure_fish_done)
    (wash_cilantro_done)
    (mince_aromatics_done)
    (source_seabass_done)
    (slice_onions_done)
    (plate_ceviche_done)
    (dice_fish_done)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (step-pending ?s))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (sharpen_knife_done)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (at start (and (step-pending ?s) (source_seabass_done) (plate_ceviche_done)))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (garnish_plate_done)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (at start (and (step-pending ?s) (mince_aromatics_done)))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (toss_fish_done)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (at start (and (step-pending ?s) (toss_fish_done)))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (cure_fish_done)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 180)
    :condition (at start (step-pending ?s))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (wash_cilantro_done)))
  )
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (at start (and (step-pending ?s) (wash_cilantro_done) (slice_onions_done)))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (mince_aromatics_done)))
  )
  (:durative-action do_step7
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (at start (step-pending ?s))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (source_seabass_done)))
  )
  (:durative-action do_step8
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (and (step-pending ?s) (wash_cilantro_done)))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (slice_onions_done)))
  )
  (:durative-action do_step9
    :parameters (?s - step)
    :duration (= ?duration 180)
    :condition (at start (and (step-pending ?s) (dice_fish_done)))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (plate_ceviche_done)))
  )
  (:durative-action do_step10
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (at start (and (step-pending ?s) (sharpen_knife_done) (source_seabass_done)))
    :effect (and (at start (not (step-pending ?s)))
                 (at end (step-done ?s))
                 (at end (dice_fish_done)))
  )
)