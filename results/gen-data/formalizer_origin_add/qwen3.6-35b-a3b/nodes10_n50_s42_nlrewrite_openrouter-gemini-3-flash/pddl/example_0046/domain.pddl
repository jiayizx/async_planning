(define (domain marathon_prep)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (shoes_purchased)
    (training_done)
    (practice_run_done)
    (rest_done)
    (carbo_loaded)
    (physician_consulted)
    (registered)
    (research_done)
    (bib_picked_up)
    (marathon_run))
  (:durative-action step1 :parameters (?s - step) :duration (= ?duration 2700)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (shoes_purchased))))
  (:durative-action step2 :parameters (?s - step) :duration (= ?duration 6048000)
    :condition (and (at start (step_pending ?s)) (at start (physician_consulted)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (training_done))))
  (:durative-action step3 :parameters (?s - step) :duration (= ?duration 14400)
    :condition (and (at start (step_pending ?s)) (at start (training_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (practice_run_done))))
  (:durative-action step4 :parameters (?s - step) :duration (= ?duration 604800)
    :condition (and (at start (step_pending ?s)) (at start (carbo_loaded)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (rest_done))))
  (:durative-action step5 :parameters (?s - step) :duration (= ?duration 172800)
    :condition (and (at start (step_pending ?s)) (at start (practice_run_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (carbo_loaded))))
  (:durative-action step6 :parameters (?s - step) :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s)) (at start (research_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (physician_consulted))))
  (:durative-action step7 :parameters (?s - step) :duration (= ?duration 1200)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (registered))))
  (:durative-action step8 :parameters (?s - step) :duration (= ?duration 7200)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (research_done))))
  (:durative-action step9 :parameters (?s - step) :duration (= ?duration 5400)
    :condition (and (at start (step_pending ?s)) (at start (shoes_purchased)) (at start (registered)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (bib_picked_up))))
  (:durative-action step10 :parameters (?s - step) :duration (= ?duration 18000)
    :condition (and (at start (step_pending ?s)) (at start (rest_done)) (at start (bib_picked_up)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (marathon_run)))))