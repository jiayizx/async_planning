(define (domain lemon_bars_domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step)
               (step_done ?s - step)
               (oven_preheated)
               (filling_whisked)
               (lemons_juiced)
               (crust_dough_prepared)
               (bars_baked))
  (:durative-action step1_preheat_oven
    (:parameters (?s - step))
    (:duration 900)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (oven_preheated)))))
  (:durative-action step2_whisk_filling
    (:parameters (?s - step))
    (:duration 300)
    (:condition (and (at start (step_pending ?s))
                     (at start (lemons_juiced))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (filling_whisked)))))
  (:durative-action step3_zest_juice_lemons
    (:parameters (?s - step))
    (:duration 600)
    (:condition (at start (step_pending ?s)))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (lemons_juiced)))))
  (:durative-action step4_prepare_crust
    (:parameters (?s - step))
    (:duration 720)
    (:condition (and (at start (step_pending ?s))
                     (at start (lemons_juiced))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (crust_dough_prepared)))))
  (:durative-action step5_bake_bars
    (:parameters (?s - step))
    (:duration 1500)
    (:condition (and (at start (step_pending ?s))
                     (at start (oven_preheated))
                     (at start (filling_whisked))
                     (at start (crust_dough_prepared))))
    (:effect (and (at start (not (step_pending ?s)))
                  (at end (step_done ?s))
                  (at end (bars_baked)))))
)