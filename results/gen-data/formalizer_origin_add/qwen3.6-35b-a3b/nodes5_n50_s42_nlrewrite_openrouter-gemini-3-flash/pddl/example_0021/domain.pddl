(define (domain liver_disease_treatment)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates 
    (step_pending ?s - step)
    (step_done ?s - step)
    (step2_done)
    (step1_done)
    (step5_done)
    (step4_done)
    (step3_done))
  (:durative-action do_step2 (?s - step)
    :duration (= ?duration 172800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (step2_done))))
  (:durative-action do_step1 (?s - step)
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending ?s))
                    (at start (step2_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (step1_done))))
  (:durative-action do_step5 (?s - step)
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s))
                    (at start (step1_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (step5_done))))
  (:durative-action do_step4 (?s - step)
    :duration (= ?duration 2592000)
    :condition (and (at start (step_pending ?s))
                    (at start (step5_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (step4_done))))
  (:durative-action do_step3 (?s - step)
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending ?s))
                    (at start (step4_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (step3_done))))
)