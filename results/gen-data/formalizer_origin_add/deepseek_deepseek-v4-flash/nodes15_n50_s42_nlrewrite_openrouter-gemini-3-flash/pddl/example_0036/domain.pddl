(define (domain lox)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (slice_fish_done)
    (buy_salmon_done)
    (rub_mixture_done)
    (weigh_down_done)
    (remove_pin_bones_done)
    (toast_bagels_done)
    (buy_bagels_done)
    (mix_mixture_done)
    (clear_shelf_done)
    (line_dish_done)
    (rinse_salmon_done)
    (place_salmon_done)
    (cure_fridge_done)
    (prepare_garnish_done)
    (wrap_fish_done)
  )
  (:durative-action do_step1
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step1)) (at start (remove_pin_bones_done)) (at start (cure_fridge_done)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (slice_fish_done)))
  )
  (:durative-action do_step2
    :duration (= ?duration 1800)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (buy_salmon_done)))
  )
  (:durative-action do_step3
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step3)) (at start (mix_mixture_done)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (rub_mixture_done)))
  )
  (:durative-action do_step4
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step4)) (at start (place_salmon_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (weigh_down_done)))
  )
  (:durative-action do_step5
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step5)) (at start (buy_salmon_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (remove_pin_bones_done)))
  )
  (:durative-action do_step6
    :duration (= ?duration 240)
    :condition (and (at start (step_pending step6)) (at start (buy_bagels_done)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (toast_bagels_done)))
  )
  (:durative-action do_step7
    :duration (= ?duration 1200)
    :condition (at start (step_pending step7))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (buy_bagels_done)))
  )
  (:durative-action do_step8
    :duration (= ?duration 300)
    :condition (at start (step_pending step8))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (mix_mixture_done)))
  )
  (:durative-action do_step9
    :duration (= ?duration 600)
    :condition (at start (step_pending step9))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (clear_shelf_done)))
  )
  (:durative-action do_step10
    :duration (= ?duration 300)
    :condition (at start (step_pending step10))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (line_dish_done)))
  )
  (:durative-action do_step11
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step11)) (at start (buy_salmon_done)))
    :effect (and (at start (not (step_pending step11))) (at end (step_done step11)) (at end (rinse_salmon_done)))
  )
  (:durative-action do_step12
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step12)) (at start (line_dish_done)))
    :effect (and (at start (not (step_pending step12))) (at end (step_done step12)) (at end (place_salmon_done)))
  )
  (:durative-action do_step13
    :duration (= ?duration 259200)
    :condition (and (at start (step_pending step13)) (at start (clear_shelf_done)) (at start (wrap_fish_done)))
    :effect (and (at start (not (step_pending step13))) (at end (step_done step13)) (at end (cure_fridge_done)))
  )
  (:durative-action do_step14
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step14)) (at start (buy_salmon_done)) (at start (clear_shelf_done)))
    :effect (and (at start (not (step_pending step14))) (at end (step_done step14)) (at end (prepare_garnish_done)))
  )
  (:durative-action do_step15
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step15)) (at start (rub_mixture_done)))
    :effect (and (at start (not (step_pending step15))) (at end (step_done step15)) (at end (wrap_fish_done)))
  )
)