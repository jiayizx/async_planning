(define (domain rhubarb_prep)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates (step_pending ?s - step) (step_done ?s - step))
  (:durative-action harvest
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)))
  )
  (:durative-action sterilize
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)))
  )
  (:durative-action trim
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step3)) (at start (step_done step1)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)))
  )
  (:durative-action toss
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step4)) (at start (step_done step1)) (at start (step_done step3)) (at start (step_done step15)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)))
  )
  (:durative-action simmer
    :parameters ()
    :duration (= ?duration 720)
    :condition (and (at start (step_pending step5)) (at start (step_done step6)) (at start (step_done step8)) (at start (step_done step12)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)))
  )
  (:durative-action slice
    :parameters ()
    :duration (= ?duration 480)
    :condition (and (at start (step_pending step6)) (at start (step_done step8)) (at start (step_done step12)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)))
  )
  (:durative-action rinse
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step7)) (at start (step_done step1)) (at start (step_done step3)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)))
  )
  (:durative-action pat
    :parameters ()
    :duration (= ?duration 240)
    :condition (and (at start (step_pending step8)) (at start (step_done step12)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)))
  )
  (:durative-action macerate
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step9)) (at start (step_done step1)) (at start (step_done step3)) (at start (step_done step4)) (at start (step_done step15)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)))
  )
  (:durative-action compost
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step10)) (at start (step_done step1)) (at start (step_done step3)) (at start (step_done step11)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)))
  )
  (:durative-action gather
    :parameters ()
    :duration (= ?duration 60)
    :condition (at start (step_pending step11))
    :effect (and (at start (not (step_pending step11))) (at end (step_done step11)))
  )
  (:durative-action set_out
    :parameters ()
    :duration (= ?duration 30)
    :condition (at start (step_pending step12))
    :effect (and (at start (not (step_pending step12))) (at end (step_done step12)))
  )
  (:durative-action label
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step13)) (at start (step_done step2)))
    :effect (and (at start (not (step_pending step13))) (at end (step_done step13)))
  )
  (:durative-action ladle
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step14)) (at start (step_done step1)) (at start (step_done step3)) (at start (step_done step5)) (at start (step_done step6)) (at start (step_done step7)) (at start (step_done step8)) (at start (step_done step12)))
    :effect (and (at start (not (step_pending step14))) (at end (step_done step14)))
  )
  (:durative-action transfer
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step15)) (at start (step_done step1)) (at start (step_done step3)))
    :effect (and (at start (not (step_pending step15))) (at end (step_done step15)))
  )
)