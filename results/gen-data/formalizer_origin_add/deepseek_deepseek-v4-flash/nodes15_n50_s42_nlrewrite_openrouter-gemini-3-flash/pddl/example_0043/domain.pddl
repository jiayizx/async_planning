(define (domain beach_scene)
  (:requirements :durative-actions :typing)
  (:predicates
    (step1_pending) (step1_done) (wave_highlights_done)
    (step2_pending) (step2_done) (palm_outline_done)
    (step3_pending) (step3_done) (sky_gradient_done)
    (step4_pending) (step4_done) (sand_base_done)
    (step5_pending) (step5_done) (tape_edges_done)
    (step6_pending) (step6_done) (pencils_sharpened_done)
    (step7_pending) (step7_done) (horizon_line_done)
    (step8_pending) (step8_done) (supplies_gathered_done)
    (step9_pending) (step9_done) (paints_mixed_done)
    (step10_pending) (step10_done) (palm_fronds_colored_done)
    (step11_pending) (step11_done) (sailboat_drawn_done)
    (step12_pending) (step12_done) (workspace_cleaned_done)
    (step13_pending) (step13_done) (turquoise_water_layered_done)
    (step14_pending) (step14_done) (photos_researched_done)
    (step15_pending) (step15_done) (sand_dry_done)
  )
  (:durative-action add_final_white_highlights
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (and (step1_pending) (sand_base_done) (tape_edges_done) (pencils_sharpened_done) (turquoise_water_layered_done) (photos_researched_done) (sand_dry_done)))
    :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (wave_highlights_done)))
  )
  (:durative-action sketch_palm_outline
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (and (step2_pending) (photos_researched_done)))
    :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (palm_outline_done)))
  )
  (:durative-action paint_sky_gradient
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (and (step3_pending) (pencils_sharpened_done) (supplies_gathered_done) (photos_researched_done)))
    :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (sky_gradient_done)))
  )
  (:durative-action apply_sand_base
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (and (step4_pending) (tape_edges_done) (pencils_sharpened_done) (photos_researched_done)))
    :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (sand_base_done)))
  )
  (:durative-action tape_edges
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (and (step5_pending) (pencils_sharpened_done) (photos_researched_done)))
    :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (tape_edges_done)))
  )
  (:durative-action sharpen_pencils
    :parameters ()
    :duration (= ?duration 480)
    :condition (at start (and (step6_pending) (photos_researched_done)))
    :effect (and (at start (not (step6_pending))) (at end (step6_done)) (at end (pencils_sharpened_done)))
  )
  (:durative-action sketch_horizon
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (and (step7_pending) (supplies_gathered_done)))
    :effect (and (at start (not (step7_pending))) (at end (step7_done)) (at end (horizon_line_done)))
  )
  (:durative-action gather_supplies
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step8_pending))
    :effect (and (at start (not (step8_pending))) (at end (step8_done)) (at end (supplies_gathered_done)))
  )
  (:durative-action mix_paints
    :parameters ()
    :duration (= ?duration 720)
    :condition (at start (and (step9_pending) (supplies_gathered_done)))
    :effect (and (at start (not (step9_pending))) (at end (step9_done)) (at end (paints_mixed_done)))
  )
  (:durative-action color_palm_fronds
    :parameters ()
    :duration (= ?duration 1500)
    :condition (at start (and (step10_pending) (palm_outline_done) (photos_researched_done)))
    :effect (and (at start (not (step10_pending))) (at end (step10_done)) (at end (palm_fronds_colored_done)))
  )
  (:durative-action draw_sailboat
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (and (step11_pending) (horizon_line_done) (supplies_gathered_done) (workspace_cleaned_done)))
    :effect (and (at start (not (step11_pending))) (at end (step11_done)) (at end (sailboat_drawn_done)))
  )
  (:durative-action clean_workspace
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (step12_pending))
    :effect (and (at start (not (step12_pending))) (at end (step12_done)) (at end (workspace_cleaned_done)))
  )
  (:durative-action layer_turquoise_water
    :parameters ()
    :duration (= ?duration 2700)
    :condition (at start (and (step13_pending) (sand_base_done) (tape_edges_done) (pencils_sharpened_done) (photos_researched_done) (sand_dry_done)))
    :effect (and (at start (not (step13_pending))) (at end (step13_done)) (at end (turquoise_water_layered_done)))
  )
  (:durative-action research_photos
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (step14_pending))
    :effect (and (at start (not (step14_pending))) (at end (step14_done)) (at end (photos_researched_done)))
  )
  (:durative-action wait_sand_dry
    :parameters ()
    :duration (= ?duration 7200)
    :condition (at start (and (step15_pending) (sand_base_done) (tape_edges_done) (pencils_sharpened_done) (photos_researched_done)))
    :effect (and (at start (not (step15_pending))) (at end (step15_done)) (at end (sand_dry_done)))
  )
)