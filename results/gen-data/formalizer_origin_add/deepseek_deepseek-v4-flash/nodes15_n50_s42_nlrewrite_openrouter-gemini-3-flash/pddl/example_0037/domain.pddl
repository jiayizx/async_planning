    (walkthrough_done)
    (website_built)
    (license_applied)
    (speaker_secured)
    (market_research_done)
    (mixer_hosted)
  )
  (:durative-action do_step1
    :parameters ()
    :duration ( = ?duration 172800 )
    :condition (and (at start (step_pending step1)) (at start (course_completed)) (at start (business_registered)) (at start (license_applied)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (logo_designed)))
  )
