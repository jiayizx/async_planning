(define (domain event_promoter)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (logo_designed)
    (proposal_drafted)
    (social_profile_created)
    (course_completed)
    (contract_negotiated)
    (bank_account_setup)
    (business_registered)
