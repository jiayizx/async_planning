(define (domain paint-house)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (tape_dropcloth_obtained)
    (furniture_moved)
    (tape_removed_brushes_cleaned)
    (first_coat_applied)
    (patches_sanded)
    (drop_cloths_laid)
    (primer_applied)
    (palette_selected)
    (holes_patched)
    (paint_bought)
    (primer_dried)
    (walls_measured)
    (small_items_cleared)
    (second_coat_applied)
    (clear_coat_applied)
  )
  (:durative-action do_step1
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending step1)) (at start (walls_measured)) (at start (small_items_cleared)))
    :effect (and (at end (not (step_pending step1))) (at end (step_done step1)) (at end (tape_dropcloth_obtained)))
  )
  (:durative-action do_step2
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step2)) (at start (small_items_cleared)))
    :effect (and (at end (not (step_pending step2))) (at end (step_done step2)) (at end (furniture_moved)))
  )
  (:durative-action do_step3
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step3)) (at start (drop_cloths_laid)) (at start (clear_coat_applied)))
    :effect (and (at end (not (step_pending step3))) (at end (step_done step3)) (at end (tape_removed_brushes_cleaned)))
  )
  (:durative-action do_step4
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending step4)) (at start (tape_dropcloth_obtained)) (at start (drop_cloths_laid)) (at start (palette_selected)) (at start (paint_bought)) (at start (walls_measured)) (at start (small_items_cleared)))
    :effect (and (at end (not (step_pending step4))) (at end (step_done step4)) (at end (first_coat_applied)))
  )
  (:durative-action do_step5
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step5)) (at start (tape_dropcloth_obtained)) (at start (holes_patched)) (at start (walls_measured)) (at start (small_items_cleared)))
    :effect (and (at end (not (step_pending step5))) (at end (step_done step5)) (at end (patches_sanded)))
  )
  (:durative-action do_step6
    :duration (= ?duration 1200)
    :condition (at start (step_pending step6))
    :effect (and (at end (not (step_pending step6))) (at end (step_done step6)) (at end (drop_cloths_laid)))
  )
  (:durative-action do_step7
    :duration (= ?duration 10800)
    :condition (and (at start (step_pending step7)) (at start (tape_dropcloth_obtained)) (at start (patches_sanded)) (at start (holes_patched)) (at start (walls_measured)) (at start (small_items_cleared)))
    :effect (and (at end (not (step_pending step7))) (at end (step_done step7)) (at end (primer_applied)))
  )
  (:durative-action do_step8
    :duration (= ?duration 259200)
    :condition (at start (step_pending step8))
    :effect (and (at end (not (step_pending step8))) (at end (step_done step8)) (at end (palette_selected)))
  )
  (:durative-action do_step9
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step9)) (at start (tape_dropcloth_obtained)) (at start (walls_measured)) (at start (small_items_cleared)))
    :effect (and (at end (not (step_pending step9))) (at end (step_done step9)) (at end (holes_patched)))
  )
  (:durative-action do_step10
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step10)) (at start (palette_selected)))
    :effect (and (at end (not (step_pending step10))) (at end (step_done step10)) (at end (paint_bought)))
  )
  (:durative-action do_step11
    :duration (= ?duration 43200)
    :condition (and (at start (step_pending step11)) (at start (tape_dropcloth_obtained)) (at start (patches_sanded)) (at start (primer_applied)) (at start (holes_patched)) (at start (walls_measured)) (at start (small_items_cleared)))
    :effect (and (at end (not (step_pending step11))) (at end (step_done step11)) (at end (primer_dried)))
  )
  (:durative-action do_step12
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step12)) (at start (small_items_cleared)))
    :effect (and (at end (not (step_pending step12))) (at end (step_done step12)) (at end (walls_measured)))
  )
  (:durative-action do_step13
    :duration (= ?duration 7200)
    :condition (at start (step_pending step13))
    :effect (and (at end (not (step_pending step13))) (at end (step_done step13)) (at end (small_items_cleared)))
  )
  (:durative-action do_step14
    :duration (= ?duration 18000)
    :condition (and (at start (step_pending step14)) (at start (tape_dropcloth_obtained)) (at start (first_coat_applied)) (at start (drop_cloths_laid)) (at start (palette_selected)) (at start (paint_bought)) (at start (walls_measured)) (at start (small_items_cleared)))
    :effect (and (at end (not (step_pending step14))) (at end (step_done step14)) (at end (second_coat_applied)))
  )
  (:durative-action do_step15
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step15)) (at start (drop_cloths_laid)))
    :effect (and (at end (not (step_pending step15))) (at end (step_done step15)) (at end (clear_coat_applied)))
  )
)