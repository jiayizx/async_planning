(define (domain color_scheme)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (narrowed_swatches)
    (purchased_pots)
    (researched_effects)
    (applied_samples)
    (collected_inspiration)
    (created_moodboard)
    (consulted_designer)
    (observed_swatches)
    (compared_inspiration)
    (finalized_palette)
    (reviewed_budget)
    (drafted_accents)
    (browsed_galleries)
    (inventoried_furniture)
    (conducted_vibe_check)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step1)) (at start (reviewed_budget)) (at start (browsed_galleries)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (narrowed_swatches)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending step2)) (at start (compared_inspiration)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (purchased_pots)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step3)) (at start (browsed_galleries)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (researched_effects)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step4)) (at start (purchased_pots)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (applied_samples)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 10800)
    :condition (at start (step_pending step5))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (collected_inspiration)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending step6)) (at start (researched_effects)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (created_moodboard)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step7)) (at start (drafted_accents)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (consulted_designer)))
  )
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 86400)
    :condition (and (at start (step_pending step8)) (at start (narrowed_swatches)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (observed_swatches)))
  )
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step9)) (at start (collected_inspiration)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (compared_inspiration)))
  )
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step10)) (at start (inventoried_furniture)) (at start (conducted_vibe_check)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (finalized_palette)))
  )
  (:durative-action do_step11
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step11)) (at start (purchased_pots)) (at start (collected_inspiration)) (at start (inventoried_furniture)))
    :effect (and (at start (not (step_pending step11))) (at end (step_done step11)) (at end (reviewed_budget)))
  )
  (:durative-action do_step12
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (step_pending step12))
    :effect (and (at start (not (step_pending step12))) (at end (step_done step12)) (at end (drafted_accents)))
  )
  (:durative-action do_step13
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (step_pending step13))
    :effect (and (at start (not (step_pending step13))) (at end (step_done step13)) (at end (browsed_galleries)))
  )
  (:durative-action do_step14
    :parameters ()
    :duration (= ?duration 2400)
    :condition (at start (step_pending step14))
    :effect (and (at start (not (step_pending step14))) (at end (step_done step14)) (at end (inventoried_furniture)))
  )
  (:durative-action do_step15
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step15)) (at start (observed_swatches)))
    :effect (and (at start (not (step_pending step15))) (at end (step_done step15)) (at end (conducted_vibe_check)))
  )
)