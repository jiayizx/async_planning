(define (domain chicken_curry)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants
    step1 step2 step3 step4 step5 step6 step7 step8 step9 step10
    step11 step12 step13 step14 step15 step16 step17 step18 step19 step20 - step
  )
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (sauted_chicken_done)
    (diced_onions_done)
    (measured_spices_done)
    (simmered_curry_done)
    (prepared_coconut_garnish_done)
    (washed_rice_done)
    (peeled_ginger_done)
    (toasted_cumin_done)
    (bloomed_turmeric_done)
    (ground_spices_done)
    (bought_ingredients_done)
    (soaked_rice_done)
    (plated_curry_done)
    (mixed_marinade_done)
    (sharpened_knives_done)
    (minced_garlic_done)
    (combined_chicken_garnish_done)
    (prepared_raita_done)
    (boiled_rice_done)
    (cleaned_mortar_done)
  )
  (:durative-action do_step1
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step1)) (at start (measured_spices_done)) (at start (toasted_cumin_done)) (at start (ground_spices_done)) (at start (mixed_marinade_done)) (at start (cleaned_mortar_done)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (sauted_chicken_done)))
  )
  (:durative-action do_step2
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step2)) (at start (peeled_ginger_done)) (at start (bought_ingredients_done)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (diced_onions_done)))
  )
  (:durative-action do_step3
    :duration (= ?duration 120)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (measured_spices_done)))
  )
  (:durative-action do_step4
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending step4)) (at start (toasted_cumin_done)) (at start (bloomed_turmeric_done)) (at start (bought_ingredients_done)) (at start (sharpened_knives_done)) (at start (minced_garlic_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (simmered_curry_done)))
  )
  (:durative-action do_step5
    :duration (= ?duration 180)
    :condition (at start (step_pending step5))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (prepared_coconut_garnish_done)))
  )
  (:durative-action do_step6
    :duration (= ?duration 240)
    :condition (at start (step_pending step6))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (washed_rice_done)))
  )
  (:durative-action do_step7
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step7)) (at start (bought_ingredients_done)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (peeled_ginger_done)))
  )
  (:durative-action do_step8
    :duration (= ?duration 60)
    :condition (at start (step_pending step8))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (toasted_cumin_done)))
  )
  (:durative-action do_step9
    :duration (= ?duration 30)
    :condition (at start (step_pending step9))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (bloomed_turmeric_done)))
  )
  (:durative-action do_step10
    :duration (= ?duration 240)
    :condition (and (at start (step_pending step10)) (at start (toasted_cumin_done)) (at start (cleaned_mortar_done)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (ground_spices_done)))
  )
  (:durative-action do_step11
    :duration (= ?duration 3600)
    :condition (at start (step_pending step11))
    :effect (and (at start (not (step_pending step11))) (at end (step_done step11)) (at end (bought_ingredients_done)))
  )
  (:durative-action do_step12
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step12)) (at start (washed_rice_done)))
    :effect (and (at start (not (step_pending step12))) (at end (step_done step12)) (at end (soaked_rice_done)))
  )
  (:durative-action do_step13
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step13)) (at start (washed_rice_done)) (at start (toasted_cumin_done)) (at start (soaked_rice_done)) (at start (boiled_rice_done)) (at start (cleaned_mortar_done)))
    :effect (and (at start (not (step_pending step13))) (at end (step_done step13)) (at end (plated_curry_done)))
  )
  (:durative-action do_step14
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step14)) (at start (measured_spices_done)) (at start (toasted_cumin_done)) (at start (ground_spices_done)) (at start (cleaned_mortar_done)))
    :effect (and (at start (not (step_pending step14))) (at end (step_done step14)) (at end (mixed_marinade_done)))
  )
  (:durative-action do_step15
    :duration (= ?duration 480)
    :condition (and (at start (step_pending step15)) (at start (bought_ingredients_done)))
    :effect (and (at start (not (step_pending step15))) (at end (step_done step15)) (at end (sharpened_knives_done)))
  )
  (:durative-action do_step16
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step16)) (at start (bought_ingredients_done)) (at start (sharpened_knives_done)))
    :effect (and (at start (not (step_pending step16))) (at end (step_done step16)) (at end (minced_garlic_done)))
  )
  (:durative-action do_step17
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step17)) (at start (sauted_chicken_done)) (at start (measured_spices_done)) (at start (prepared_coconut_garnish_done)) (at start (toasted_cumin_done)) (at start (ground_spices_done)) (at start (mixed_marinade_done)) (at start (cleaned_mortar_done)))
    :effect (and (at start (not (step_pending step17))) (at end (step_done step17)) (at end (combined_chicken_garnish_done)))
  )
  (:durative-action do_step18
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step18)) (at start (bloomed_turmeric_done)))
    :effect (and (at start (not (step_pending step18))) (at end (step_done step18)) (at end (prepared_raita_done)))
  )
  (:durative-action do_step19
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step19)) (at start (washed_rice_done)) (at start (toasted_cumin_done)) (at start (soaked_rice_done)) (at start (cleaned_mortar_done)))
    :effect (and (at start (not (step_pending step19))) (at end (step_done step19)) (at end (boiled_rice_done)))
  )
  (:durative-action do_step20
    :duration (= ?duration 360)
    :condition (and (at start (step_pending step20)) (at start (toasted_cumin_done)))
    :effect (and (at start (not (step_pending step20))) (at end (step_done step20)) (at end (cleaned_mortar_done)))
  )
)