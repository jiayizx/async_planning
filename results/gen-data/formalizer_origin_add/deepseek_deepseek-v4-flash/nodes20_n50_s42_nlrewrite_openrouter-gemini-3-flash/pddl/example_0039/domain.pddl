(define (domain playground)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 step4 step5 step6 step7 step8 step9 step10 step11 step12 step13 step14 step15 step16 step17 step18 step19 step20 - step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (sunscreen_applied)
    (keys_found)
    (sand_toys_unpacked)
    (granola_eaten)
    (snack_bag_packed)
    (at_park_entrance)
    (slide_turn_waited)
    (hand_sanitized)
    (sandcastle_built)
    (slide_temp_checked)
    (rope_ladder_climbed)
    (tire_swung)
    (bench_found)
    (slide_down_done)
    (rested)
    (gate_entered)
    (at_sandbox)
    (stroller_unlocked)
    (woodchips_crossed)
    (water_fountain_reached)
  )
  (:durative-action a1
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (sunscreen_applied)))
  )
  (:durative-action a2
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (keys_found)))
  )
  (:durative-action a3
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step3)) (at start (woodchips_crossed)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (sand_toys_unpacked)))
  )
  (:durative-action a4
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step4)) (at start (snack_bag_packed)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (granola_eaten)))
  )
  (:durative-action a5
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step5))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (snack_bag_packed)))
  )
  (:durative-action a6
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step6)) (at start (sunscreen_applied)) (at start (stroller_unlocked)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (at_park_entrance)))
  )
  (:durative-action a7
    :parameters ()
    :duration (= ?duration 240)
    :condition (and (at start (step_pending step7)) (at start (rope_ladder_climbed)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (slide_turn_waited)))
  )
  (:durative-action a8
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step8)) (at start (at_sandbox)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (hand_sanitized)))
  )
  (:durative-action a9
    :parameters ()
    :duration (= ?duration 1500)
    :condition (and (at start (step_pending step9)) (at start (sunscreen_applied)) (at start (sand_toys_unpacked)) (at start (at_sandbox)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (sandcastle_built)))
  )
  (:durative-action a10
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step10)) (at start (gate_entered)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (slide_temp_checked)))
  )
  (:durative-action a11
