    :effect (and (at start (not (step_pending step11))) (at end (step_done step11)) (at end (rope_ladder_climbed)))
  )
  (:durative-action a12
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step12)) (at start (gate_entered)))
    :effect (and (at start (not (step_pending step12))) (at end (step_done step12)) (at end (tire_swung)))
  )
