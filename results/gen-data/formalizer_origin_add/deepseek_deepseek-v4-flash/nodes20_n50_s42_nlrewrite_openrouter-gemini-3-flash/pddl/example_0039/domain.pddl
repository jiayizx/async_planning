    :duration (= ?duration 600)
    :condition (and (at start (step_pending step15)) (at start (bench_found)))
    :effect (and (at start (not (step_pending step15))) (at end (step_done step15)) (at end (rested)))
  )
  (:durative-action a16
    :parameters ()
    :duration (= ?duration 30)
    :condition (and (at start (step_pending step16)) (at start (sunscreen_applied)))
    :effect (and (at start (not (step_pending step16))) (at end (step_done step16)) (at end (gate_entered)))
  )
  (:durative-action a17
    :parameters ()
