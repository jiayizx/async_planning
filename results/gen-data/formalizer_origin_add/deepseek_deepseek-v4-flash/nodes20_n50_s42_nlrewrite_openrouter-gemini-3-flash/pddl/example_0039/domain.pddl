  (:durative-action a19
    :parameters ()
    :duration (= ?duration 45)
    :condition (and (at start (step_pending step19)) (at start (hand_sanitized)) (at start (rope_ladder_climbed)))
    :effect (and (at start (not (step_pending step19))) (at end (step_done step19)) (at end (woodchips_crossed)))
  )
  (:durative-action a20
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step20)) (at start (slide_down_done)))
    :effect (and (at start (not (step_pending step20))) (at end (step_done step20)) (at end (water_fountain_reached)))
  )
)