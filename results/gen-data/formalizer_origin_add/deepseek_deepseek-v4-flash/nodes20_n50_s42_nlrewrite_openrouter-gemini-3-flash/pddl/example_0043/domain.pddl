    (dutch_oven_preheated)
    (cheese_grater_located)
    (napkins_ironed)
    (workstation_prepared)
    (counter_cleaned)
    (sauce_reduced)
    (spices_measured)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 600)
    :condition (and (at start (step_pending step1)) 
                    (at start (canned_tomatoes_opened)) 
                    (at start (ground_beef_thawed)) 
                    (at start (water_boiled)) 
                    (at start (knife_sharpened)) 
                    (at start (napkins_ironed)) 
                    (at start (workstation_prepared)) 
                    (at start (counter_cleaned)) 
                    (at start (spices_measured)))
    :effect (and (at start (not (step_pending step1))) 
                 (at end (step_done step1)) 
                 (at end (onions_garlic_chopped)))
  )
