(define (domain dinner_domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (onions_garlic_chopped)
    (tomato_sauce_simmered)
    (canned_tomatoes_opened)
    (ground_beef_thawed)
    (fresh_basil_washed)
    (dining_table_set)
    (basil_minced)
    (vegetables_sauteed)
    (final_stew_combined)
