    :parameters (?s - step)
    :duration (= ?duration 10800)
    :condition (and (at start (step_pending ?s))
                    (at start (done_7)) (at start (done_9))
                    (at start (done_10)) (at start (done_14))
                    (at start (done_15)) (at start (done_18))
                    (at start (done_19)))
    :effect (and (at start (not (step_pending ?s)))
