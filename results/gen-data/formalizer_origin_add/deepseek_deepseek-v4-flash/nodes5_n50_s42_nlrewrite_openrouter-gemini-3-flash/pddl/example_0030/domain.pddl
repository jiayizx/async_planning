(define (domain canoe_making)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 step4 step5 - step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (planks_sourced)
    (hull_assembled)
    (varnish_applied)
    (seats_installed)
    (sanded)
  )
  (:durative-action do_apply_varnish
    :parameters ()
    :duration (= ?duration 172800)
    :condition (and (at start (step_pending step1)) (at start (hull_assembled)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (varnish_applied)))
  )
  (:durative-action do_source_planks
    :parameters ()
    :duration (= ?duration 10800)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (planks_sourced)))
  )
  (:durative-action do_assemble_hull
    :parameters ()
    :duration (= ?duration 432000)
    :condition (and (at start (step_pending step3)) (at start (planks_sourced)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (hull_assembled)))
  )
  (:durative-action do_install_seats
    :parameters ()
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending step4)) (at start (hull_assembled)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (seats_installed)))
  )
  (:durative-action do_sand_exterior
    :parameters ()
    :duration (= ?duration 21600)
    :condition (and (at start (step_pending step5)) (at start (hull_assembled)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (sanded)))
  )
)