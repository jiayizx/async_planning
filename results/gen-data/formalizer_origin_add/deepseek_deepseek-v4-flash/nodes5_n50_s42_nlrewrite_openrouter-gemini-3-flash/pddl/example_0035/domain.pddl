(define (domain buy_stamps)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (balance_checked)
    (wallet_located)
    (walked_to_po)
    (stamps_purchased)
    (stamps_affixed)
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (balance_checked)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 180)
    :condition (at start (step_pending step4))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (wallet_located)))
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 900)
    :condition (and (at start (step_pending step1))
                    (at start (wallet_located)))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (walked_to_po)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 240)
    :condition (and (at start (step_pending step5))
                    (at start (walked_to_po))
                    (at start (balance_checked)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (stamps_purchased)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step3))
                    (at start (stamps_purchased)))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (stamps_affixed)))
  )
)