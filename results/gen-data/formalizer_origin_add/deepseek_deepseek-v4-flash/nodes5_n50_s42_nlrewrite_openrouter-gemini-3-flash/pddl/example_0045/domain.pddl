(define (domain makeup)
  (:requirements :durative-actions)
  (:predicates
    (moisturizer_pending)
    (moisturizer_applied)
    (primer_pending)
    (primer_set)
    (foundation_pending)
    (foundation_blended)
    (setting_powder_pending)
    (setting_powder_buffed)
    (mist_pending)
    (finishing_mist_sprayed)
  )
  (:durative-action apply_moisturizer
    :duration (= ?duration 120)
    :condition (at start (moisturizer_pending))
    :effect (and (at start (not (moisturizer_pending))) (at end (moisturizer_applied)))
  )
  (:durative-action let_primer_set
    :duration (= ?duration 180)
    :condition (and (at start (primer_pending)) (at start (moisturizer_applied)))
    :effect (and (at start (not (primer_pending))) (at end (primer_set)))
  )
  (:durative-action blend_foundation
    :duration (= ?duration 300)
    :condition (and (at start (foundation_pending)) (at start (moisturizer_applied)) (at start (primer_set)))
    :effect (and (at start (not (foundation_pending))) (at end (foundation_blended)))
  )
  (:durative-action buff_setting_powder
    :duration (= ?duration 240)
    :condition (and (at start (setting_powder_pending)) (at start (moisturizer_applied)) (at start (primer_set)) (at start (foundation_blended)))
    :effect (and (at start (not (setting_powder_pending))) (at end (setting_powder_buffed)))
  )
  (:durative-action spray_mist
    :duration (= ?duration 30)
    :condition (and (at start (mist_pending)) (at start (moisturizer_applied)) (at start (primer_set)) (at start (foundation_blended)) (at start (setting_powder_buffed)))
    :effect (and (at start (not (mist_pending))) (at end (finishing_mist_sprayed)))
  )
)