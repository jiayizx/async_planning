(define (domain self_analysis)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (review_done)
    (create_list_done)
    (purchase_done)
    (write_report_done)
    (schedule_done)
  )
  (:durative-action do_review
    :parameters ()
    :duration (= ?duration 7200)
    :condition (at start (and (step_pending step1) (create_list_done)))
    :effect (and (at start (not (step_pending step1)))
                 (at end (step_done step1))
                 (at end (review_done)))
  )
  (:durative-action do_create_list
    :parameters ()
    :duration (= ?duration 2700)
    :condition (at start (and (step_pending step2) (purchase_done)))
    :effect (and (at start (not (step_pending step2)))
                 (at end (step_done step2))
                 (at end (create_list_done)))
  )
  (:durative-action do_purchase
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3)))
                 (at end (step_done step3))
                 (at end (purchase_done)))
  )
  (:durative-action do_write_report
    :parameters ()
    :duration (= ?duration 3600)
    :condition (at start (and (step_pending step4) (review_done)))
    :effect (and (at start (not (step_pending step4)))
                 (at end (step_done step4))
                 (at end (write_report_done)))
  )
  (:durative-action do_schedule
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (and (step_pending step5) (purchase_done)))
    :effect (and (at start (not (step_pending step5)))
                 (at end (step_done step5))
                 (at end (schedule_done)))
  )
)