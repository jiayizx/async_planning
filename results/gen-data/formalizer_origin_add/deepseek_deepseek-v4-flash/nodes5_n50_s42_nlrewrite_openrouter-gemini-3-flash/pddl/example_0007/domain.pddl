(define (domain leave_house)
    (:requirements :durative-actions :typing)
    (:predicates
        (step1_pending)
        (step1_done)
        (step2_pending)
        (step2_done)
        (step3_pending)
        (step3_done)
        (step4_pending)
        (step4_done)
        (step5_pending)
        (step5_done)
        (house_checked)
        (keys_grabbed)
        (shoes_on)
        (door_locked)
        (garage_open)
    )
    (:durative-action do_step5
        :parameters ()
        :duration (= ?duration 180)
        :condition (at start (step5_pending))
        :effect (and (at start (not (step5_pending))) (at end (step5_done)) (at end (house_checked)))
    )
    (:durative-action do_step3
        :parameters ()
        :duration (= ?duration 10)
        :condition (and (at start (step3_pending)) (at start (house_checked)))
        :effect (and (at start (not (step3_pending))) (at end (step3_done)) (at end (keys_grabbed)))
    )
    (:durative-action do_step1
        :parameters ()
        :duration (= ?duration 120)
        :condition (and (at start (step1_pending)) (at start (keys_grabbed)) (at start (house_checked)))
        :effect (and (at start (not (step1_pending))) (at end (step1_done)) (at end (shoes_on)))
    )
    (:durative-action do_step4
        :parameters ()
        :duration (= ?duration 15)
        :condition (and (at start (step4_pending)) (at start (keys_grabbed)) (at start (house_checked)))
        :effect (and (at start (not (step4_pending))) (at end (step4_done)) (at end (garage_open)))
    )
    (:durative-action do_step2
        :parameters ()
        :duration (= ?duration 45)
        :condition (and (at start (step2_pending)) (at start (shoes_on)) (at start (keys_grabbed)) (at start (house_checked)))
        :effect (and (at start (not (step2_pending))) (at end (step2_done)) (at end (door_locked)))
    )
)