(define (domain fresh_herbs)
  (:requirements :durative-actions :typing)
  (:types step)
  (:constants step1 step2 step3 step4 step5 - step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (space_cleared)
    (led_installed)
    (seeds_purchased)
    (seeds_sown)
    (seedlings_transplanted)
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 1800)
    :condition (at start (step_pending step5))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (space_cleared)))
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending step1)) (at start (space_cleared)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (led_installed)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 259200)
    :condition (and (at start (step_pending step2)) (at start (space_cleared)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (seeds_purchased)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 1209600)
    :condition (and (at start (step_pending step3)) (at start (seeds_purchased)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (seeds_sown)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending step4)) (at start (seeds_purchased)) (at start (seeds_sown)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (seedlings_transplanted)))
  )
)