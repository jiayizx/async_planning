(define (domain corn_soup)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (prep_done)
    (shuck_done)
    (saute_done)
    (simmer_done)
    (blend_done)
  )
  (:durative-action do_prep
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (prep_done)))
  )
  (:durative-action do_shuck
    :parameters (?s - step)
    :duration (= ?duration 240)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (shuck_done)))
  )
  (:durative-action do_saute
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (and (at start (step_pending ?s)) (at start (prep_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (saute_done)))
  )
  (:durative-action do_simmer
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending ?s)) (at start (saute_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (simmer_done)))
  )
  (:durative-action do_blend
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (and (at start (step_pending ?s)) (at start (shuck_done)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (blend_done)))
  )
)
