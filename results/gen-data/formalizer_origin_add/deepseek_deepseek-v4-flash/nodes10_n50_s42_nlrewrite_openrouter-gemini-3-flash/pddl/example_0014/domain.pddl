(define (domain salad)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (soak_done)
    (dice_done)
    (whisk_done)
    (chill_done)
    (combine_done)
    (garnish_done)
    (mince_done)
    (boil_done)
    (pour_done)
    (wash_done)
  )
  (:durative-action do_soak
    :parameters ()
    :duration (= ?duration 43200)
    :condition (at start (step_pending step1))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (soak_done)))
  )
  (:durative-action do_dice
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (dice_done)))
  )
  (:durative-action do_whisk
    :parameters ()
    :duration (= ?duration 300)
    :condition (and (at start (step_pending step3)) (at start (dice_done)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (whisk_done)))
  )
  (:durative-action do_chill
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step4)) (at start (whisk_done)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (chill_done)))
  )
  (:durative-action do_combine
    :parameters ()
    :duration (= ?duration 120)
    :condition (and (at start (step_pending step5)) (at start (boil_done)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (combine_done)))
  )
  (:durative-action do_garnish
    :parameters ()
    :duration (= ?duration 60)
    :condition (and (at start (step_pending step6)) (at start (wash_done)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (garnish_done)))
  )
  (:durative-action do_mince
    :parameters ()
    :duration (= ?duration 180)
    :condition (and (at start (step_pending step7)) (at start (chill_done)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (mince_done)))
  )
  (:durative-action do_boil
    :parameters ()
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending step8)) (at start (soak_done)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (boil_done)))
  )
  (:durative-action do_pour
    :parameters ()
    :duration (= ?duration 240)
    :condition (and (at start (step_pending step9)) (at start (dice_done)) (at start (whisk_done)) (at start (mince_done)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (pour_done)))
  )
  (:durative-action do_wash
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (step_pending step10))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (wash_done)))
  )
)