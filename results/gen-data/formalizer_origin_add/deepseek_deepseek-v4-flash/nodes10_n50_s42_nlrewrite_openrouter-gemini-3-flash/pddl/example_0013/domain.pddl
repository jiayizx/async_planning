(define (domain join_band)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
  )
  (:durative-action do_orientation
    :parameters ()
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending step1)) (at start (step_done step10)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)))
  )
  (:durative-action do_rent
    :parameters ()
    :duration (= ?duration 2700)
    :condition (at start (step_pending step2))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)))
  )
  (:durative-action do_medical
    :parameters ()
    :duration (= ?duration 259200)
    :condition (and (at start (step_pending step3)) (at start (step_done step1)))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)))
  )
  (:durative-action do_camp
    :parameters ()
    :duration (= ?duration 604800)
    :condition (and (at start (step_pending step4)) (at start (step_done step6)) (at start (step_done step8)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)))
  )
  (:durative-action do_perform
    :parameters ()
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending step5)) (at start (step_done step7)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)))
  )
  (:durative-action do_lessons
    :parameters ()
    :duration (= ?duration 1209600)
    :condition (and (at start (step_pending step6)) (at start (step_done step2)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)))
  )
  (:durative-action do_practice
    :parameters ()
    :duration (= ?duration 345600)
    :condition (and (at start (step_pending step7)) (at start (step_done step4)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)))
  )
  (:durative-action do_audition
    :parameters ()
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending step8)) (at start (step_done step3)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)))
  )
  (:durative-action do_uniform
    :parameters ()
    :duration (= ?duration 2592000)
    :condition (and (at start (step_pending step9)) (at start (step_done step1)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)))
  )
  (:durative-action do_form
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (step_pending step10))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)))
  )
)