(define (domain color-house)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (paint_purchased)
    (tape_applied)
    (artwork_hung)
    (furniture_moved)
    (first_coat_done)
    (color_researched)
    (trim_painted)
    (walls_cleaned)
    (drop_cloths_laid)
    (decor_unpacked)
  )
  (:durative-action do_step1
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (and (at start (step_pending ?s)) (at start (color_researched)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (paint_purchased)))
  )
  (:durative-action do_step2
    :parameters (?s - step)
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s)) (at start (furniture_moved)) (at start (walls_cleaned)) (at start (drop_cloths_laid)) (at start (paint_purchased)) (at start (color_researched)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (tape_applied)))
  )
  (:durative-action do_step3
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (and (at start (step_pending ?s)) (at start (decor_unpacked)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (artwork_hung)))
  )
  (:durative-action do_step4
    :parameters (?s - step)
    :duration (= ?duration 2700)
    :condition (and (at start (step_pending ?s)) (at start (walls_cleaned)) (at start (drop_cloths_laid)) (at start (paint_purchased)) (at start (color_researched)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (furniture_moved)))
  )
  (:durative-action do_step5
    :parameters (?s - step)
    :duration (= ?duration 14400)
    :condition (and (at start (step_pending ?s)) (at start (paint_purchased)) (at start (color_researched)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (first_coat_done)))
  )
  (:durative-action do_step6
    :parameters (?s - step)
    :duration (= ?duration 259200)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (color_researched)))
  )
  (:durative-action do_step7
    :parameters (?s - step)
    :duration (= ?duration 10800)
    :condition (and (at start (step_pending ?s)) (at start (tape_applied)) (at start (furniture_moved)) (at start (walls_cleaned)) (at start (drop_cloths_laid)) (at start (paint_purchased)) (at start (color_researched)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (trim_painted)))
  )
  (:durative-action do_step8
    :parameters (?s - step)
    :duration (= ?duration 7200)
    :condition (and (at start (step_pending ?s)) (at start (drop_cloths_laid)) (at start (paint_purchased)) (at start (color_researched)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (walls_cleaned)))
  )
  (:durative-action do_step9
    :parameters (?s - step)
    :duration (= ?duration 1200)
    :condition (and (at start (step_pending ?s)) (at start (paint_purchased)) (at start (color_researched)))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (drop_cloths_laid)))
  )
  (:durative-action do_step10
    :parameters (?s - step)
    :duration (= ?duration 900)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s))) (at end (step_done ?s)) (at end (decor_unpacked)))
  )
)