(define (domain tea_domain)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (steeped_done)
    (composted_done)
    (researched_done)
    (ordered_kettle_done)
    (poured_done)
    (selected_mug_done)
    (visited_shop_done)
    (kettle_delivered_done)
    (water_boiled_done)
    (tea_sipped_done)
  )
  (:durative-action steep_tea
    :parameters (?s - step)
    :duration (= ?duration 300)
    :condition (at start (and (step_pending ?s) (water_boiled_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (steeped_done)))
  )
  (:durative-action compost_leaves
    :parameters (?s - step)
    :duration (= ?duration 120)
    :condition (at start (and (step_pending ?s) (kettle_delivered_done) (steeped_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (composted_done)))
  )
  (:durative-action research_tea
    :parameters (?s - step)
    :duration (= ?duration 1800)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (researched_done)))
  )
  (:durative-action order_kettle
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (ordered_kettle_done)))
  )
  (:durative-action pour_tea
    :parameters (?s - step)
    :duration (= ?duration 30)
    :condition (at start (and (step_pending ?s) (steeped_done) (researched_done) (selected_mug_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (poured_done)))
  )
  (:durative-action select_mug
    :parameters (?s - step)
    :duration (= ?duration 60)
    :condition (at start (step_pending ?s))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (selected_mug_done)))
  )
  (:durative-action visit_shop
    :parameters (?s - step)
    :duration (= ?duration 3600)
    :condition (at start (and (step_pending ?s) (researched_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (visited_shop_done)))
  )
  (:durative-action wait_delivery
    :parameters (?s - step)
    :duration (= ?duration 259200)
    :condition (at start (and (step_pending ?s) (ordered_kettle_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (kettle_delivered_done)))
  )
  (:durative-action boil_water
    :parameters (?s - step)
    :duration (= ?duration 240)
    :condition (at start (and (step_pending ?s) (researched_done) (visited_shop_done) (kettle_delivered_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (water_boiled_done)))
  )
  (:durative-action sip_tea
    :parameters (?s - step)
    :duration (= ?duration 600)
    :condition (at start (and (step_pending ?s) (researched_done) (selected_mug_done) (poured_done)))
    :effect (and (at start (not (step_pending ?s)))
                 (at end (step_done ?s))
                 (at end (tea_sipped_done)))
  )
)