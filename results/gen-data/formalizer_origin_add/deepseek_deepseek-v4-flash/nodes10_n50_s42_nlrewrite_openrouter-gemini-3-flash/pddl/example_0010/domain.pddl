(define (domain wimbledon)
  (:requirements :durative-actions :typing)
  (:types step)
  (:predicates
    (step_pending ?s - step)
    (step_done ?s - step)
    (hotel_booked)
    (app_downloaded)
    (account_created)
    (ballot_entered)
    (membership_joined)
    (tickets_printed)
    (ballot_results_waited)
    (payment_done)
    (identity_verified)
    (marketing_opted_in)
  )
  (:durative-action do_step1
    :parameters ()
    :duration (= ?duration 2700)
    :condition (at start (and (step_pending step1) (account_created) (ballot_entered) (ballot_results_waited) (payment_done) (identity_verified) (marketing_opted_in)))
    :effect (and (at start (not (step_pending step1))) (at end (step_done step1)) (at end (hotel_booked)))
  )
  (:durative-action do_step2
    :parameters ()
    :duration (= ?duration 300)
    :condition (at start (and (step_pending step2) (account_created) (marketing_opted_in)))
    :effect (and (at start (not (step_pending step2))) (at end (step_done step2)) (at end (app_downloaded)))
  )
  (:durative-action do_step3
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (step_pending step3))
    :effect (and (at start (not (step_pending step3))) (at end (step_done step3)) (at end (account_created)))
  )
  (:durative-action do_step4
    :parameters ()
    :duration (= ?duration 1200)
    :condition (at start (and (step_pending step4) (account_created) (ballot_results_waited) (identity_verified) (marketing_opted_in)))
    :effect (and (at start (not (step_pending step4))) (at end (step_done step4)) (at end (ballot_entered)))
  )
  (:durative-action do_step5
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (and (step_pending step5) (account_created) (ballot_results_waited) (identity_verified) (marketing_opted_in)))
    :effect (and (at start (not (step_pending step5))) (at end (step_done step5)) (at end (membership_joined)))
  )
  (:durative-action do_step6
    :parameters ()
    :duration (= ?duration 600)
    :condition (at start (and (step_pending step6) (account_created) (ballot_entered) (ballot_results_waited) (payment_done) (identity_verified) (marketing_opted_in)))
    :effect (and (at start (not (step_pending step6))) (at end (step_done step6)) (at end (tickets_printed)))
  )
  (:durative-action do_step7
    :parameters ()
    :duration (= ?duration 10368000)
    :condition (at start (and (step_pending step7) (account_created) (marketing_opted_in)))
    :effect (and (at start (not (step_pending step7))) (at end (step_done step7)) (at end (ballot_results_waited)))
  )
  (:durative-action do_step8
    :parameters ()
    :duration (= ?duration 900)
    :condition (at start (and (step_pending step8) (account_created) (ballot_entered) (ballot_results_waited) (identity_verified) (marketing_opted_in)))
    :effect (and (at start (not (step_pending step8))) (at end (step_done step8)) (at end (payment_done)))
  )
  (:durative-action do_step9
    :parameters ()
    :duration (= ?duration 172800)
    :condition (at start (and (step_pending step9) (account_created) (ballot_results_waited) (marketing_opted_in)))
    :effect (and (at start (not (step_pending step9))) (at end (step_done step9)) (at end (identity_verified)))
  )
  (:durative-action do_step10
    :parameters ()
    :duration (= ?duration 120)
    :condition (at start (and (step_pending step10) (account_created)))
    :effect (and (at start (not (step_pending step10))) (at end (step_done step10)) (at end (marketing_opted_in)))
  )
)